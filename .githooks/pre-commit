#!/bin/sh
# Pre-commit gate. "Committed" should mean "type-checked and unit-tested".
#
# Deliberately NOT the full PR suite: no build, no ISR assertion, no Playwright.
# Those need a build or a browser and belong in CI (.github/workflows/pr-tests.yml).
# A gate slow enough to be bypassed is not a gate.
#
# Install: npm install (the `prepare` script points core.hooksPath here), or by hand:
#   git config core.hooksPath .githooks
# Bypass for a genuine emergency: git commit --no-verify

set -e

# Nothing staged (e.g. `git commit --amend --only` on a message): nothing to check.
if git diff --cached --quiet; then
  exit 0
fi

# Only source changes can break these. A docs- or workflow-only commit skips the gate.
if ! git diff --cached --name-only --diff-filter=ACMR \
  | grep -qE '\.(ts|tsx|js|mjs|cjs|astro|json)$'; then
  exit 0
fi

if [ ! -d node_modules ]; then
  echo "pre-commit: node_modules missing — run 'npm ci' first, or commit with --no-verify." >&2
  exit 1
fi

echo "pre-commit: types"
npm run --silent check

echo "pre-commit: unit tests"
npm test --silent
