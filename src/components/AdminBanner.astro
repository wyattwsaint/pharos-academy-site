---
import AdminButton from './AdminButton.astro';

/**
 * What an admin screen says out loud after an action.
 *
 * One component because there is one voice: `role="status"` so a screen reader
 * hears the outcome without moving focus, `data-ok` so the browser suite can
 * assert the outcome rather than the wording, and the same parchment block with
 * a deep-blue or gold edge either way. A failure is not styled as an alarm —
 * "saved, but the live site hasn't updated yet" is a thing to retry, not a
 * thing to panic about.
 *
 * Retry is a prop rather than something each screen hangs in the slot (#193).
 * Seven screens had hand-copied that little form, and a Retry that is spelled
 * out seven times is a Retry that can be spelled seven ways. The slot stays for
 * whatever else a particular failure offers next; nothing is rendered around it
 * when it is empty.
 *
 * Retry carries the screen it was pressed on, so the second answer arrives
 * where the first one did (#198).
 */
interface Props {
  ok: boolean;
  message: string;
  /** What the browser suite finds this banner by. */
  testId: string;
  /**
   * Offer a Retry that republishes. Only meaningful on a failure, so it is
   * ignored on a banner that reports success.
   */
  retry?: boolean;
  /**
   * `alert` for a banner that answers the submission the reader just made and
   * has to interrupt them — the sign-in refusal. Everything else is `status`:
   * an outcome to be heard in turn, without stealing the reading position.
   */
  role?: 'status' | 'alert';
}

const { ok, message, testId, retry = false, role = 'status' } = Astro.props;
const offerRetry = retry && !ok;
---

<div
  role={role}
  data-testid={testId}
  data-ok={String(ok)}
  class:list={['mt-6 border-l-4 bg-parchment px-4 py-3', ok ? 'border-deep-blue' : 'border-gold']}
>
  <p>{message}</p>
  {
    offerRetry && (
      <form method="post" action="/admin/republish" class="mt-3">
        <input type="hidden" name="next" value={`${Astro.url.pathname}${Astro.url.search}`} />
        <AdminButton small testId={`${testId}-retry`}>
          Retry
        </AdminButton>
      </form>
    )
  }
  <slot />
</div>
