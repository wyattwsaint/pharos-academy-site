---
/**
 * One labelled control on an admin form, with its hint and its complaint.
 *
 * Extracted from the school-details form when the announcement banner gave it
 * a second group of fields (#15): the wiring between a label, its hint, its
 * error and the `aria-describedby` that ties them together is the part that
 * silently rots when it is copied, and a screen reader is the only thing that
 * notices. The 2026-08 audit found exactly that rot on most of the screens that
 * hand-copied a control instead of using this (#190), so #193 grows it to cover
 * every variant those copies invented rather than leaving them a reason to.
 *
 * Every kind of control the admin has is here, and the wiring is written once
 * for all of them:
 *
 *   text, tel, email, date, url, number, time   an `<input type>`
 *   multiline                                   a textarea
 *   select                                      a `<select>` over `options`
 *   file                                        an upload
 *   checkbox                                    one box, its label beside it
 *   checkboxes, radios                          a group, in its own fieldset
 *   group                                       a fieldset over whatever is
 *                                               put in its slot
 *
 * The last three are the grouped variant. Their error belongs to the group
 * rather than to any one box — "pick at least one day" is not a complaint about
 * Tuesday, and "the four dates must be in order" is not a complaint about the
 * third one — so the fieldset carries the `aria-describedby`, which is what
 * makes a screen reader announce it on entering the group.
 *
 * `group` is the same fieldset with its contents left to the caller, for the
 * groups whose members are neither checkboxes nor radios: Money's four
 * instalment dates are one complaint over four `date` fields (#196). What it
 * holds is still AdminFields — the slot is where they go, not a licence to
 * spell a control out by hand.
 *
 * The fieldset carries `aria-describedby` and nothing else. `aria-invalid` is
 * not global in ARIA 1.2 and `group` is not one of the roles that takes it, so
 * putting it there would be an `aria-allowed-attr` failure — a real one, found
 * by the suite this ticket exists to stop failing.
 */
export type AdminFieldOption = {
  value: string;
  label: string;
};

interface Props {
  /** The form field name, and by default the id the label points at. */
  name: string;
  /**
   * The id, where it cannot be the name: a repeating row posts every one of its
   * rows under the same name, and duplicate ids would leave each label pointing
   * at the first row's control. The hint and the error are numbered with it.
   */
  id?: string;
  type:
    | 'text'
    | 'tel'
    | 'email'
    | 'date'
    | 'url'
    | 'number'
    | 'time'
    | 'multiline'
    | 'select'
    | 'file'
    | 'checkbox'
    | 'checkboxes'
    | 'radios'
    | 'group';
  label: string;
  /** The single-control value. Ignored by every grouped type, and `checkbox`. */
  value?: string;
  /** Ticked, for `checkbox`. */
  checked?: boolean;
  /** The choices, for `select`, `checkboxes` and `radios`. */
  options?: AdminFieldOption[];
  /** Which of `options` are chosen, for `checkboxes` and `radios`. */
  selected?: string[];
  /**
   * The line under the label. A `hint` slot says the same thing when the hint
   * has to carry a link — the wiring is identical either way, because what
   * `aria-describedby` points at is the paragraph, not the string.
   */
  hint?: string;
  /** The server's complaint about this field, if it made one. */
  error?: string;
  /**
   * Refused, with the complaint said elsewhere: a member of a group whose
   * error belongs to the group. The box is marked the way every other refused
   * box is — the gold border is how a sighted reader finds what to fix, and it
   * would be lost on exactly the fields whose complaint is not their own.
   */
  invalid?: boolean;
  /** True for a field that may be left blank. Most may not. */
  optional?: boolean;
  rows?: number;
  /** `number` only. */
  min?: number | string;
  max?: number | string;
  step?: number | string;
  /** `file` only — what the picker offers, e.g. `application/pdf`. */
  accept?: string;
  /** `select` only: the empty first entry, for "none chosen yet". */
  placeholder?: string;
  /** The keypad a phone offers — for a `text` field that holds a number. */
  inputmode?: 'numeric' | 'decimal' | 'tel';
  /**
   * Where this field sits when its row holds more than one — `flex-1`,
   * `min-w-56`. Layout only, never colour or border, exactly as `AdminButton`
   * takes it: the alternative is a wrapping `<div>` per field, which is the
   * hand-copied class string the shared components exist to end (#188). It
   * sizes the whole field, so a complaint has the same room its control does.
   */
  class?: string;
}

const {
  name,
  id,
  type,
  label,
  value = '',
  checked = false,
  options = [],
  selected = [],
  hint,
  error,
  invalid: refused = false,
  optional = false,
  rows = 5,
  min,
  max,
  step,
  accept,
  placeholder,
  inputmode,
  class: extra,
} = Astro.props;

/** The name, unless the caller had to say otherwise — a repeating row. */
const fieldId = id ?? name;
const complaint = Boolean(error);
const invalid = complaint || refused;
const described = hint !== undefined || Astro.slots.has('hint');
const describedBy =
  [described ? `${fieldId}-hint` : null, complaint ? `${fieldId}-error` : null]
    .filter(Boolean)
    .join(' ') || undefined;
const control = 'w-full rounded border border-navy/40 bg-white px-3 py-2 aria-[invalid=true]:border-gold';

/** The grouped variant: several controls under one label, in a fieldset. */
const grouped = type === 'checkboxes' || type === 'radios' || type === 'group';
/**
 * A checkbox is required only in the sense of "must be ticked", which is not
 * what any box on this admin means, so `required` is never put on one. The
 * grouped variant says the same thing at group level through its own error.
 */
const requiredControl = !optional && type !== 'checkbox' && !grouped;
const chosen = new Set(selected);
---

{
  grouped ? (
    <fieldset aria-describedby={describedBy} class:list={['flex flex-col gap-2', extra]}>
      <legend class="font-semibold">{label}</legend>
      {described && (
        <p id={`${fieldId}-hint`} class="text-sm">
          {hint}
          <slot name="hint" />
        </p>
      )}
      {type === 'group' ? (
        <slot />
      ) : (
        <div class="flex flex-col gap-2">
          {options.map((option) => (
            <div class="flex items-start gap-3">
              <input
                id={`${fieldId}-${option.value}`}
                name={name}
                type={type === 'radios' ? 'radio' : 'checkbox'}
                value={option.value}
                checked={chosen.has(option.value)}
                class="mt-1 size-5"
              />
              <label for={`${fieldId}-${option.value}`}>{option.label}</label>
            </div>
          ))}
        </div>
      )}
      {complaint && (
        <p id={`${fieldId}-error`} class="font-semibold">
          {error}
        </p>
      )}
    </fieldset>
  ) : type === 'checkbox' ? (
    <div class:list={['flex flex-col gap-2', extra]}>
      <div class="flex items-start gap-3">
        <input
          id={fieldId}
          name={name}
          type="checkbox"
          checked={checked}
          aria-invalid={invalid ? 'true' : undefined}
          aria-describedby={describedBy}
          class="mt-1 size-5"
        />
        <label for={fieldId} class="font-semibold">
          {label}
        </label>
      </div>
      {described && (
        <p id={`${fieldId}-hint`} class="text-sm">
          {hint}
          <slot name="hint" />
        </p>
      )}
      {complaint && (
        <p id={`${fieldId}-error`} class="font-semibold">
          {error}
        </p>
      )}
    </div>
  ) : (
    <div class:list={['flex flex-col gap-2', extra]}>
      <label for={fieldId} class="font-semibold">
        {label}
      </label>
      {described && (
        <p id={`${fieldId}-hint`} class="text-sm">
          {hint}
          <slot name="hint" />
        </p>
      )}
      {type === 'multiline' ? (
        /*
          The value sits hard against the tags. A textarea's content is its
          value, whitespace and all, so a newline and an indent here are ten
          spaces the school never typed — which is what saving one back does to
          the next save (#196).
        */
        <textarea
          id={fieldId}
          name={name}
          rows={rows}
          required={requiredControl}
          aria-invalid={invalid ? 'true' : undefined}
          aria-describedby={describedBy}
          class={control}
        >{value}</textarea>
      ) : type === 'select' ? (
        <select
          id={fieldId}
          name={name}
          required={requiredControl}
          aria-invalid={invalid ? 'true' : undefined}
          aria-describedby={describedBy}
          class={control}
        >
          {placeholder !== undefined && (
            <option value="" selected={value === ''}>
              {placeholder}
            </option>
          )}
          {options.map((option) => (
            <option value={option.value} selected={option.value === value}>
              {option.label}
            </option>
          ))}
        </select>
      ) : type === 'file' ? (
        <input
          id={fieldId}
          name={name}
          type="file"
          accept={accept}
          required={requiredControl}
          aria-invalid={invalid ? 'true' : undefined}
          aria-describedby={describedBy}
          class={control}
        />
      ) : (
        <input
          id={fieldId}
          name={name}
          type={type}
          value={value}
          required={requiredControl}
          inputmode={inputmode}
          min={min}
          max={max}
          step={step}
          aria-invalid={invalid ? 'true' : undefined}
          aria-describedby={describedBy}
          class={control}
        />
      )}
      {complaint && (
        <p id={`${fieldId}-error`} class="font-semibold">
          {error}
        </p>
      )}
    </div>
  )
}
