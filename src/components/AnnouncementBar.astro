---
import type { AnnouncementBanner } from '../lib/home/announcement-banner.js';

/**
 * The home page's announcement bar (#15).
 *
 * Rendered **inside** `SiteHeader`, above its row, which is what makes one of
 * the ticket's criteria free rather than fought for. The header is
 * `position: fixed`, so the bar is out of the document flow: switching it off
 * leaves no empty space where it was. A bar in the flow would have had to
 * fight the fixed header's overlap on one side and `pt-24` on the other.
 *
 * There is no dismiss control, and nothing is remembered about the bar between
 * page views. The ticket's original design let a visitor close it for good, and
 * the office found the result was a message it could not tell had been read or
 * hidden. The bar is now the office's line, on screen until the office takes it
 * down in the admin — the one lever, in one place.
 *
 * The date is rendered after the message rather than woven into it: the office
 * types "Register now! Classes begin" and the bar says "Register now! Classes
 * begin August 31". That is what keeps the date a real date — a free-text
 * message with the day typed inside it is a date nothing can validate, and
 * "Augsut 31" ships.
 */
interface Props {
  banner: AnnouncementBanner;
}

const { banner } = Astro.props;
---

<aside class="site-banner" aria-label="Announcement" data-announcement-bar>
  <div class="wide">
    {
      banner.href ? (
        <a class="site-banner-message" href={banner.href}>
          {banner.message} <b>{banner.date}</b>
        </a>
      ) : (
        <p class="site-banner-message">
          {banner.message} <b>{banner.date}</b>
        </p>
      )
    }
  </div>
</aside>
