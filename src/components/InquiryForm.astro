---
import { INQUIRY_PATH, type InquiryErrors, type InquiryFields } from '../lib/inquiry/inquiry.js';

/**
 * The inquiry form itself — one component, rendered on the homepage and again
 * on `/inquire` (#25).
 *
 * One component because there is one form. Two copies of these controls would
 * be two sets of labels, two `aria-describedby` wirings and two chances for one
 * of them to drift from the other.
 *
 * **It always posts to `/inquire`, never to the page it is on.** The public site
 * is ISR (#18 §1) and a cached page cannot take a POST, so the homepage's copy
 * submits across to the one page that renders on request — which is also where
 * the answer belongs, since that answer is specific to one submission.
 *
 * `idPrefix` exists because two copies of a form on one document would be two
 * elements sharing an `id`, which is both an axe violation and a label that
 * points at the wrong input.
 */
interface Props {
  /** Namespaces every `id` on the form. Unique per instance on a page. */
  idPrefix: string;
  /** What was typed, when a rejected submission is being redisplayed. */
  values?: InquiryFields | null;
  errors?: InquiryErrors;
  /** The submit button's words. */
  submitLabel?: string;
}

const { idPrefix, values = null, errors = {}, submitLabel = 'Send my question' } = Astro.props;

const id = (field: string) => `${idPrefix}-${field}`;
const errorId = (field: string) => `${idPrefix}-${field}-error`;
const typed = (field: keyof InquiryFields): string => values?.[field] ?? '';
---

<form class="inquiry-form" method="post" action={INQUIRY_PATH} novalidate data-inquiry-form>
  <div>
    <label for={id('name')}>Your name</label>
    <input
      id={id('name')}
      name="name"
      autocomplete="name"
      value={typed('name')}
      aria-describedby={errors.name ? errorId('name') : undefined}
      aria-invalid={errors.name ? 'true' : undefined}
    />
    {errors.name && <p class="error" id={errorId('name')}>{errors.name}</p>}
  </div>

  <div>
    <label for={id('email')}>Email</label>
    <input
      id={id('email')}
      name="email"
      type="email"
      autocomplete="email"
      value={typed('email')}
      aria-describedby={errors.email ? errorId('email') : undefined}
      aria-invalid={errors.email ? 'true' : undefined}
    />
    {errors.email && <p class="error" id={errorId('email')}>{errors.email}</p>}
  </div>

  {
    /*
     * The phone number — mandatory, and a reversal of #25 (#311, ADR-0024).
     *
     * `inputmode="numeric"` rather than `type="tel"` alone would lose the
     * dialling keypad on iOS; `type="tel"` keeps it and `novalidate` on the
     * form means the browser's own bubble never competes with the inline error
     * below. `data-phone` is what the script at the foot of this file binds
     * the auto-dash to, and it is an attribute rather than an id because the
     * form renders twice on the home page.
     */
  }
  <div>
    <label for={id('phone')}>Phone</label>
    <input
      id={id('phone')}
      name="phone"
      type="tel"
      inputmode="tel"
      autocomplete="tel"
      placeholder="717-555-0142"
      value={typed('phone')}
      data-phone
      aria-describedby={errors.phone ? errorId('phone') : undefined}
      aria-invalid={errors.phone ? 'true' : undefined}
    />
    {errors.phone && <p class="error" id={errorId('phone')}>{errors.phone}</p>}
  </div>

  {
    /*
     * Free text and required — the field that earns its friction. A dropdown
     * cannot hold "6, 9 and 13", and Pharos serves a fourteen-year span, so
     * without this every first reply from Jill is a question.
     */
  }
  <div class="full">
    <label for={id('ages')}>Children’s ages</label>
    <input
      id={id('ages')}
      name="ages"
      placeholder="e.g. 6, 9 and 13"
      value={typed('ages')}
      aria-describedby={errors.ages ? errorId('ages') : undefined}
      aria-invalid={errors.ages ? 'true' : undefined}
    />
    {errors.ages && <p class="error" id={errorId('ages')}>{errors.ages}</p>}
  </div>

  <div class="full">
    <label for={id('message')}>Anything you’d like to ask (optional)</label>
    <textarea id={id('message')} name="message">{typed('message')}</textarea>
  </div>

  {
    /*
     * The submit button, and whatever else the page wants standing beside it.
     *
     * The `alongside` slot is how the home page puts its gold "Register now!"
     * button next to "Send my question" (#141) without that button following
     * the form onto `/inquire`, where the visitor has already made the choice
     * this row is asking them to make. A page that passes nothing gets the row
     * it always had.
     *
     * The row does not wrap: #141 AC 7 is that both calls to action stay side
     * by side on a phone, so the buttons narrow and their words wrap instead.
     */
  }
  <div class="full actions">
    <button class="btn solid" type="submit">{submitLabel}</button>
    <slot name="alongside" />
  </div>
</form>

<script>
  /*
    The dashes, as the parent types (#311 AC 2).

    An enhancement and not a dependency: with scripting off a family types the
    dashes themselves, `parseInquiry` applies the identical rule on POST, and
    the inline error says what shape is wanted. What this buys is *not having
    to guess the format*, which is the whole reason the field auto-formats.

    The rule is imported rather than restated, for the reason `apply.astro`
    imports its validation: `forms.ts` is a leaf that imports nothing, so what
    crosses the wire is one regular expression and one string function.

    The caret is remapped by counting digits rather than characters. Editing in
    the middle of a number is the case a naive "put the caret at the end" gets
    wrong, and a caret that jumps is worse than no auto-format at all.
  */
  import { formatPhoneAsTyped } from '../lib/forms.js';

  for (const field of document.querySelectorAll<HTMLInputElement>('input[data-phone]')) {
    field.addEventListener('input', () => {
      const before = field.value;
      const caret = field.selectionStart ?? before.length;
      const digitsBefore = before.slice(0, caret).replace(/\D/g, '').length;

      const formatted = formatPhoneAsTyped(before);
      if (formatted === before) return;
      field.value = formatted;

      let seen = 0;
      let position = formatted.length;
      for (let index = 0; index < formatted.length; index += 1) {
        if (/\d/.test(formatted[index]!)) seen += 1;
        if (seen === digitsBefore) {
          position = index + 1;
          break;
        }
      }
      if (digitsBefore === 0) position = 0;
      field.setSelectionRange(position, position);
    });
  }
</script>

<style>
  .inquiry-form {
    display: grid;
    gap: 1.5rem;
    max-width: 46rem;
  }

  @media (min-width: 44rem) {
    .inquiry-form {
      grid-template-columns: 1fr 1fr;
    }
  }

  .full {
    grid-column: 1 / -1;
  }

  .actions {
    display: flex;
    align-items: stretch;
    gap: 0.9rem;
  }

  /* Both buttons are free to narrow below their content, which is what keeps
     the pair on one line at 320px rather than pushing the page sideways. */
  .actions > :global(*) {
    min-width: 0;
  }

  /* `.btn` sets `font: 600 13.5px/1`, which is right for the single line it was
     drawn for and wrong the moment a label wraps — at 320px "Send my question"
     becomes two lines whose ascenders and descenders touch. Only in this row,
     because this row is the only place on the site where a button is
     deliberately narrowed past its words. */
  .actions > :global(.btn) {
    line-height: 1.25;
  }

  label {
    display: block;
    font-family: var(--font-sans);
    font-weight: 600;
    margin-bottom: 0.4rem;
  }

  input,
  textarea {
    width: 100%;
    padding: 0.6rem 0.7rem;
    border: 1px solid var(--color-gold-orn);
    background: white;
    font: inherit;
    color: var(--color-ink);
  }

  textarea {
    min-height: 7rem;
  }

  .error {
    margin-top: 0.35rem;
    color: var(--color-error);
    font-weight: 500;
  }
</style>
