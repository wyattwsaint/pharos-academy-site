---
import { BELIEFS_PATH } from '../lib/about/beliefs.js';
import { copyrightYear, getSchoolDetails, telHref } from '../lib/admin/school-details.js';
import { getDb } from '../lib/db/client.js';
import { INQUIRY_HREF } from '../lib/home/sections.js';
import { SCHOOL_NAME } from '../lib/site.js';

/**
 * The public footer: the school's own details, straight out of the one row
 * Jill edits (#18 §10), now set on the ceremonial navy band.
 *
 * Every value here is read, never typed. On the live Wix site the address and
 * phone are hand-entered in 22 places and have already drifted apart; proving
 * the admin actually reaches the public page was the footer's whole job in the
 * delivery slice, and the surface work does not change it.
 *
 * The Give link is the same value the admin holds, rendered — not pasted a
 * second time (#18 §12). Anywhere else giving is linked reads `giveUrl` too.
 *
 * The inquiry CTA appears here as well as in the fixed header. #9 item 1 asks
 * for the form to be present immediately; the hero lockup signed off on #13 has
 * no button in it at all, so what is honoured is #9's IA-level wording — a
 * persistent CTA in the header and the footer — at both ends of the page.
 */
const details = await getSchoolDetails(await getDb());

// Computed at render, never stored (#18 §10) — a stored year is the only way a
// site ends up reading "© 2025" in August 2026, which this one does today.
const year = copyrightYear();

const addressLines = details.address.split('\n').filter(Boolean);
---

<footer class="site-footer">
  <div class="wide">
    <div class="site-footer-mark">
      <img src="/mark.svg" alt="" width="40" height="45" />
      <b>{SCHOOL_NAME}</b>
      <em class="tagline">Helping Our Parents Educate</em>
    </div>

    <div class="site-footer-cols">
      <div>
        <b>{SCHOOL_NAME}</b>
        <address>
          {addressLines.map((line) => <span class="block">{line}</span>)}
        </address>
      </div>

      <div>
        <b>Get in touch</b>
        <a href={telHref(details.phone)}>{details.phone}</a><br />
        <a href={`mailto:${details.email}`}>{details.email}</a>
      </div>

      <div>
        <b>More</b>
        <a href={INQUIRY_HREF}>Ask us about Pharos</a><br />
        <a href={BELIEFS_PATH}>Statement of Faith</a><br />
        <a href="/policies">Policies</a><br />
        <a href={details.giveUrl}>Give</a>
      </div>
    </div>

    <p class="mt-9 text-sm">© {year} {SCHOOL_NAME}</p>
  </div>
</footer>
