---
import AnnouncementBar from './AnnouncementBar.astro';
import type { AnnouncementBanner } from '../lib/home/announcement-banner.js';
import { INQUIRY_HREF, NAV_ITEMS } from '../lib/home/sections.js';
import { SCHOOL_NAME } from '../lib/site.js';

interface Props {
  /**
   * Whether this page opens on the full-bleed video hero.
   *
   * On the homepage the header starts chrome-less and takes its navy band only
   * once the hero is past — `hero-fx.ts` toggles `.stuck` on scroll. Every
   * other page has no hero for it to float over, so it ships stuck and the
   * script leaves it alone.
   */
  overHero?: boolean;
  /**
   * The announcement bar to cap the header above its row, or null for none.
   *
   * Only the home page passes one (#15). It is a prop rather than a read of the
   * school details row here for the same reason `BaseLayout` takes `details` as
   * one: this component renders mid-stream, after the 200 has gone, so a
   * database read in here can only truncate a page that has already claimed to
   * have succeeded.
   */
  banner?: AnnouncementBanner | null;
}

const { overHero = false, banner = null } = Astro.props;
---

<header class:list={['site-header', { stuck: !overHero }]} data-site-header>
  {banner && <AnnouncementBar banner={banner} />}
  <div class="wide">
    <a class="site-brand" href="/" data-header-brand>
      <img src="/mark.svg" alt="" width="25" height="28" />
      <b>{SCHOOL_NAME}</b>
    </a>
    <nav class="site-nav" aria-label="Main">
      {NAV_ITEMS.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="btn on-dark" href={INQUIRY_HREF}>Ask us about Pharos</a>
    {
      /*
        The same destinations again, for the phone (#139).

        Rendered rather than cloned from `.site-nav` by script: a menu built at
        runtime is a menu a visitor with no JavaScript does not have, and this
        one is the only navigation most of the site's visitors are offered. The
        panel ships with `hidden` on it, so until the element upgrades it is
        inert rather than a second nav stacked under the first.

        The application call to action is deliberately not in here. It belongs
        to Admissions, one tap further in, and a menu that asks a parent to
        apply before they have read anything is the wrong first question.
      */
    }
    <nav-menu class="site-menu">
      <button
        type="button"
        class="site-menu-toggle"
        aria-expanded="false"
        aria-controls="site-menu-panel"
        data-nav-menu-toggle
      >
        <span class="site-menu-bars" aria-hidden="true"></span>
        Menu
      </button>
      <div class="site-menu-panel" id="site-menu-panel" hidden data-nav-menu-panel>
        <nav class="site-menu-nav" aria-label="Site">
          {NAV_ITEMS.map((item) => <a href={item.href}>{item.label}</a>)}
          <a class="site-menu-cta" href={INQUIRY_HREF}>Ask us about Pharos</a>
        </nav>
      </div>
    </nav-menu>
  </div>
</header>

<script>
  // Bundled and deferred, unlike the announcement bar's inline script: the menu
  // ships closed and stays closed until it is tapped, so running after first
  // paint costs a visitor nothing.
  import './nav-menu.js';
</script>
