---
import { currentAnnouncements, type Announcement } from '../../lib/announcements/announcement.js';
import { attachmentPath, newsPath } from '../../lib/announcements/views.js';

/**
 * Announcements, directly under the hero.
 *
 * #9 does not place this section; it is here because an announcement that has
 * to be seen — a closing, a registration deadline — six sections down is not an
 * announcement, and the auto-hide only earns its keep if the slot it vacates is
 * a prominent one.
 *
 * **The disappearing act is one rule, not two** (#27). "Show what is current"
 * and "hide once the newest is stale" are the same sentence: when the newest
 * announcement passes six weeks the current list is empty, and an empty list is
 * what hides the section. A separate "is the newest stale" test would be a
 * second place the six weeks were written down, and the two would disagree the
 * first time either was tuned.
 *
 * The section stays in the document when empty and is hidden with `hidden`
 * rather than being dropped: the page's section order is asserted as a sequence
 * (#9), and a section that vanishes from the DOM makes that assertion depend on
 * whether Jill happens to have posted anything this month.
 *
 * **The list arrives as a prop.** Reading it here would put a store read inside
 * the streamed body, where a failure can no longer change the status code — see
 * the note in `src/pages/index.astro` (#34). The six-week rule stays here,
 * because that is this section's own rule and nothing else applies it.
 */
type Props = { announcements: Announcement[] };

const { announcements } = Astro.props;
const showing = currentAnnouncements(announcements, new Date());
---

<section
  class="band band-quiet"
  id="announcements"
  data-section="announcements"
  hidden={showing.length === 0}
>
  <div class="wide">
    <p class="label">Announcements</p>
    {
      /*
        A scoped class rather than Tailwind's `grid`, which this page already
        owns: `beacon.css` defines `.grid` as the timetable's four fixed
        columns, and a band that borrowed the name inherited them — 660px of
        list inside a 390px phone. The section was empty until now, so nothing
        had ever rendered to show it.
      */
    }
    <ul class="announcement-list">
      {
        showing.map((announcement) => (
          <li>
            <h2 class="text-2xl">
              <a class="no-underline hover:underline" href={newsPath(announcement.slug)}>
                {announcement.headline}
              </a>
            </h2>
            <p class="announcement-body mt-2">{announcement.body}</p>
            {announcement.linkUrl && announcement.linkLabel && (
              <p class="mt-3">
                <a class="text-gold-ink underline underline-offset-4" href={announcement.linkUrl}>
                  {announcement.linkLabel} →
                </a>
              </p>
            )}
            {announcement.attachmentFilename && (
              <p class="mt-3">
                <a
                  class="text-gold-ink underline underline-offset-4"
                  href={attachmentPath(announcement.slug)}
                >
                  {announcement.attachmentFilename} (PDF)
                </a>
              </p>
            )}
          </li>
        ))
      }
    </ul>
    <p class="mt-8">
      <a class="text-gold-ink underline underline-offset-4" href="/news">All news →</a>
    </p>
  </div>
</section>

<style>
  .announcement-list {
    margin-top: 1.5rem;
    display: grid;
    gap: 1.5rem;
  }

  .announcement-list > li {
    border-left: 2px solid var(--color-gold-orn);
    padding-left: 1.25rem;
  }

  /* A blank line typed in the admin's textarea is a paragraph break, not a
     space — the same rule the news page renders the body under. */
  .announcement-body {
    white-space: pre-line;
  }

  /* Two abreast once there is room for two columns of readable measure. */
  @media (min-width: 768px) {
    .announcement-list {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
