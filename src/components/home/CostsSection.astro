---
import type { Course } from '../../lib/courses/course.js';
import { costFigures } from '../../lib/home/content.js';
import type { MoneySettings } from '../../lib/money/settings.js';

interface Props {
  /** The catalogue, for the range a year of classes falls in. */
  courses: readonly Course[];
  /** The school's money settings. Every figure below comes from these. */
  settings: MoneySettings;
}

const { courses, settings } = Astro.props;
const figures = costFigures(courses, settings);

/**
 * What it costs, in full, before anyone asks.
 *
 * Not one of these three numbers is written here. They are computed from the
 * money settings and the catalogue (#29 AC 1), because a fee raised in the
 * admin and still quoted at the old figure on the homepage is the exact failure
 * this section is supposed to prevent.
 *
 * The three gold marks are decorative and carry no information the numerals do
 * not — hence `aria-hidden`. The numerals themselves are sans and tabular:
 * these are the working parts of the page, not the ceremonial ones.
 */
const MARKS = [
  'M12 2 L22 12 L12 22 L2 12 Z M12 8.6 A3.4 3.4 0 1 0 12 15.4 A3.4 3.4 0 1 0 12 8.6',
  'M12 2.5 A9.5 9.5 0 1 0 12 21.5 A9.5 9.5 0 1 0 12 2.5 M12 5.5 L14 12 L12 18.5 L10 12 Z',
  'M2.5 5.5 H21.5 V18.5 H2.5 Z M2.5 5.5 L12 13 L21.5 5.5',
];
---

<section class="band" id="costs" data-section="costs">
  <div class="wide">
    <p class="label">What it costs</p>
    <h2 class="mt-4">Pricing for Partner Families</h2>
    <div class="figures">
      {
        figures.map((figure, index) => (
          <div class="figure">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
              <path d={MARKS[index]} />
            </svg>
            <b>{figure.amount}</b>
            <span>{figure.note}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
