---
import InquiryForm from '../InquiryForm.astro';
import { getSchoolDetails, telHref } from '../../lib/admin/school-details.js';
import { getDb } from '../../lib/db/client.js';

/**
 * The inquiry, at the foot of the home page (#9 item 7, wired by #25).
 *
 * The form has no `action` of its own — `InquiryForm` posts to `/inquire`,
 * which is the only page on the public site that renders on request. This page
 * is ISR and cannot take a POST; the earlier pass here had no action at all,
 * and the pass before *that* posted to `mailto:` with `enctype="text/plain"`,
 * which persisted nothing and silently did nothing on most phones.
 *
 * The school's real email and phone stay directly under it, read from the one
 * row Jill edits. They are not a fallback for a broken form — a parent who
 * would rather write than fill anything in is an ordinary parent.
 */
const details = await getSchoolDetails(await getDb());
---

<section class="band" id="inquiry" data-section="inquiry">
  <div class="wrap">
    <p class="label">Ask us about Pharos</p>
    <h2 class="mt-4">Tell us your children's ages.</h2>
    <p class="sub mt-3">
      We'll tell you honestly whether Pharos fits. No commitment, and no application yet.
    </p>

    <div class="mt-7">
      <InquiryForm idPrefix="inquiry" />
    </div>

    <p class="sub mt-6 text-sm">
      Or reach us directly:
      <a class="text-gold-ink underline underline-offset-4" href={`mailto:${details.email}`}>
        {details.email}
      </a>
      {' · '}
      <a class="text-gold-ink underline underline-offset-4" href={telHref(details.phone)}>
        {details.phone}
      </a>
    </p>
  </div>
</section>
