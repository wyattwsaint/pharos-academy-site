---
import { STAFF_PATH } from '../../lib/people/views.js';

/**
 * An invitation, not a roster (#142).
 *
 * This band used to print three portraits with names and credentials under a
 * "Nine instructors." heading — a second, smaller staff page, with a count that
 * had stopped matching the people list. The people are the staff page's job;
 * what belongs on the front page is the school's posture toward the families
 * reading it, and one link to go and meet them.
 *
 * Nothing here reads the store any more, so the section takes no props. The
 * count is gone rather than derived: a number on the front page is one more
 * thing to keep true, and the staff page already answers "how many" by showing
 * them.
 */
---

<section class="band band-quiet" id="teachers" data-section="teachers">
  <div class="wide">
    <div class="accent accent-wide">
      <div>
        <h2>We walk alongside to support and encourage homeschool families</h2>
        <p class="mt-5">
          <a href={STAFF_PATH}>Meet the people who teach here →</a>
        </p>
      </div>
      <figure class="plate">
        <img src="/imagery/vista-path.webp" alt="" width="1400" height="933" loading="lazy" />
      </figure>
    </div>
  </div>
</section>
