---
import type { Course } from '../../lib/courses/course.js';
import { cellMeta } from '../../lib/home/cell-meta.js';
import {
  activeDayTracks,
  classCountOnTrack,
  TIMETABLE,
  type ClassEntry,
} from '../../lib/home/timetable.js';
import type { RateCard } from '../../lib/money/settings.js';

/**
 * What a week looks like — #9's items 2 and 3 as one section.
 *
 * The merge is variant E's and is what was signed off on #13: a timetable of
 * real classes with real ages and prices *is* what a week looks like, and
 * splitting the two puts the same information on the page twice.
 *
 * Each class is a `<disclosure-group>` cell — the same interaction
 * implementation as the H.O.P.E. row, which is #21 AC 6. The trigger is a real
 * `<button>` rather than a link with a placeholder `href`: there is no class
 * page to navigate to yet, and the panel is what the interaction is for.
 *
 * The columns are the day tracks that actually run, derived rather than listed.
 * The school has four tracks and the Tuesday one is routinely empty
 * (CONTEXT.md, "day track"); an empty track is complete, not incomplete, so it
 * is not drawn as a permanently blank column.
 *
 * The price on each cell is looked up rather than typed (#29 AC 1), and so is
 * the semester of a class that runs only one (#183) — a parent phoned the Head
 * of School having read this grid rather than the course description. The cell
 * carries a catalogue slug and `cellMeta` composes the line from the course it
 * finds; two cells the school quotes by length rather than by price ("12
 * weeks", "rotating") carry no slug and get neither fact, which is complete
 * rather than missing.
 *
 * The closing line names no total (#138). The column headings count what the
 * grid holds, but the grid is `TIMETABLE` — the hand-kept mirror, not the
 * catalogue — so a total here would either be typed or would count a list the
 * catalogue can move away from. "Our classes" stays true either way, and the
 * link goes to the page that reads the catalogue and does state the number.
 */
interface Props {
  /** The catalogue, for the price on each cell. */
  courses: readonly Course[];
  /** The school's two hourly rates, from the money settings. */
  rates: RateCard;
}

const { courses, rates } = Astro.props;
const bySlug = new Map(courses.map((course) => [course.slug, course]));
const tracks = activeDayTracks();

/** The meta line for a cell, with whatever its course adds to what is typed. */
function metaFor(entry: ClassEntry): string {
  return cellMeta(entry, entry.slug ? bySlug.get(entry.slug) : undefined, rates);
}
---

<section class="band" id="week" data-section="week">
  <div class="wide">
    <div class="accent">
      <div>
        <p class="label">What a week looks like</p>
        <h2 class="mt-4">Mornings here. Afternoons yours.</h2>
      </div>
      <figure class="plate">
        <img src="/imagery/still-desk.webp" alt="" width="1400" height="933" loading="lazy" />
      </figure>
    </div>

    <disclosure-group data-disclosure-group="classes">
      <div class="gridscroll">
        <div class="grid">
          <div class="hour"><span class="sr-only">Time</span></div>
          {
            tracks.map((track) => (
              <div class="day">
                <h3>{track}</h3>
                <small>{classCountOnTrack(track)} classes</small>
              </div>
            ))
          }

          {
            TIMETABLE.map((slot) => (
              <>
                <div class="hour">{slot.time}</div>
                {tracks.map((track) => {
                  const cell = slot.classes[track] ?? [];
                  return (
                    <div class:list={['cell', { free: cell.length === 0 }]}>
                      {cell.map((entry) => {
                        const meta = metaFor(entry);
                        return (
                        <div data-disclosure-cell>
                          <button
                            class="class"
                            type="button"
                            data-disclosure-trigger
                            aria-expanded="false"
                            aria-controls={`class-${entry.id}`}
                          >
                            <span class="title">{entry.title}</span>
                            <span class="ends">{entry.ends}</span>
                            <span class="meta">{meta}</span>
                          </button>
                          <div class="class-panel" id={`class-${entry.id}`} data-disclosure-panel>
                            {entry.description}
                          </div>
                        </div>
                        );
                      })}
                    </div>
                  );
                })}
              </>
            ))
          }
        </div>
      </div>
    </disclosure-group>

    <p class="mt-7 text-ink-2">
      Our classes run across the three mornings —
      <a href="/classes">the full list is on the classes page</a>, by age, by day, or in full.
    </p>
  </div>
</section>
