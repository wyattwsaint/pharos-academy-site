---
import '../styles/global.css';
import { SCHOOL_NAME } from '../lib/site.js';
import type { Actor } from '../lib/admin/sessions.js';
import { configuredMailer } from '../lib/backup/monthly.js';
import { outboundMailWarning } from '../lib/admin/outbound-mail.js';

interface Props {
  title: string;
  /** Null on the login page — the only admin screen with nobody signed in. */
  actor?: Actor | null;
}

const { title, actor = null } = Astro.props;
const current = Astro.url.pathname;

/**
 * The admin's whole navigation. Flat, because permissions are flat (#16):
 * everything either admin can do is on this list, and neither of them sees a
 * screen the other does not.
 */
const NAV = [
  { href: '/admin/inquiries', label: 'Inquiries' },
  { href: '/admin/applications', label: 'Applications' },
  { href: '/admin/school-details', label: 'School details' },
  { href: '/admin/people', label: 'People' },
  { href: '/admin/courses', label: 'Classes' },
  { href: '/admin/announcements', label: 'Announcements' },
  { href: '/admin/policies', label: 'Policies' },
  { href: '/admin/school-year', label: 'School year' },
  { href: '/admin/events', label: 'Events' },
  { href: '/admin/money', label: 'Money' },
  { href: '/admin/users', label: 'Users' },
  { href: '/admin/backup', label: 'Backup' },
];

/**
 * Whether this deployment can send at all (#136).
 *
 * Here, in the layout, because an unconfigured mailer silences *every* form on
 * the site: a warning that lived on one screen would be a warning Jill sees on
 * the day she happens to open that screen.
 *
 * Read the same way the forms read it — spelled out rather than handed the whole
 * of `import.meta.env`, because Vite substitutes these where they are *written*
 * (see `MailEnv`). That is what makes the warning true rather than merely
 * plausible: it is compiled from the same build as `apply.astro` and
 * `inquire.astro`, so it says "these forms cannot send" and not "this deployment
 * has no credentials right now". Credentials pasted into Vercel take effect on
 * the next deploy, for the forms and for this warning together.
 *
 * Only for somebody signed in. On the login page there is nobody to warn, and
 * naming the deployment's missing variables to a stranger is not a warning — it
 * is a disclosure.
 */
const warning = actor
  ? outboundMailWarning(
      configuredMailer({
        GMAIL_USER: import.meta.env.GMAIL_USER,
        GMAIL_APP_PASSWORD: import.meta.env.GMAIL_APP_PASSWORD,
        RESEND_API_KEY: import.meta.env.RESEND_API_KEY,
        MAIL_FROM: import.meta.env.MAIL_FROM,
      }),
    )
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {SCHOOL_NAME} admin</title>
    <!--
      Belt and braces with the `X-Robots-Tag` the middleware forces on every
      `/admin` response. The admin is never indexable, before or after launch.
    -->
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="min-h-screen bg-cream text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:bg-navy focus:px-4 focus:py-2 focus:text-cream"
    >
      Skip to content
    </a>

    {
      actor && (
        <header class="border-b border-navy/15 bg-parchment">
          <div class="mx-auto flex max-w-3xl flex-wrap items-center gap-x-6 gap-y-2 px-6 py-4">
            <p class="font-semibold text-navy">{SCHOOL_NAME} admin</p>
            <nav aria-label="Admin" class="flex gap-4">
              {NAV.map((item) => (
                <a
                  href={item.href}
                  aria-current={
                    // People has screens under it — a person's own edit page is
                    // still "People" as far as the nav is concerned.
                    current === item.href || current.startsWith(`${item.href}/`)
                      ? 'page'
                      : undefined
                  }
                  class="underline underline-offset-4 aria-[current=page]:font-semibold"
                >
                  {item.label}
                </a>
              ))}
            </nav>
            <form method="post" action="/admin/logout" class="ml-auto flex items-center gap-3">
              <p>
                Signed in as <span class="font-semibold">{actor.name}</span>
              </p>
              <button type="submit" class="underline underline-offset-4">Sign out</button>
            </form>
          </div>
        </header>
      )
    }

    {
      warning && (
        // Above the content and across the whole width, on every screen, for as
        // long as the state lasts. There is nothing to dismiss: a warning with a
        // close button is a warning that is gone by the second application.
        <div class="border-b-4 border-gold bg-parchment" data-testid="mail-warning">
          <p class="mx-auto max-w-3xl px-6 py-4 font-semibold">⚠ {warning}</p>
        </div>
      )
    }

    <main id="main" class="mx-auto max-w-3xl px-6 py-10">
      <slot />
    </main>
  </body>
</html>
