---
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import type { SchoolDetails } from '../lib/db/schema.js';
import { SCHOOL_NAME, SITE_URL } from '../lib/site.js';
import { renderJsonLd, schoolJsonLd } from '../lib/structured-data.js';

interface Props {
  title: string;
  description: string;
  /**
   * The school details row, read by the **page** and handed down (#34).
   *
   * A prop rather than a read of this layout's own, and required rather than
   * optional, because of how a rendered response is committed: Astro streams,
   * so by the time a layout's frontmatter runs the 200 has already gone to the
   * client. A database failure in here therefore truncates a page that has
   * already said it succeeded — and a 2xx with the database down is precisely
   * what `e2e/database-down.spec.ts` exists to forbid, because the CDN caches
   * that emptiness over the good copy.
   *
   * Page frontmatter, by contrast, is fully awaited before a byte is sent, so
   * the throw becomes a 500, the ISR regeneration fails, and Vercel keeps
   * serving stale. Making the prop required puts that on the type checker: a
   * new public page cannot forget to read the row, because it will not compile.
   */
  details: SchoolDetails;
  /**
   * Whether this page opens on the full-bleed video hero.
   *
   * Only the homepage does. It changes two things: the fixed header starts
   * chrome-less rather than navy, and `<main>` is not padded down past it,
   * because the hero is meant to run underneath.
   */
  overHero?: boolean;
}

const { title, description, details, overHero = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

/*
 * `data-site` on the <body> below marks the public surfaces, and only them. The
 * admin shares this stylesheet, so the inline-prose-link rule in `beacon.css`
 * is scoped to the attribute and the admin's own plain chrome is left alone
 * (#103).
 */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {SCHOOL_NAME}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    {
      /*
        The hero's poster is the largest thing above the fold, and under
        `prefers-reduced-motion` it is the *only* thing there — the video never
        loads at all. Preloaded so the first paint is the painting rather than
        the flat backstop colour behind it.
      */
      overHero && <link rel="preload" as="image" href="/hero/hope-poster.webp" />
    }
    {
      /*
        School / LocalBusiness structured data (#30 AC 6), on every page rather
        than only the homepage.

        One node with a stable `@id`, so the pages do not describe three
        different schools — they all point at the same entity. It is here rather
        than in a component because it belongs in `<head>`, and it is read from
        the school details row for the reason the footer is: the address on the
        live site is hand-typed in 22 places and has already drifted, and markup
        that disagrees with the page beside it is what a search engine believes.
      */
    }
    <script type="application/ld+json" set:html={renderJsonLd(schoolJsonLd(details, Astro.site ?? SITE_URL))} is:inline />
  </head>
  <body data-site>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-navy focus:px-4 focus:py-2 focus:text-cream"
    >
      Skip to content
    </a>
    <SiteHeader overHero={overHero} />
    <main id="main" class:list={[{ 'pt-24': !overHero }]}>
      <slot />
    </main>
    <SiteFooter details={details} />
  </body>
</html>
