---
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { breadcrumbJsonLd } from '../lib/breadcrumbs.js';
import type { SchoolDetails } from '../lib/db/schema.js';
import type { AnnouncementBanner } from '../lib/home/announcement-banner.js';
import { SITE_URL } from '../lib/site.js';
import { canonicalUrl, pageTitle, socialPreviewTags } from '../lib/social-preview.js';
import { jsonLdGraph, renderJsonLd, schoolJsonLd } from '../lib/structured-data.js';

interface Props {
  title: string;
  description: string;
  /**
   * The school details row, read by the **page** and handed down (#34).
   *
   * A prop rather than a read of this layout's own, and required rather than
   * optional, because of how a rendered response is committed: Astro streams,
   * so by the time a layout's frontmatter runs the 200 has already gone to the
   * client. A database failure in here therefore truncates a page that has
   * already said it succeeded — and a 2xx with the database down is precisely
   * what `e2e/database-down.spec.ts` exists to forbid, because the CDN caches
   * that emptiness over the good copy.
   *
   * Page frontmatter, by contrast, is fully awaited before a byte is sent, so
   * the throw becomes a 500, the ISR regeneration fails, and Vercel keeps
   * serving stale. Making the prop required puts that on the type checker: a
   * new public page cannot forget to read the row, because it will not compile.
   */
  details: SchoolDetails;
  /**
   * Whether this page opens on the full-bleed video hero.
   *
   * Only the homepage does. It changes two things: the fixed header starts
   * chrome-less rather than navy, and `<main>` is not padded down past it,
   * because the hero is meant to run underneath.
   */
  overHero?: boolean;
  /**
   * The announcement bar for the header, or none (#15).
   *
   * Passed in rather than derived from `details` here, even though it could be:
   * the bar is the home page's, and every other page reads the same row. A
   * layout that derived it would put it on all nine.
   */
  banner?: AnnouncementBanner | null;
  /**
   * What *this page's* own content is, in structured data (#151).
   *
   * The school node and the breadcrumb are added here for every page, because
   * both are properties of being a page of this site. A class node and an event
   * node are not: they describe rows the page has already read, and only the page
   * that read them can build them without a second database call in a layout
   * that renders mid-stream — which is the failure `details` is a prop to avoid.
   *
   * So a page hands its nodes down and they join the same `@graph`, pointing at
   * the same school by `@id`.
   */
  jsonLd?: (object | null | undefined)[];
}

const {
  title,
  description,
  details,
  overHero = false,
  banner = null,
  jsonLd = [],
} = Astro.props;

/*
 * The canonical URL, the `<title>` and the link-preview card are all derived
 * from the same two props, in one module (#147). They used to be built here —
 * which was fine while the canonical was the only one of the three, and is
 * exactly how a card ends up titled differently from the tab it opens.
 */
const site = Astro.site ?? SITE_URL;
const canonical = canonicalUrl(site, Astro.url.pathname);
const preview = socialPreviewTags({ title, description, pathname: Astro.url.pathname, site });

/*
 * `data-site` on the <body> below marks the public surfaces, and only them. The
 * admin shares this stylesheet, so the inline-prose-link rule in `beacon.css`
 * is scoped to the attribute and the admin's own plain chrome is left alone
 * (#103).
 */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle(title)}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    {
      /*
        The tab icon, and the icon Google prints beside the blue link (#291).

        Google reads that one from the page's own icon links and never from the
        structured data, so the `logo` on the School node below does not cover
        it and neither would a favicon nobody declared. Declared here rather
        than left to the browser's guess at `/favicon.ico`, because the guess is
        the only thing that ever fetches the `.ico` and the SVG is what modern
        tabs should be rendering.
      */
    }
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      /*
        Open Graph and Twitter cards (#147). Emitted from the page's own title
        and description, so a share of any page previews as that page rather
        than as one site-wide default.
      */
    }
    {preview.map((tag) => <meta property={tag.property} name={tag.name} content={tag.content} />)}
    {
      /*
        The hero's poster is the largest thing above the fold, and under
        `prefers-reduced-motion` it is the *only* thing there — the video never
        loads at all. Preloaded so the first paint is the painting rather than
        the flat backstop colour behind it.
      */
      overHero && <link rel="preload" as="image" href="/hero/hope-poster.webp" />
    }
    {
      /*
        The page's structured data — one script, one graph (#30 AC 6, #151).

        The school with a stable `@id`, so the pages do not describe nine
        different schools; the breadcrumb, so a page below the top level says
        where it sits rather than reading as a sibling of the homepage; and
        whatever the page itself is *about* — a class, the year's events. Every
        one of them points at the school by that `@id` rather than restating its
        name and address.

        It is here rather than in a component because it belongs in `<head>`, and
        every value is read from a row for the reason the footer's is: the
        address on the live site is hand-typed in 22 places and has already
        drifted, and markup that disagrees with the page beside it is what a
        search engine believes.
      */
    }
    <script
      type="application/ld+json"
      set:html={renderJsonLd(
        jsonLdGraph(
          schoolJsonLd(details, site),
          breadcrumbJsonLd(Astro.url.pathname, title, site),
          ...jsonLd,
        ),
      )}
      is:inline
    />
  </head>
  <body data-site>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-navy focus:px-4 focus:py-2 focus:text-cream"
    >
      Skip to content
    </a>
    <SiteHeader overHero={overHero} banner={banner} />
    <main id="main" class:list={[{ 'pt-24': !overHero }]}>
      <slot />
    </main>
    <SiteFooter details={details} />
  </body>
</html>
