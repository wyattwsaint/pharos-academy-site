---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSchoolDetails } from '../../lib/admin/school-details.js';
import { listCourses } from '../../lib/courses/store.js';
import { classPath } from '../../lib/courses/views.js';
import { getDb } from '../../lib/db/client.js';
import { INQUIRY_HREF } from '../../lib/home/sections.js';
import { instructorsAmong, leadershipAmong } from '../../lib/people/person.js';
import { listPeople } from '../../lib/people/store.js';
import { SITE_CREDIT } from '../../lib/site.js';

/**
 * The school is people (#26).
 *
 * Two sections off **one list**. Leadership are the three the school ranks, in
 * the order it put them in; instructors are everybody the
 * catalogue actually names, derived rather than stored — assign a course to
 * somebody in the admin and they appear here, with what they teach, without a
 * second list being edited.
 *
 * George Jensen is in both sections and is one row. That is the whole argument
 * for the module this page reads from.
 *
 * **Bios and photographs are optional by design.** Six of the ten names here
 * have no bio, and this page says so by showing their name and their classes
 * rather than a paragraph of invented biography. Nothing is padded to make a
 * card the same height as its neighbour.
 *
 * Slot 4 — the three leadership portraits — is photographs now (#99), and Mandy
 * Saint's is here too, in the instructors list. Only that: real, consenting
 * adults the school supplied, never a generated or stock face. A leader the
 * school has sent no photograph of keeps the empty tint, because the row of
 * three would otherwise come out ragged; an instructor without one carries no
 * portrait frame at all, because seven empty circles would be a page
 * advertising seven missing photographs rather than seven people who teach.
 *
 * **An instructor's bio is behind their name, not under it** (#152). Leadership
 * is three cards and reads as prose; the instructors are a list of eight where a
 * paragraph each would bury what a parent came for, which is who teaches what.
 * The reveal is `<disclosure-group>` — the same element as the class
 * descriptions and the H.O.P.E. row, because two nearly-identical answers to
 * "how does a panel open" on one site is how a client finds the inconsistent
 * one (#21 AC 6). Somebody with no bio gets no trigger and no panel: their name
 * is plain text, and there is nothing to point at that does nothing.
 */
const db = await getDb();
const details = await getSchoolDetails(db);
const [people, courses] = await Promise.all([listPeople(db), listCourses(db)]);

const leadership = leadershipAmong(people);
const instructors = instructorsAmong(people, courses);

const description =
  'The head of school, the chaplain, the director of business administration, and the instructors who teach each class at Pharos Academy.';
---

<BaseLayout details={details} title="Our people" description={description}>
  <section class="band band-quiet" data-section="staff-header">
    <div class="wide">
      <h1>Our Dedicated Staff</h1>
    </div>
  </section>

  <section class="band" id="leadership" data-section="staff-leadership">
    <div class="wide">
      <h2>Leadership</h2>
      <div class="people">
        {
          leadership.map((person) => (
            <article id={person.slug}>
              {
                /*
                  A real photograph when the school has supplied one, and an
                  empty tint when it has not (#13, #99). Never a stand-in face:
                  a generated painting under a named member of staff is the one
                  substitution that would be dishonest.
                */
              }
              {person.photo ? (
                <img
                  class="portrait"
                  src={person.photo}
                  alt={person.name}
                  width="300"
                  height="300"
                  loading="lazy"
                />
              ) : (
                <div class="portrait" aria-hidden="true" />
              )}
              <h3>{person.name}</h3>
              <p class="role label">{person.role}</p>
              {person.bio && <p>{person.bio}</p>}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band band-quiet" id="instructors" data-section="staff-instructors">
    <div class="wide">
      <h2>Instructors</h2>

      <disclosure-group data-disclosure-group="instructors">
        <ul class="staff-teaching">
          {
            instructors.map(({ person, courses: taught }) => {
              // Composed once. The trigger's `aria-controls` and the panel's
              // `id` are the same string by construction rather than by two
              // template literals staying in step with each other.
              const panelId = `bio-${person.slug}`;
              return (
              <li id={person.slug} data-disclosure-cell={person.bio ? '' : undefined}>
                {
                  /*
                    A photograph only where there is one, and only for somebody
                    this page has not already shown (#99). No empty frame for the
                    six with no photograph: a circle of tint beside a name reads as
                    a missing person rather than as a person the school simply has
                    no picture of, and only one of these eight names has a face to
                    show. And no second copy of George's face — he is one row,
                    printed twice, and two identical circles a screen apart would
                    read as two people.
                  */
                }
                {person.photo && person.leadershipRank === null && (
                  <img
                    class="portrait"
                    src={person.photo}
                    alt={person.name}
                    width="300"
                    height="300"
                    loading="lazy"
                  />
                )}
                {
                  /*
                    The name is the trigger, and the only one: `disclosure-group`
                    binds the first trigger in a cell, and a heading cannot go
                    inside a button, so wrapping the portrait as well would mean
                    either invalid markup or a second control that opens the same
                    panel. Pointing at the portrait still opens it — the group
                    opens on the *cell* being hovered, which is the whole entry —
                    so "portrait or name" holds for a pointer, and a tap or a Tab
                    lands on the name, which is the part every instructor has.
                  */
                }
                <h3>
                  {person.bio ? (
                    <button
                      class="staff-name-trigger"
                      type="button"
                      data-disclosure-trigger
                      aria-expanded="false"
                      aria-controls={panelId}
                    >
                      {person.name}
                    </button>
                  ) : (
                    person.name
                  )}
                </h3>
                <p class="role label">{person.role}</p>
                {person.bio && (
                  <div class="staff-bio-panel" id={panelId} data-disclosure-panel>
                    <p class="staff-bio">{person.bio}</p>
                  </div>
                )}
                <ul class="staff-classes">
                  {taught.map((course) => (
                    <li>
                      <a href={classPath(course.slug)}>{course.title}</a>
                    </li>
                  ))}
                </ul>
              </li>
              );
            })
          }
        </ul>
      </disclosure-group>

      <p class="mt-9 text-ink-2">
        Wondering whether a class is right for your child?
        <a href={INQUIRY_HREF}>Ask us</a> — the answer comes from the person who teaches it.
      </p>
    </div>
  </section>

  {
    /*
      #150. The credit the Head of School asked for, at the foot of the page and
      outside both lists. Under the "Instructors" heading it would read as a
      tenth instructor; in its own quiet line it reads as what it is.
    */
  }
  <section class="credit-band" data-section="staff-credit">
    <div class="wide">
      <p class="staff-credit">{SITE_CREDIT}</p>
    </div>
  </section>
</BaseLayout>

<script>
  // The only script this page loads: the instructor bios (#152) open with the
  // same element the class descriptions and the H.O.P.E. row use.
  import '../../components/disclosure-group.js';
</script>
