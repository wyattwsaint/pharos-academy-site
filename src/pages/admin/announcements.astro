---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { isCurrent, STALE_AFTER_DAYS } from '../../lib/announcements/announcement.js';
import { listAnnouncements } from '../../lib/announcements/store.js';
import { postedOnLabel } from '../../lib/announcements/views.js';
import { formatStamp } from '../../lib/admin/school-details.js';
import { getDb } from '../../lib/db/client.js';
import { NEWS_PATH } from '../../lib/announcements/views.js';

/**
 * Everything the school has announced, newest first (#27).
 *
 * A list and nothing else; every edit happens on the announcement's own screen.
 * The one thing this screen adds is telling Jill which of them the homepage is
 * currently showing — the six-week rule is invisible from the public side by
 * design, and an admin that did not say so would leave her wondering why an
 * announcement she can see here is not on the front page.
 *
 * There is no delete. An announcement is a record of what the school said, and
 * going stale already takes it off the homepage — which is the thing a delete
 * button would actually be for.
 */
const db = await getDb();
const actor = Astro.locals.actor!;

const announcements = await listAnnouncements(db);
const now = new Date();
const showing = announcements.filter((announcement) => isCurrent(announcement, now)).length;
---

<AdminLayout title="Announcements" actor={actor}>
  <h1 class="text-3xl font-semibold text-navy">Announcements</h1>
  <p class="mt-2">
    Board updates, fundraisers and notices. Everything here is on the <a
      href={NEWS_PATH}
      class="underline underline-offset-4">news page</a
    >; the homepage shows the ones posted in the last {STALE_AFTER_DAYS} days and hides itself
    entirely when there are none.
  </p>

  <p class="mt-4" data-testid="showing-count">
    {
      showing === 0
        ? 'Nothing is on the homepage at the moment — the announcements section there is hidden.'
        : `The homepage is showing ${showing} of these.`
    }
  </p>

  <p class="mt-8">
    <a
      href="/admin/announcements/new"
      class="rounded bg-navy px-5 py-2.5 font-semibold text-cream hover:bg-deep-blue"
    >
      Post an announcement
    </a>
  </p>

  <ul class="mt-8 flex flex-col gap-6">
    {
      announcements.map((announcement) => (
        <li class="border-t border-navy/15 pt-6">
          <h2 class="text-xl font-semibold text-navy">
            <a
              href={`/admin/announcements/${announcement.slug}`}
              class="underline underline-offset-4"
            >
              {announcement.headline}
            </a>
          </h2>
          <p class="mt-1 text-sm">
            {postedOnLabel(announcement.postedOn)}
            {' · '}
            {isCurrent(announcement, now) ? 'On the homepage' : 'On the news page only'}
            {' · '}
            {announcement.attachmentFilename ?? 'No PDF'}
          </p>
          <p class="mt-1 text-sm" data-testid={`stamp-${announcement.slug}`}>
            {formatStamp(announcement.lastEditedBy, announcement.lastEditedAt)}
          </p>
        </li>
      ))
    }
  </ul>

  <p class="mt-10 border-t border-navy/15 pt-6">
    Nothing is ever deleted here. An announcement that has aged out stays on the news page, which is
    where a family looks for what was said last term.
  </p>
</AdminLayout>
