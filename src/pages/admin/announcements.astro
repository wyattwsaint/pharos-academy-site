---
export const prerender = false;

import AdminBanner from '../../components/AdminBanner.astro';
import AdminButton from '../../components/AdminButton.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listAnnouncements } from '../../lib/announcements/store.js';
import { postedOnLabel } from '../../lib/announcements/views.js';
import { formatStamp } from '../../lib/admin/formatting.js';
import { removalOutcome } from '../../lib/admin/republish-outcome.js';
import { getDb } from '../../lib/db/client.js';
import { NEWS_PATH } from '../../lib/announcements/views.js';

/**
 * Everything the school has announced, newest first (#27).
 *
 * A list and nothing else; every edit happens on the announcement's own screen.
 *
 * This screen used to say which of them the homepage was showing. Since #109
 * there is no homepage section, so every announcement is on the news page and
 * nowhere else — there is no longer a difference between two of them for this
 * screen to report, and a six-week note here would describe a rule with no
 * visible effect.
 *
 * The delete is on the announcement's own screen, and this is where it lands
 * (#258): the row is gone by the time anybody reads this, so what went is named
 * from the query string rather than looked up, and whether the live site agrees
 * is said in the same words every other screen says it in.
 */
const db = await getDb();
const actor = Astro.locals.actor!;

const announcements = await listAnnouncements(db);
/**
 * What a delete that redirected here has to say for itself. Nothing on this
 * screen acts, so this is the only banner it can carry.
 */
const banner = removalOutcome(
  Astro.url.searchParams.get('removed'),
  Astro.url.searchParams.get('republished'),
  'news',
);
---

<AdminLayout title="Announcements" actor={actor}>
  <h1 class="text-3xl font-semibold text-navy">Announcements</h1>
  <p class="mt-2">
    Board updates, fundraisers and notices. Everything here is on the <a
      href={NEWS_PATH}
      class="underline underline-offset-4">news page</a
    >, newest first, and stays there.
  </p>

  {
    banner && (
      <AdminBanner ok={banner.ok} message={banner.message} testId="announcements-banner" retry />
    )
  }

  <p class="mt-8">
    <AdminButton href="/admin/announcements/new">Post an announcement</AdminButton>
  </p>

  {
    announcements.length === 0 ? (
      <p class="mt-8 border-t border-navy/15 pt-6" data-testid="no-announcements">
        Nothing to show. The first announcement posted here goes to the top of the news page the
        moment it is saved, and stays there — nothing ages off. An empty list is either a school
        that has not said anything here yet, or one that has taken down the little it had.
      </p>
    ) : (
      <ul class="mt-8 flex flex-col gap-6">
        {announcements.map((announcement) => (
          <li class="border-t border-navy/15 pt-6">
            <h2 class="text-xl font-semibold text-navy">
              <a
                href={`/admin/announcements/${announcement.slug}`}
                class="underline underline-offset-4"
              >
                {announcement.headline}
              </a>
            </h2>
            <p class="mt-1 text-sm">
              {postedOnLabel(announcement.postedOn)}
              {' · '}
              {announcement.attachmentFilename ?? 'No PDF'}
            </p>
            <p class="mt-1 text-sm" data-testid={`stamp-${announcement.slug}`}>
              {formatStamp(announcement.lastEditedBy, announcement.lastEditedAt)}
            </p>
          </li>
        ))}
      </ul>
    )
  }

  <p class="mt-10 border-t border-navy/15 pt-6">
    An old announcement is not deleted. It stays on the news page, which is where a family looks
    for what was said last term. Delete is for the one that has become <em>untrue</em> — a
    fundraiser the school withdrew — and it is on the announcement’s own screen.
  </p>
</AdminLayout>
