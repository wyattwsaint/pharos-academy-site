---
export const prerender = false;

import AdminBanner from '../../components/AdminBanner.astro';
import AdminButton from '../../components/AdminButton.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import type { Banner } from '../../lib/admin/banner.js';
import { UNIT_LABELS } from '../../lib/admin/courses.js';
import { formatDay, formatStamp } from '../../lib/admin/formatting.js';
import { pressRetirement, RETIRE_VALUES } from '../../lib/admin/retirement.js';
import { durationLabel, type Course } from '../../lib/courses/course.js';
import { priceSummary } from '../../lib/courses/pricing.js';
import { timeLabel } from '../../lib/courses/schedule.js';
import { listEveryCourse } from '../../lib/courses/store.js';
import { getDb } from '../../lib/db/client.js';
import { getMoneySettings } from '../../lib/money/store.js';

/**
 * The whole catalogue, in the order the store keeps it (#24).
 *
 * A list and nothing else, as People is: every edit happens on the class's own
 * screen, so there is one place a class changes and one thing that can go
 * wrong. The line under each title is the same derived vocabulary the public
 * pages print — the day, the time, the duration and the price — so what Jill
 * reads here is what a parent reads there, rather than a second summary that
 * could disagree.
 *
 * There is still no delete here, and the reason is no longer the one People
 * used to share. People has a delete now (#262), because nothing a family sent
 * names a person. A **course** is named by what a family sent: an application
 * records the classes a child was enrolled in, so removing one edits a record
 * that is not the school's to edit. ADR-0021 gates it on the Applications
 * screen and the class tally first being able to read an offering key the
 * catalogue no longer has — naming it, marking it as no longer offered, and
 * still counting it.
 *
 * What there is instead is **Retire** (#263), and the retired classes are on
 * this screen rather than behind a filter. A screen that hid them is a screen
 * where the office re-creates a class it already has, and then has two — so
 * they sit in their own section beneath the live ones, each with the date the
 * school stopped running it, one press from coming back.
 *
 * The press answers here rather than through a redirect, for the reason the
 * editors do: retiring republishes the site, and the republish answer is a fact
 * the office needs told. A redirect would throw it away.
 */
const db = await getDb();
const actor = Astro.locals.actor!;

let banner: Banner | null = null;

if (Astro.request.method === 'POST') {
  // The only thing this screen posts is a Retire, so a form it cannot read is
  // not a save to fall through to — it is a button that named no class.
  const pressed = await pressRetirement({
    db,
    form: await Astro.request.formData(),
    actorName: actor.name,
    url: Astro.url,
  });
  banner = pressed?.banner ?? {
    ok: false,
    message: 'Nothing changed — that button did not say which class.',
  };
}

const courses = await listEveryCourse(db);
const settings = await getMoneySettings(db);

/** The two sections, in the order the office reads them: what runs, then what waits. */
const running = courses.filter((course) => course.retiredAt === null);
const retired = courses.filter((course) => course.retiredAt !== null);

/** The one derived line both sections print under a title. */
const summaryOf = (course: Course) =>
  [
    course.days.join(', '),
    timeLabel(course.start, course.end),
    durationLabel(course),
    priceSummary(course, settings.rates),
  ].join(' · ');
---

<AdminLayout title="Classes" actor={actor}>
  <h1 class="text-3xl font-semibold text-navy">Classes</h1>
  <p class="mt-2">
    One list, alphabetical. Each class appears by age, by day, in the full descriptions and on its
    own page — all four from this one row.
  </p>

  {banner && <AdminBanner ok={banner.ok} message={banner.message} testId="retire-banner" retry />}

  <p class="mt-8">
    <AdminButton href="/admin/courses/new">Add a course</AdminButton>
  </p>

  {
    courses.length === 0 ? (
      <p class="mt-8 border-t border-navy/15 pt-6" data-testid="no-courses">
        No classes yet. By age, by day, the full descriptions and each class's own page are all
        drawn from this one list, so while it is empty a parent finds nothing on any of the four.
        The first class added fills all of them at once.
      </p>
    ) : running.length === 0 ? (
      <p class="mt-8 border-t border-navy/15 pt-6" data-testid="all-retired">
        Every class is retired. By age, by day, the full descriptions and each class's own page are
        empty to a parent until one of the classes below is brought back, or a new one added.
      </p>
    ) : (
      <ul class="mt-8 flex flex-col gap-6" data-testid="running-courses">
        {running.map((course) => (
          <li class="border-t border-navy/15 pt-6">
            <h2 class="text-xl font-semibold text-navy">
              <a href={`/admin/courses/${course.slug}`} class="underline underline-offset-4">
                {course.title}
              </a>
            </h2>
            <p class="mt-1">{summaryOf(course)}</p>
            <p class="mt-1 text-sm" data-testid={`units-${course.slug}`}>
              Families can enroll for:{' '}
              {course.enrolmentUnits.map((unit) => UNIT_LABELS[unit]).join(', ')}
            </p>
            {
              /*
                A class the school has scheduled and not staffed (#257). Said
                here rather than left to be noticed on the class's own screen,
                because this is the list somebody scans — and the public pages
                say nothing at all about it, correctly, so this is the only
                place the want is visible.
              */
              course.instructorSlug === null && (
                <p class="mt-1 text-sm" data-testid={`no-instructor-${course.slug}`}>
                  No instructor yet — this class is scheduled and unstaffed.
                </p>
              )
            }
            <p class="mt-1 text-sm" data-testid={`stamp-${course.slug}`}>
              {formatStamp(course.lastEditedBy, course.lastEditedAt)}
            </p>
            <form method="post" class="mt-3">
              <input type="hidden" name="slug" value={course.slug} />
              <input type="hidden" name="retire" value={RETIRE_VALUES.retire} />
              <AdminButton
                small
                variant="secondary"
                pendingLabel="Retiring…"
                testId={`retire-${course.slug}`}
              >
                Retire
              </AdminButton>
            </form>
          </li>
        ))}
      </ul>
    )
  }

  {
    retired.length > 0 && (
      <section class="mt-12" data-testid="retired-courses">
        <h2 class="text-2xl font-semibold text-navy">Retired</h2>
        <p class="mt-2">
          Classes the school is not running now. They are off the class lists, off the timetable and
          not offered on the application — and each one still answers at its own address, saying the
          school is not currently running it. Nothing has been lost: bringing one back puts it on
          every list it left, with nothing retyped.
        </p>
        <ul class="mt-6 flex flex-col gap-6">
          {retired.map((course) => (
            <li class="border-t border-navy/15 pt-6">
              <h3 class="text-xl font-semibold text-navy">
                <a href={`/admin/courses/${course.slug}`} class="underline underline-offset-4">
                  {course.title}
                </a>
              </h3>
              <p class="mt-1" data-testid={`retired-on-${course.slug}`}>
                Retired {formatDay(course.retiredAt!)}
              </p>
              <p class="mt-1 text-sm">{summaryOf(course)}</p>
              <p class="mt-1 text-sm" data-testid={`stamp-${course.slug}`}>
                {formatStamp(course.lastEditedBy, course.lastEditedAt)}
              </p>
              <form method="post" class="mt-3">
                <input type="hidden" name="slug" value={course.slug} />
                <input type="hidden" name="retire" value={RETIRE_VALUES.unretire} />
                <AdminButton
                  small
                  pendingLabel="Bringing it back…"
                  testId={`unretire-${course.slug}`}
                >
                  Bring it back
                </AdminButton>
              </form>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <p class="mt-10 border-t border-navy/15 pt-6">
    The price is never typed. It is the meeting length × the weeks × the rate on the <a
      href="/admin/money"
      class="underline underline-offset-4">Money</a
    > screen, worked out fresh every time a class is saved or shown.
  </p>
</AdminLayout>
