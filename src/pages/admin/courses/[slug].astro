---
export const prerender = false;

import AdminBanner from '../../../components/AdminBanner.astro';
import AdminButton from '../../../components/AdminButton.astro';
import AdminConfirm from '../../../components/AdminConfirm.astro';
import AdminField from '../../../components/AdminField.astro';
import AdminPublishing from '../../../components/AdminPublishing.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import type { Banner } from '../../../lib/admin/banner.js';
import { isConfirmed } from '../../../lib/admin/confirmation.js';
import { courseFormView } from '../../../lib/admin/course-form.js';
import {
  courseDeletion,
  CUSTOM_TIME,
  emptyFields,
  fieldsOf,
  LABELS,
  parseCourse,
  RATE_LABELS,
  UNIT_LABELS,
  type CourseErrors,
  type CourseFields,
  type CourseFormFields,
} from '../../../lib/admin/courses.js';
import { isrBypassToken } from '../../../lib/admin/isr-token.js';
import { COURSE_RETIREMENT, pressRetirement, RETIRE_VALUES } from '../../../lib/admin/retirement.js';
import { saveErrorMessage } from '../../../lib/admin/save-errors.js';
import {
  describeRevalidation,
  revalidateAll,
  revalidationOrigin,
} from '../../../lib/admin/revalidate.js';
import { formatDay, formatStamp } from '../../../lib/admin/formatting.js';
import { republishOutcome } from '../../../lib/admin/republish-outcome.js';
import { countApplicationsForCourse } from '../../../lib/application/store.js';
import { fullDateLabel, type SchoolYear } from '../../../lib/calendar/year.js';
import { getSchoolYear } from '../../../lib/calendar/store.js';
import { ENROLMENT_UNITS, RATE_TIERS, STAGES } from '../../../lib/courses/course.js';
import { priceLine } from '../../../lib/courses/pricing.js';
import { contactHours, timeLabel, type DayTrack } from '../../../lib/courses/schedule.js';
import { meetingSlots, runningTracks, type ClashWarning } from '../../../lib/courses/slots.js';
import {
  createCourse,
  deleteCourse,
  getCourse,
  listRunningCourses,
  saveCourse,
} from '../../../lib/courses/store.js';
import { getDb } from '../../../lib/db/client.js';
import { getMoneySettings } from '../../../lib/money/store.js';
import { slugify } from '../../../lib/people/person.js';
import { listEveryPerson } from '../../../lib/people/store.js';

/**
 * One course, added or edited (#24).
 *
 * `/admin/courses/new` is the add form and every other slug is that course's
 * own screen — one page rather than two, as people and announcements are,
 * because the fields, the validation and the publishing story are identical.
 *
 * Three things make this screen different from the other editors, and all three
 * are the ticket:
 *
 * **The price is not here.** It is contact hours × the rate tier, computed and
 * shown read-only. There is no input to type it into, which is how "cannot be
 * typed over" is a property of the form rather than a promise about it.
 *
 * **The days and times are the school's own.** The day checkboxes are the
 * year's running tracks — a track the School Year screen gives no term is a day
 * the school does not meet — and the time list is the distinct times the
 * catalogue already runs on those tracks. "Another time" exists because the
 * first course on an empty track has no slot to pick.
 *
 * **A clash warns and never blocks.** The Wednesday 10:40 slot carries five
 * electives on purpose, so an occupied slot is a fact Jill is told, not a save
 * she is refused.
 *
 * The clash, the block's end date and the block's start dates are all read from
 * the form as it currently stands rather than from the saved row (#59, #60,
 * #61) — `courseFormView` answers all three, and reading them from the store
 * was the same mistake three times over: nothing shown until a save had already
 * happened.
 *
 * **The class can be deleted, and its applications cannot** (#267, ADR-0021).
 * The delete is unconditional — never refused for having been applied for,
 * because one application season would otherwise freeze the catalogue for good
 * — and what makes that safe is that an application names its classes out of
 * what it captured at submission (#259), so nothing here can reach a family's
 * record. It confirms first, the way every destructive action in this admin
 * does: the first press replaces the form with a screen naming what goes, who
 * has applied and what they keep, and only the second press deletes. Confirming
 * republishes and leaves for the Classes list, because this screen is what has
 * just stopped existing.
 *
 * The fields, buttons, banner and Publishing section this screen used to spell
 * out for itself now come from the shared components (#195). It is the same
 * form — same fields, same order, same words, same validation — and the three
 * things above are untouched. What changes is that the `aria-describedby`
 * wiring is written once: the two lists' complaints now hang off their
 * fieldsets, where a screen reader announces them on entering the group, and
 * the start/end pair's complaints are announced with the inputs they are about
 * rather than sitting beside them unassociated (#190).
 */
/** The one slug that is not a course: the add form's address. */
const NEW = 'new';

/**
 * The one refusal that actually happens here is a duplicate slug: two classes
 * whose titles slugify the same, which is a real thing in a catalogue with two
 * Latins.
 */
const SAVE_ERROR = {
  duplicate: 'there is already a class with that title. Edit that one instead.',
} as const;

const db = await getDb();
const actor = Astro.locals.actor!;

const routeSlug = Astro.params.slug ?? '';
const adding = routeSlug === NEW;

let course = adding ? undefined : await getCourse(db, routeSlug);
if (!adding && !course) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

/*
 * The year is what the day checkboxes, the slot list and every block date are
 * drawn from, so a database without one cannot render this screen at all. Said
 * out loud rather than rendered as an empty form whose every day is missing.
 */
const year: SchoolYear | undefined = await getSchoolYear(db);
if (!year) {
  throw new Error('There is no school year yet — run `npm run db:migrate`.');
}

const settings = await getMoneySettings(db);
/*
 * Who this class can be given to: the people the school lists, plus the one
 * this class already names if they have since retired (#266).
 *
 * The second half is not a nicety. A `select` whose options omit the value it
 * was given posts the *first* option instead, so a course naming somebody who
 * has left would be silently reassigned to whoever sorts first the next time
 * anybody fixed a typo in its description. Keeping them in the list, marked,
 * means the office decides who takes the class over rather than the browser.
 *
 * Nobody retired is offered for a class that does not already name them: they
 * are not somebody the school can hand a class to, and a live class naming them
 * would print no instructor at all.
 */
/*
 * Filtered out of the whole list rather than fetched as two, so the order is
 * the store's own — leadership first and then by name, the order the staff page
 * and the People screen render in. Somebody appended to the published list
 * would be the one name in the admin that is not where it is everywhere else.
 */
const people = (await listEveryPerson(db)).filter(
  (person) => person.retiredAt === null || person.slug === course?.instructorSlug,
);
const instructorSlugs = people.map((person) => person.slug);
/*
 * Read before the save, and used for both the slot list and the clash
 * check. Pre-save is the correct reading for either: on the add form this
 * course is not in it yet, and on the edit form the row still holds the times
 * it had when Jill opened the screen — and `clashWarnings` drops the
 * candidate's own slug regardless.
 *
 * `listRunningCourses` rather than `listCourses`, because a catalogue can now be
 * emptied entirely (#267) and this screen is where the next class is typed in.
 * The rows are the same ones — the store applies one filter for both — and what
 * is left off is the empty-catalogue guard, which reads no rows as an unmigrated
 * database. That is right for a page a parent opens, and would make the add form
 * unreachable exactly when it is needed most.
 *
 * `listPeople` below still carries that guard, and this ticket does not move it:
 * the staff list is #262's to reason about, not a course delete's.
 */
const courses = await listRunningCourses(db);

let values: CourseFields = course ? fieldsOf(course) : emptyFields();
let errors: CourseErrors = {};
let banner: Banner | null = republishOutcome(Astro.url.searchParams.get('republished'));
/*
 * The parser's reading of the posted form, kept so the view below is not a
 * second reading of the same strings (#75). Null on a GET, where there is no
 * parser and the view reads for itself.
 */
let fields: CourseFormFields | null = null;
/** True only on the confirmation screen, which replaces the form. */
let confirmingDeletion = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  /*
   * Three buttons post to this address now, and Delete is read before either
   * of the others (#267).
   *
   * Nothing is parsed on the way: the delete form carries no course fields, so
   * handing it to `parseCourse` would refuse the class for having an empty
   * title nobody touched. The first press only asks — it writes nothing at all
   * — and the second, carrying the same hidden field plus `confirm`, is the
   * one that deletes.
   */
  const deleting = form.get('delete') !== null && course !== undefined;

  if (deleting && !isConfirmed(form)) {
    confirmingDeletion = true;
  } else if (deleting && course) {
    const deleted = course.title;
    await deleteCourse(db, course.slug);
    const result = await revalidateAll({
      origin: revalidationOrigin(Astro.url),
      bypassToken: isrBypassToken(),
    });
    /*
     * The answer travels in the query string, the way the policy delete's does
     * (#260): this screen is a 404 from here on, and the Classes list is where
     * the deletion is visible. In the URL rather than rendered there, so a
     * refresh of the list repeats nothing.
     */
    const back = new URL('/admin/courses', Astro.url.origin);
    back.searchParams.set('deleted', deleted);
    back.searchParams.set('republished', result.ok ? 'live' : 'stale');
    return Astro.redirect(`${back.pathname}${back.search}`, 303);
  } else {
    /*
     * Retire is read next (#263).
     *
     * It is not a field of the course form and never goes through the parser: a
     * retirement is one column and a stamp, where a save is the whole row, and
     * folding them together would mean a class could be brought back by a save
     * that only fixed a typo. `parseRetirement` answers null for the Save form,
     * which is what falls through to the parser below.
     */
    const pressed = course
      ? await pressRetirement({
          db,
          subject: COURSE_RETIREMENT,
          form,
          slug: course.slug,
          actorName: actor.name,
          url: Astro.url,
        })
      : null;

    if (pressed) {
      banner = pressed.banner;
      // Absent when the write was refused, which leaves the screen showing the
      // class exactly as it was — which is what happened to it.
      if (pressed.record) {
        course = pressed.record;
        values = fieldsOf(course);
      }
    } else {
      const parsed = parseCourse(form, { year, instructorSlugs });
      values = parsed.values;
      errors = parsed.errors;
      fields = parsed.fields;

      if (Object.keys(errors).length > 0) {
        banner = { ok: false, message: 'Nothing was saved — the fields below need fixing first.' };
      } else {
        try {
          course = course
            ? await saveCourse(db, course.slug, parsed.edit, actor.name)
            : await createCourse(db, slugFor(parsed.edit.title), parsed.edit, actor.name);
          values = fieldsOf(course);
          const result = await revalidateAll({
            origin: revalidationOrigin(Astro.url),
            bypassToken: isrBypassToken(),
          });
          banner = { ok: result.ok, message: describeRevalidation(result) };
        } catch (error) {
          banner = { ok: false, message: saveErrorMessage(error, SAVE_ERROR) };
        }
      }
    }
  }
}

/**
 * How many applications named this class, and the sentences that turn on it.
 *
 * Read for the edit screen rather than only for the confirmation, because the
 * paragraph beside the Delete button says the same thing before the press as
 * the confirmation says during it — the office should not have to press a
 * destructive button to find out what it costs. It is never refused for that
 * number either: one season of applications would otherwise freeze the
 * catalogue for good, and what keeps that safe is that an application names its
 * classes out of what it captured at submission (#259).
 *
 * The Delete button sits in the Publishing section beneath Retire, and that
 * order is deliberate: the two presses read as alternatives, which is what they
 * are, and the one with a way back is offered first. The paragraph beside it is
 * the confirmation's own three sentences, not a fourth copy of them — a screen
 * that said this in its own words is a screen where the words drift.
 */
const appliedFor = course ? await countApplicationsForCourse(db, course.slug) : 0;
const deletion = course ? courseDeletion(course.title, appliedFor) : null;

/*
 * After an add succeeds this screen becomes that course's edit screen, so a
 * second Save updates the row just written rather than inserting it again.
 */
const action = course ? `/admin/courses/${course.slug}` : '/admin/courses/new';
const heading = course ? course.title : 'Add a Course';
const stamp = course ? formatStamp(course.lastEditedBy, course.lastEditedAt) : null;

/** The days on offer: the year's, never a hard-coded week. */
const offeredDays = runningTracks(year);

/**
 * The pickable times: every distinct time the school already meets at, on any
 * running track, earliest first.
 *
 * Deduped across tracks because a time is a time — Monday's 10:40 and
 * Wednesday's are the same choice as far as this select is concerned, and
 * offering it twice would ask Jill to pick between two identical options.
 */
const timeOptions = [
  ...new Map(
    meetingSlots(year, courses).map((slot) => [
      `${slot.start}-${slot.end}`,
      { value: `${slot.start}-${slot.end}`, label: timeLabel(slot.start, slot.end) },
    ]),
  ).values(),
].sort((a, b) => a.value.localeCompare(b.value));

/*
 * A course whose own time is not one of the offered slots — the first on a
 * track, or one whose track the year has since stopped running — opens on
 * "Another time" with its two ends filled in, rather than on a select with
 * nothing selected and a time that silently disappears on the next save.
 */
const timeIsSlot = timeOptions.some((option) => option.value === values.time);
const selectedTime = values.time && !timeIsSlot ? CUSTOM_TIME : values.time;

/** The slots the school meets at, and last of all the way out of the list. */
const timeChoices = [...timeOptions, { value: CUSTOM_TIME, label: 'Another time' }];

/**
 * The four enrolment units as a picker's options.
 *
 * Built once and offered twice, because the two lists below are the same four
 * things asked about differently — what the course *is*, and what a family may
 * *buy* — which is exactly why `UNIT_LABELS` is one table rather than two.
 */
const unitOptions = ENROLMENT_UNITS.map((unit) => ({ value: unit, label: UNIT_LABELS[unit] }));

/**
 * The clash warning, the block's start dates and its computed end, all read
 * from `values` — the form as it stands, whether that is a saved course, an add
 * form part-way through, or a rejected post being redisplayed.
 *
 * Read after the POST branch, so a successful save answers about the row just
 * written and a failed one about what is still on screen. On a POST the parser
 * has already read those strings and its reading is handed over rather than
 * made again — and the row a successful save writes *is* what it read, field
 * for field, so the reading still describes what is on screen afterwards.
 */
const view = courseFormView(values, {
  year,
  courses,
  slug: course?.slug ?? null,
  fields: fields ?? undefined,
});

/** The computed end of the block being typed — worked out, never entered. */
const blockEnd = view.blockEnd ? fullDateLabel(view.blockEnd) : null;

/*
 * The parser's complaint where there is one, and otherwise the view's. They are
 * the same refusal from the same function; the parser only gets to make it on a
 * POST, and a block the year has since stopped holding is found on a GET (#60).
 */
const blockStartError = errors.blockStart ?? view.blockError ?? undefined;

/**
 * The fields that are one typed string.
 *
 * Narrowed to those rather than to `keyof CourseFields`, so the loop below
 * cannot be handed `stages` or `days` — the lists have their own controls, and
 * a cast here is how one of them would quietly render as an empty text box.
 */
type TextField = {
  [K in keyof CourseFields]: CourseFields[K] extends string ? K : never;
}[keyof CourseFields];

/**
 * The plain fields, in the order they are asked for. Type decides the control;
 * everything else that varies is written here rather than switched on at the
 * call site.
 *
 * `optional` rather than `required`, because that is the shared field's word for
 * it: most of this form must be filled, and the ones a class may leave empty are
 * the ones that say so.
 */
const FIELDS: {
  name: TextField;
  type: 'text' | 'multiline' | 'number';
  optional?: true;
  hint?: string;
  rows?: number;
  min?: number;
  step?: number;
}[] = [
  { name: 'title', type: 'text', hint: 'As the school writes it, including any “(Grades 5-8)”.' },
  {
    name: 'description',
    type: 'multiline',
    rows: 8,
    hint: 'The full description, as it appears on the class’s own page.',
  },
  {
    name: 'ageLabel',
    type: 'text',
    hint: 'In the school’s own words — “5-10 (approximately K-6th grades)”.',
  },
  {
    name: 'ageMin',
    type: 'number',
    optional: true,
    min: 1,
    step: 1,
    hint: 'The numeric gate, when the school publishes one. Both ends or neither — a class with no numbers shows in every age band.',
  },
  { name: 'ageMax', type: 'number', optional: true, min: 1, step: 1 },
  {
    name: 'credit',
    type: 'text',
    optional: true,
    hint: 'Optional — “1 High School Algebra 1 credit with completed homework”.',
  },
  {
    name: 'requiredText',
    type: 'multiline',
    optional: true,
    rows: 4,
    hint: 'Optional. The books a family must have.',
  },
  { name: 'optionalText', type: 'multiline', optional: true, rows: 4, hint: 'Optional.' },
  {
    name: 'materialsToBuy',
    type: 'multiline',
    optional: true,
    rows: 4,
    hint: 'Optional — what the family buys and brings, as distinct from a fee paid to the school.',
  },
  {
    name: 'materialsFee',
    type: 'number',
    optional: true,
    min: 1,
    step: 1,
    hint: 'Whole dollars, paid to the school. Leave it empty when there is none — an empty box prints nothing, a $0 fee prints a free fee.',
  },
  {
    name: 'materialsFeeNote',
    type: 'text',
    optional: true,
    hint: 'Optional — “per year”. Only with a fee.',
  },
  {
    name: 'assessmentFee',
    type: 'number',
    optional: true,
    min: 1,
    step: 1,
    hint: 'Whole dollars. Same rule as above.',
  },
  {
    name: 'assessmentFeeNote',
    type: 'text',
    optional: true,
    hint: 'Optional — “for test scoring”, “for feedback on writing”.',
  },
  {
    name: 'prerequisites',
    type: 'multiline',
    rows: 4,
    hint: 'The school writes “None” when there are none — so say something either way.',
  },
];

/**
 * The address of a course just added.
 *
 * Derived from the title rather than typed, because a slug is a URL and nobody
 * should have to think about URLs to add a class. Two titles are refused rather
 * than stored: one that slugifies to nothing, which has no page to be reached
 * at, and one that slugifies to `new`, which would be permanently hidden behind
 * this screen's own address.
 */
function slugFor(title: string): string {
  const slug = slugify(title);
  if (!slug) throw new Error('that title has no letters or numbers in it.');
  if (slug === NEW) {
    throw new Error('“New” is the address of this form — give the class a fuller title.');
  }
  return slug;
}

/** Which day a warning is about, said the way the timetable says it. */
function warningLine(warning: ClashWarning): string {
  const when =
    warning.severity === 'clash'
      ? `${warning.sharedDates.length} shared meeting${warning.sharedDates.length === 1 ? '' : 's'}, from ${fullDateLabel(warning.sharedDates[0]!)}`
      : 'possibly — this block has no start date yet, so the dates are not known';
  return `${warning.track}, ${timeLabel(warning.course.start, warning.course.end)} — ${warning.course.title} (${when}).`;
}
---

<AdminLayout title={heading} actor={actor}>
  <p><a href="/admin/courses" class="underline underline-offset-4">← All classes</a></p>
  <h1 class="mt-2 text-3xl font-semibold text-navy">{heading}</h1>
  <p class="mt-2">
    Saved here, this class appears by age, by day, in the full descriptions and on its own page.
  </p>

  {banner && <AdminBanner ok={banner.ok} message={banner.message} testId="save-banner" retry />}

  {
    confirmingDeletion && course && deletion && (
      <AdminConfirm
        heading={deletion.heading}
        action={action}
        confirmLabel={deletion.confirmLabel}
        destructive
        declineHref={action}
        declineLabel={deletion.declineLabel}
      >
        <Fragment slot="fields">
          <input type="hidden" name="delete" value="1" />
        </Fragment>

        <p class="mt-3" data-testid="deletion-goes">
          {deletion.goes}
        </p>
        <p class="mt-3" data-testid="deletion-applied">
          {deletion.applied}
        </p>
        <p class="mt-3" data-testid="deletion-undo">
          {deletion.undo}
        </p>
      </AdminConfirm>
    )
  }

  {
    !confirmingDeletion && view.warnings.length > 0 && (
      <div
        role="status"
        data-testid="clash-warnings"
        class="mt-6 border-l-4 border-gold bg-parchment px-4 py-3"
      >
        <p class="font-semibold">This class shares a time with another.</p>
        <p class="mt-1 text-sm">
          Not a mistake by itself — the school runs several electives in one slot on purpose. It is
          here so a family is never the one to find it.
        </p>
        <ul class="mt-2 flex flex-col gap-1">
          {view.warnings.map((warning) => (
            <li>{warningLine(warning)}</li>
          ))}
        </ul>
      </div>
    )
  }

  {
    /*
      The form, and the two sections under it, are gone while the confirmation
      is up — as they are on the policy editor, and for the same reason: the
      screen is asking one question, and a Save button beside it is a second
      thing to press about a class that is about to stop existing.
    */
    !confirmingDeletion && (
      <form method="post" action={action} class="mt-8 flex flex-col gap-6">
    {
      FIELDS.map((field) => (
        <AdminField
          name={field.name}
          type={field.type}
          label={LABELS[field.name]}
          value={values[field.name]}
          hint={field.hint}
          error={errors[field.name]}
          optional={field.optional}
          rows={field.rows}
          min={field.min}
          step={field.step}
        />
      ))
    }

    <AdminField
      name="stages"
      type="checkboxes"
      label={LABELS.stages}
      hint="Which classical stages this class is filed under. A class may sit in two."
      options={STAGES.map((stage) => ({ value: stage, label: stage }))}
      selected={values.stages}
      error={errors.stages}
    />

    <AdminField
      name="days"
      type="checkboxes"
      label={LABELS.days}
      options={offeredDays.map((track: DayTrack) => ({ value: track, label: track }))}
      selected={values.days}
      error={errors.days}
    >
      <Fragment slot="hint">
        The days the school meets this year, from the <a
          href="/admin/school-year"
          class="underline underline-offset-4">School year</a
        > screen. A day missing from this list is a day the school gives no term.
      </Fragment>
    </AdminField>

    <div class="flex flex-col gap-2">
      <AdminField
        name="time"
        type="select"
        label={LABELS.time}
        hint="The times the school already meets at. Pick “Another time” to type a slot the timetable does not run yet."
        placeholder="Not picked yet"
        options={timeChoices}
        value={selectedTime}
        error={errors.time}
        optional
      />

      {
        /*
          The two ends of a slot the timetable does not run yet.

          `optional` here — and on most selects on this screen — is the HTML
          sense of the word rather than the school's: the parser refuses a blank
          time or rate as firmly as it refuses a blank title. The instructor is
          the one that means both (#257) — a class may be scheduled before it is
          staffed. What `optional` says is that the *browser* must not stop the
          form, because whether
          these two are wanted depends on the answer above them, and a form
          refused before it is posted is a form the parser never gets to explain.
        */
      }
      <div class="mt-2 flex flex-wrap gap-6">
        <AdminField
          name="start"
          type="time"
          label={LABELS.start}
          value={values.start}
          error={errors.start}
          optional
        />
        <AdminField
          name="end"
          type="time"
          label={LABELS.end}
          value={values.end}
          error={errors.end}
          optional
        />
      </div>
      <p class="text-sm">These two are read only when “Another time” is picked above.</p>
    </div>

    <AdminField
      name="enrolment"
      type="radios"
      label={LABELS.enrolment}
      hint="The shape of the course itself — how long it runs for."
      options={unitOptions}
      selected={[values.enrolment]}
      error={errors.enrolment}
    />

    <AdminField
      name="enrolmentUnits"
      type="checkboxes"
      label={LABELS.enrolmentUnits}
      hint="What a family may actually buy. This is exactly what the application offers them — never worked out from the shape above, because a class can publish a semester price without offering a semester."
      options={unitOptions}
      selected={values.enrolmentUnits}
      error={errors.enrolmentUnits}
    />

    <AdminField
      name="weeks"
      type="number"
      label={LABELS.weeks}
      hint="Meeting weeks per day track. The price is worked out from this, the meeting length and the rate below."
      value={values.weeks}
      error={errors.weeks}
      min={1}
      step={1}
    />

    <div class="flex flex-col gap-2">
      {
        /*
          One track's dates and no others (#61). Every date outside the ticked
          track is an option that cannot be right — `blockMeetingDates` refuses
          it on submit, which is a correct message one save too late.
        */
      }
      <AdminField
        name="blockStart"
        type="select"
        label={LABELS.blockStart}
        hint={view.blockTrack
          ? `The ${view.blockTrack} track’s own meeting dates — so a block cannot begin on a day the school does not meet. The end date is worked out from the weeks.`
          : 'Blocks only, and empty until the form names exactly one day. Choose Block above and tick the one day it meets on — that track’s real meeting dates are the ones offered here.'}
        placeholder="Not picked yet"
        options={view.blockMeetings.map((meeting) => ({
          value: meeting.date,
          label: `${fullDateLabel(meeting.date)} — week ${meeting.week}`,
        }))}
        value={values.blockStart}
        error={blockStartError}
        optional
      />
      {
        blockEnd && (
          <p class="text-sm" data-testid="block-end">
            Ends {blockEnd}.
          </p>
        )
      }
    </div>

    <AdminField
      name="rateTier"
      type="select"
      label={LABELS.rateTier}
      hint="Which hourly rate this class is charged at."
      placeholder="Not picked yet"
      options={RATE_TIERS.map((tier) => ({ value: tier, label: RATE_LABELS[tier] }))}
      value={values.rateTier}
      error={errors.rateTier}
      optional
    />

    <AdminField
      name="instructorSlug"
      type="select"
      label={LABELS.instructorSlug}
      placeholder="Nobody yet"
      options={people.map((person) => ({
        value: person.slug,
        label: person.retiredAt ? `${person.name} — retired` : person.name,
      }))}
      value={values.instructorSlug}
      error={errors.instructorSlug}
      optional
    >
      <Fragment slot="hint">
        From the <a href="/admin/people" class="underline underline-offset-4">people list</a> — never
        a typed name, so correcting a name corrects it here too. Leave it unset for a class you mean
        to run and have not staffed: no page invents a name for it, and the Classes list says one is
        wanted. Somebody retired is only here because this class still names them, and while the
        school runs it no page prints their name — pick who is taking it over.
      </Fragment>
    </AdminField>

    {
      /*
        The price, and no way to type it. Contact hours × the rate from the
        Money screen, worked out on every save — which is why this is a
        paragraph and not an input.
      */
    }
    <div class="border-t border-navy/15 pt-6">
      <h2 class="text-xl font-semibold text-navy">Cost</h2>
      {
        course ? (
          <p class="mt-2" data-testid="computed-price">
            {priceLine(course, settings.rates)} — {contactHours(course)} contact hours.
          </p>
        ) : (
          <p class="mt-2" data-testid="computed-price">
            Worked out on save, from the meeting time, the weeks and the rate. There is nothing to
            type.
          </p>
        )
      }
      <p class="mt-2 text-sm">
        The rates themselves are on the <a href="/admin/money" class="underline underline-offset-4"
          >Money</a
        > screen. Changing one there changes every class that uses it.
      </p>
    </div>

    <AdminButton class="self-start">Save</AdminButton>
      </form>
    )
  }

  {
    /*
      Retire, outside the form above because a form cannot hold another one —
      and the separation is honest anyway: this button writes one column and
      the Save button writes the row.

      One press, no confirmation. Nothing is lost, the class keeps its address,
      and the way back is the same button saying the opposite (#263).
    */
    course && !confirmingDeletion && (
      <section class="mt-10 border-t border-navy/15 pt-6" data-testid="retirement">
        <h2 class="text-xl font-semibold text-navy">
          {course.retiredAt ? 'Retired' : 'Running'}
        </h2>
        <p class="mt-2">
          {course.retiredAt
            ? `Retired ${formatDay(course.retiredAt)}. It is off the class lists, off the timetable and not offered on the application — and it still answers at its own address, saying the school is not currently running it. Bringing it back puts it on every list it left, with nothing retyped.`
            : 'The school is running this class, so it is by age, by day, in the full descriptions and on the application. Retiring takes it off all four and leaves its page up, saying the school is not currently running it. Nothing is lost and it is one press back.'}
        </p>
        <form method="post" action={action} class="mt-3">
          <input
            type="hidden"
            name="retire"
            value={course.retiredAt ? RETIRE_VALUES.unretire : RETIRE_VALUES.retire}
          />
          <AdminButton
            variant={course.retiredAt ? 'primary' : 'secondary'}
            pendingLabel={course.retiredAt ? 'Bringing it back…' : 'Retiring…'}
            testId="retire"
          >
            {course.retiredAt ? 'Bring it back' : 'Retire'}
          </AdminButton>
        </form>
      </section>
    )
  }

  {
    stamp && deletion && !confirmingDeletion && (
      <AdminPublishing stamp={stamp}>
        <p class="mt-2">
          Saving republishes the whole site, because a class is on four surfaces at once.
        </p>

        <form method="post" action={action} class="mt-6">
          <p class="text-sm" data-testid="delete-blurb">
            Never running this class, or typed in by mistake? {deletion.goes} {deletion.applied}{' '}
            {deletion.undo} You will be asked to confirm first.
          </p>
          <AdminButton variant="destructive" name="delete" value="1" class="mt-3" testId="delete">
            Delete this class
          </AdminButton>
        </form>
      </AdminPublishing>
    )
  }
</AdminLayout>
