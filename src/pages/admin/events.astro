---
export const prerender = false;

import AdminBanner from '../../components/AdminBanner.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { formatStamp } from '../../lib/admin/formatting.js';
import { removalOutcome } from '../../lib/admin/republish-outcome.js';
import { eventDateLabel, eventTimeLabel } from '../../lib/calendar/event.js';
import { listEvents, listSyncedEvents } from '../../lib/calendar/store.js';
import { CALENDAR_PATH } from '../../lib/calendar/views.js';
import { schoolWallClock } from '../../lib/calendar/year.js';
import { getDb } from '../../lib/db/client.js';

/**
 * The Events screen — the school's one-offs, and nothing else (#23).
 *
 * Separate from School Year on purpose. Term dates are a computation over eight
 * numbers; an open house is a thing that happens once, at a place, sometimes at
 * a time. One screen holding both would mean either an event carrying a week
 * number that means nothing or a meeting date carrying a place that never
 * varies.
 *
 * A list, like Announcements: every edit happens on the event's own screen.
 *
 * **The school's Google calendar is shown here and cannot be edited here**
 * (#153). Those events are on the calendar page beside these ones, so a screen
 * that did not mention them would leave Jill looking at a public page carrying
 * events her own list does not have. What it does not offer is a form: editing
 * a copy the next sync overwrites is a control that loses, and the place to
 * change one is Google.
 */
const db = await getDb();
const actor = Astro.locals.actor!;
const events = await listEvents(db);
const synced = await listSyncedEvents(db);
/*
 * When the calendar was last read, which is the same for every row the last run
 * confirmed. Not a stamp: nobody signed in to run a sync, so there is no actor
 * to name, and this says so in the words it uses.
 */
const lastRead = synced.reduce<Date | null>(
  (latest, row) => (latest === null || row.syncedAt > latest ? row.syncedAt : latest),
  null,
);
/**
 * What a removal that redirected here has to say for itself (#200). Nothing
 * else on this screen acts, so this is the only banner it can carry.
 */
const banner = removalOutcome(
  Astro.url.searchParams.get('removed'),
  Astro.url.searchParams.get('republished'),
  'calendar',
);
---

<AdminLayout title="Events" actor={actor}>
  <h1 class="text-3xl font-semibold text-navy">Events</h1>
  <p class="mt-2">
    Open houses, concerts, picture days — anything that happens once. They appear on <a
      href={CALENDAR_PATH}
      class="underline underline-offset-4">the calendar</a
    > and in the file parents subscribe to. Class dates are not here; they are computed on <a
      href="/admin/school-year"
      class="underline underline-offset-4">School year</a
    >.
  </p>

  {banner && <AdminBanner ok={banner.ok} message={banner.message} testId="events-banner" retry />}

  <p class="mt-8">
    <a
      href="/admin/events/new"
      class="rounded bg-navy px-5 py-2.5 font-semibold text-cream hover:bg-navy-deep"
    >
      Add an event
    </a>
  </p>

  {
    events.length === 0 ? (
      <p class="mt-8">
        Nothing on the calendar beyond the class dates. That is an ordinary year — the calendar
        page says so rather than showing an empty list.
      </p>
    ) : (
      <ul class="mt-8 flex flex-col gap-6">
        {events.map((event) => (
          <li class="border-t border-navy/15 pt-6">
            <h2 class="text-xl font-semibold text-navy">
              <a href={`/admin/events/${event.slug}`} class="underline underline-offset-4">
                {event.title}
              </a>
            </h2>
            <p class="mt-1 text-sm">
              {eventDateLabel(event.heldOn)}
              {event.startTime ? ` · ${eventTimeLabel(event.startTime)}` : ' · All day'}
              {event.place ? ` · ${event.place}` : ''}
            </p>
            <p class="mt-1 text-sm" data-testid={`stamp-${event.slug}`}>
              {formatStamp(event.lastEditedBy, event.lastEditedAt)}
            </p>
          </li>
        ))}
      </ul>
    )
  }

  {
    synced.length > 0 && (
      <section class="mt-14" data-section="synced-events">
        <h2 class="text-2xl font-semibold text-navy">From the School’s Google Calendar</h2>
        <p class="mt-2">
          These are on <a href={CALENDAR_PATH} class="underline underline-offset-4">
            the calendar
          </a>{' '}
          too, and in the file parents subscribe to. They are read from the school’s own Google
          calendar once a night, so <strong>change them in Google</strong> — an edit made here
          would be overwritten by the next reading.
        </p>
        <p class="mt-1 text-sm">
          {lastRead
            ? `Last read on ${eventDateLabel(schoolWallClock(lastRead).date)}`
            : 'Not read yet'}
        </p>

        <ul class="mt-8 flex flex-col gap-6">
          {synced.map((event) => (
            <li class="border-t border-navy/15 pt-6">
              <h3 class="text-xl font-semibold text-navy">{event.title}</h3>
              <p class="mt-1 text-sm">
                {eventDateLabel(event.heldOn)}
                {event.startTime ? ` · ${eventTimeLabel(event.startTime)}` : ' · All day'}
                {event.place ? ` · ${event.place}` : ''}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</AdminLayout>
