---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { formatStamp } from '../../lib/admin/school-details.js';
import { eventDateLabel, eventTimeLabel } from '../../lib/calendar/event.js';
import { listEvents } from '../../lib/calendar/store.js';
import { CALENDAR_PATH } from '../../lib/calendar/views.js';
import { getDb } from '../../lib/db/client.js';

/**
 * The Events screen — the school's one-offs, and nothing else (#23).
 *
 * Separate from School Year on purpose. Term dates are a computation over eight
 * numbers; an open house is a thing that happens once, at a place, sometimes at
 * a time. One screen holding both would mean either an event carrying a week
 * number that means nothing or a meeting date carrying a place that never
 * varies.
 *
 * A list, like Announcements: every edit happens on the event's own screen.
 */
const db = await getDb();
const actor = Astro.locals.actor!;
const events = await listEvents(db);
---

<AdminLayout title="Events" actor={actor}>
  <h1 class="text-3xl font-semibold text-navy">Events</h1>
  <p class="mt-2">
    Open houses, concerts, picture days — anything that happens once. They appear on <a
      href={CALENDAR_PATH}
      class="underline underline-offset-4">the calendar</a
    > and in the file parents subscribe to. Class dates are not here; they are computed on <a
      href="/admin/school-year"
      class="underline underline-offset-4">School year</a
    >.
  </p>

  <p class="mt-8">
    <a
      href="/admin/events/new"
      class="rounded bg-navy px-5 py-2.5 font-semibold text-cream hover:bg-deep-blue"
    >
      Add an event
    </a>
  </p>

  {
    events.length === 0 ? (
      <p class="mt-8">
        Nothing on the calendar beyond the class dates. That is an ordinary year — the calendar
        page says so rather than showing an empty list.
      </p>
    ) : (
      <ul class="mt-8 flex flex-col gap-6">
        {events.map((event) => (
          <li class="border-t border-navy/15 pt-6">
            <h2 class="text-xl font-semibold text-navy">
              <a href={`/admin/events/${event.slug}`} class="underline underline-offset-4">
                {event.title}
              </a>
            </h2>
            <p class="mt-1 text-sm">
              {eventDateLabel(event.heldOn)}
              {event.startTime ? ` · ${eventTimeLabel(event.startTime)}` : ' · All day'}
              {event.place ? ` · ${event.place}` : ''}
            </p>
            <p class="mt-1 text-sm" data-testid={`stamp-${event.slug}`}>
              {formatStamp(event.lastEditedBy, event.lastEditedAt)}
            </p>
          </li>
        ))}
      </ul>
    )
  }
</AdminLayout>
