---
export const prerender = false;

import AdminBanner from '../../../components/AdminBanner.astro';
import AdminButton from '../../../components/AdminButton.astro';
import AdminConfirm from '../../../components/AdminConfirm.astro';
import AdminField from '../../../components/AdminField.astro';
import AdminPublishing from '../../../components/AdminPublishing.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import type { Banner } from '../../../lib/admin/banner.js';
import { isConfirmed } from '../../../lib/admin/confirmation.js';
import {
  EMPTY,
  LABELS,
  parseEvent,
  type EventErrors,
  type EventFields,
} from '../../../lib/admin/calendar-events.js';
import { isrBypassToken } from '../../../lib/admin/isr-token.js';
import { saveErrorMessage } from '../../../lib/admin/save-errors.js';
import {
  describeRevalidation,
  revalidateAll,
  revalidationOrigin,
} from '../../../lib/admin/revalidate.js';
import { formatStamp } from '../../../lib/admin/formatting.js';
import { republishOutcome } from '../../../lib/admin/republish-outcome.js';
import {
  eventDateLabel,
  eventSlug,
  eventTimeLabel,
  TIMED_EVENT_MINUTES,
  type CalendarEvent,
} from '../../../lib/calendar/event.js';
import { createEvent, deleteEvent, getEvent, saveEvent } from '../../../lib/calendar/store.js';
import { getDb } from '../../../lib/db/client.js';

/**
 * One event, added, edited or taken off the calendar (#23).
 *
 * `/admin/events/new` is the add form and every other slug is that event's edit
 * form — one screen, as People and Announcements are, because the fields and
 * the publishing story are identical and a second nearly-identical page is how
 * the two drift.
 *
 * **This was the one screen with a delete**, and the reason was the feed: a
 * cancelled concert left on a subscribed calendar is a family driving to a
 * school that is dark. It is not the only one any more — the school's own
 * content is freely removable (ADR-0021), and a policy and an announcement are
 * each deleted from their own screen the same way — so the two sentences here
 * that said nothing else in the admin deletes anything are gone with the
 * decision that made them false.
 *
 * It **confirms first** (#200), the way every delete in this admin now does and
 * the way Money confirms: the first press replaces the form with a screen
 * naming the event
 * and its date and saying again what a subscribed phone will do, and only the
 * second press — the same form plus `confirm` — removes it.
 *
 * The field, button, banner and Publishing markup this screen used to spell out
 * for itself now comes from the shared components (#194). Publishing brings its
 * Republish button with it — this screen had grown one without, which was drift
 * rather than a decision; the removal form stays in the section's slot, where it
 * already was.
 */
const NEW = 'new';

/**
 * The one refusal that actually happens here: the same event entered twice on
 * the same day, which is a second hand adding what a first hand already did.
 */
const SAVE_ERROR = {
  duplicate: 'there is already an event with that name on that day. Edit that one instead.',
} as const;

const db = await getDb();
const actor = Astro.locals.actor!;

const routeSlug = Astro.params.slug ?? '';
const adding = routeSlug === NEW;

let event: CalendarEvent | undefined = adding ? undefined : await getEvent(db, routeSlug);
if (!adding && !event) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

let values: EventFields = event ? fieldsOf(event) : EMPTY;
let errors: EventErrors = {};
let banner: Banner | null = republishOutcome(Astro.url.searchParams.get('republished'));
/** True only on the confirmation screen, which replaces the form. */
let confirmingRemoval = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  const removing = form.get('remove') !== null && event !== undefined;

  if (removing && !isConfirmed(form)) {
    // The first press asks. Nothing is written and nothing is parsed: the
    // removal form carries no fields, so parsing it would refuse an event the
    // reader has not asked to edit.
    confirmingRemoval = true;
  } else if (removing && event) {
    const removed = event.title;
    await deleteEvent(db, event.slug);
    const result = await revalidateAll({
      origin: revalidationOrigin(Astro.url),
      bypassToken: isrBypassToken(),
    });
    /*
     * The answer travels in the query string, the way a republish's does
     * (#198): this screen no longer exists to show it on, and the list is
     * where the removal is visible. In the URL rather than rendered here so a
     * refresh of the list repeats nothing.
     */
    const back = new URL('/admin/events', Astro.url.origin);
    back.searchParams.set('removed', removed);
    back.searchParams.set('republished', result.ok ? 'live' : 'stale');
    return Astro.redirect(`${back.pathname}${back.search}`, 303);
  } else {
    const parsed = parseEvent(form);
    values = parsed.values;
    errors = parsed.errors;

    if (Object.keys(errors).length > 0) {
      banner = { ok: false, message: 'Nothing was saved — the fields below need fixing first.' };
    } else {
      try {
        event = event
          ? await saveEvent(db, event.slug, parsed.edit, actor.name)
          : await createEvent(
              db,
              eventSlug(parsed.edit.heldOn, parsed.edit.title),
              parsed.edit,
              actor.name,
            );
        values = fieldsOf(event);
        const result = await revalidateAll({
          origin: revalidationOrigin(Astro.url),
          bypassToken: isrBypassToken(),
        });
        banner = { ok: result.ok, message: describeRevalidation(result) };
      } catch (error) {
        banner = { ok: false, message: saveErrorMessage(error, SAVE_ERROR) };
      }
    }
  }
}

/*
 * After an add succeeds this becomes that event's own screen, so a second Save
 * updates the row just created rather than inserting it again — the same trade
 * People makes, and for the same reason: showing the revalidation answer beats
 * throwing it away in a redirect.
 */
const action = event ? `/admin/events/${event.slug}` : '/admin/events/new';
const heading = event ? event.title : 'Add an Event';

const FIELDS: {
  name: keyof EventFields;
  type: 'text' | 'date' | 'time' | 'multiline';
  optional?: true;
  hint?: string;
}[] = [
  { name: 'heldOn', type: 'date', hint: 'The day it happens.' },
  { name: 'title', type: 'text', hint: '“Fall open house”, “Picture day”.' },
  {
    name: 'startTime',
    type: 'time',
    optional: true,
    hint: `Optional. Leave it empty and it shows as a whole day; give a time and it shows as ${
      TIMED_EVENT_MINUTES / 60
    } hour on a parent’s calendar.`,
  },
  {
    name: 'place',
    type: 'text',
    optional: true,
    hint: 'Optional. Where to turn up, if it is not the usual place.',
  },
  {
    name: 'note',
    type: 'multiline',
    optional: true,
    hint: 'Optional. Anything a family needs to know beforehand.',
  },
];

function fieldsOf(row: CalendarEvent): EventFields {
  return {
    heldOn: row.heldOn,
    title: row.title,
    startTime: row.startTime ?? '',
    place: row.place ?? '',
    note: row.note ?? '',
  };
}
---

<AdminLayout title={heading} actor={actor}>
  <p><a href="/admin/events" class="underline underline-offset-4">← All events</a></p>
  <h1 class="mt-2 text-3xl font-semibold text-navy">{heading}</h1>
  <p class="mt-2">
    Saved here, this appears on the calendar page and in the file parents subscribe to.
  </p>

  {banner && <AdminBanner ok={banner.ok} message={banner.message} testId="save-banner" retry />}

  {
    confirmingRemoval && event ? (
      <AdminConfirm
        heading="Take This Off the Calendar?"
        action={action}
        confirmLabel="Yes, take it off the calendar"
        destructive
        declineHref={action}
        declineLabel="Go back without removing it"
      >
        <Fragment slot="fields">
          <input type="hidden" name="remove" value="1" />
        </Fragment>

        <p class="mt-3">
          <strong>{event.title}</strong> is on {eventDateLabel(event.heldOn)}
          {event.startTime ? `, at ${eventTimeLabel(event.startTime)}` : ', all day'}.
        </p>
        <p class="mt-3">
          Taking it off removes it from the calendar page and from the file parents subscribe to.
          Phones that already have it drop it at their next check — usually within a few hours,
          sometimes a day or two — so a family who has written it down may turn up anyway. If it
          is close, text them as well.
        </p>
        <p class="mt-3">There is no undo. Putting it back means typing it in again.</p>
      </AdminConfirm>
    ) : (
      <form method="post" action={action} class="mt-8 flex flex-col gap-6">
        {FIELDS.map((field) => (
          <AdminField
            name={field.name}
            type={field.type}
            label={LABELS[field.name]}
            value={values[field.name]}
            hint={field.hint}
            error={errors[field.name]}
            optional={field.optional}
          />
        ))}

        <AdminButton class="self-start">Save</AdminButton>
      </form>
    )
  }

  {
    event && !confirmingRemoval && (
      <AdminPublishing stamp={formatStamp(event.lastEditedBy, event.lastEditedAt)}>
        <p class="mt-2">
          Parents’ phones check the subscribed calendar on their own schedule — usually within a
          few hours, sometimes a day or two. If this changes at short notice, text them as well.
        </p>

        <form method="post" action={action} class="mt-6">
          <p class="text-sm">
            Canceled? Take it off, and it disappears from the calendar and from every subscribed
            phone at their next check. You will be asked to confirm first.
          </p>
          <AdminButton variant="destructive" name="remove" value="1" class="mt-3">
            Take this off the calendar
          </AdminButton>
        </form>
      </AdminPublishing>
    )
  }
</AdminLayout>
