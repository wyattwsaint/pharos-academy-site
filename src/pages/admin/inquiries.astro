---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { formatTimestamp } from '../../lib/admin/formatting.js';
import { telHref } from '../../lib/admin/school-details.js';
import { getDb } from '../../lib/db/client.js';
import {
  applicationLink,
  applicationLinkIsLive,
  APPLICATION_LINK_DAYS,
} from '../../lib/inquiry/inquiry.js';
import { listInquiries } from '../../lib/inquiry/store.js';
import { getMoneySettings } from '../../lib/money/store.js';

/**
 * What families have asked, newest first (#25 AC 7).
 *
 * A list and nothing else. Nothing on this screen edits an inquiry: what a
 * family typed is what they typed, and a screen that could quietly rewrite it
 * would be a screen that loses the only record of the question.
 *
 * The one thing it does beyond listing is **say when the school was not told.**
 * An inquiry that saved but whose notification was refused is the failure this
 * ticket cares most about, and it is invisible everywhere else — the parent was
 * correctly told we have their question, and only this line says nobody was
 * emailed about it.
 */
const db = await getDb();
const actor = Astro.locals.actor!;

const inquiries = await listInquiries(db);
const settings = await getMoneySettings(db);

/**
 * One clock for the whole list (#317).
 *
 * Read once rather than per row, so a page rendered across a boundary cannot
 * print a link live at the top of the list and dead at the bottom for two
 * inquiries taken in the same minute.
 */
const now = new Date();

---

<AdminLayout title="Inquiries" actor={actor}>
  <h1 class="text-3xl font-semibold text-navy">Inquiries</h1>
  <p class="mt-2">
    Every family who has asked about Pharos through the website, newest first. Each one was also
    emailed to {settings.notificationAddresses.join(' and ')} — change that list on the Money
    screen.
  </p>

  {
    inquiries.length === 0 ? (
      <p class="mt-8 border-t border-navy/15 pt-6" data-testid="no-inquiries">
        Nobody has asked yet. When somebody does, they appear here and an email goes out at the
        same moment — this screen is the record, not the notification.
      </p>
    ) : (
      <ul class="mt-8 flex flex-col gap-6">
        {inquiries.map((inquiry) => (
          <li class="border-t border-navy/15 pt-6" data-testid="inquiry">
            <h2 class="text-xl font-semibold text-navy" data-testid="inquiry-name">
              {inquiry.name}
            </h2>
            <p class="mt-1">
              <a
                href={`mailto:${inquiry.email}`}
                class="underline underline-offset-4"
                data-testid="inquiry-email"
              >
                {inquiry.email}
              </a>
            </p>
            {/*
              The number, dialable (#311). Inquiries taken before that ticket
              have none and never will — an inquiry is a record of what a
              family sent, not a row anybody edits — so the dash is the honest
              rendering rather than a gap that reads as a bug.
            */}
            <p class="mt-1" data-testid="inquiry-phone">
              Phone:{' '}
              {inquiry.phone ? (
                <a href={telHref(inquiry.phone)} class="underline underline-offset-4">
                  {inquiry.phone}
                </a>
              ) : (
                '—'
              )}
            </p>
            <p class="mt-1" data-testid="inquiry-ages">
              Children’s ages: {inquiry.ages}
            </p>
            {inquiry.message && (
              <p class="mt-2 whitespace-pre-line" data-testid="inquiry-message">
                {inquiry.message}
              </p>
            )}
            {/*
              The link Jill pastes into her reply (#31 AC 1, #313). The prefill
              is keyed on the inquiry's id, and this screen is the only place
              the id is legible — without it the ready-made application, phone
              number and all, is a feature nobody in the school can reach.
            */}
            <p class="mt-2 text-sm" data-testid="inquiry-apply-link">
              {applicationLinkIsLive(inquiry.receivedAt, now) ? (
                <>
                  Ready-filled application:{' '}
                  <a href={applicationLink(inquiry.id)} class="underline underline-offset-4">
                    {applicationLink(inquiry.id)}
                  </a>
                </>
              ) : (
                /*
                  Past the window the link is not printed at all (#317,
                  ADR-0025). Its only purpose is to be pasted, and a link that
                  will hand the family an empty form is worse than no link,
                  because it is sent believing it works and the school finds out
                  when the family says the form was blank.
                */
                `The ready-filled application link expired ${APPLICATION_LINK_DAYS} days after this inquiry came in.`
              )}
            </p>
            <p class="mt-2 text-sm">{formatTimestamp(inquiry.receivedAt)}</p>
            {inquiry.notifiedAt ? (
              <p class="mt-1 text-sm" data-testid="inquiry-delivery">
                Emailed to the school.
              </p>
            ) : (
              <p class="mt-1 text-sm font-semibold" data-testid="inquiry-delivery">
                ⚠ Nobody was emailed about this one — it is only here.
                {inquiry.notificationError && ` (${inquiry.notificationError})`}
              </p>
            )}
          </li>
        ))}
      </ul>
    )
  }

  <p class="mt-10 border-t border-navy/15 pt-6">
    There is nothing to edit and nothing to delete. What a family typed is the record of what they
    asked, and the application flow reads these rows to pre-fill itself.
  </p>
</AdminLayout>
