---
export const prerender = false;

import AdminBanner from '../../components/AdminBanner.astro';
import AdminButton from '../../components/AdminButton.astro';
import AdminField from '../../components/AdminField.astro';
import AdminPublishing from '../../components/AdminPublishing.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import type { Banner } from '../../lib/admin/banner.js';
import { isrBypassToken } from '../../lib/admin/isr-token.js';
import {
  describeRevalidation,
  revalidateAll,
  revalidationOrigin,
} from '../../lib/admin/revalidate.js';
import { formatStamp } from '../../lib/admin/formatting.js';
import { republishOutcome } from '../../lib/admin/republish-outcome.js';
import { getDb } from '../../lib/db/client.js';
import {
  CONFIRM_FIELD,
  moneyFormFields,
  moneyFormOutcome,
  type MoneyFormOutcome,
} from '../../lib/money/admin-flow.js';
import {
  INSTALMENT_COUNT,
  LABELS,
  STUDY_HALL_FEE_CONTRADICTION,
  type MoneyChange,
  type MoneyErrors,
  type MoneyField,
  type MoneySettings,
} from '../../lib/money/settings.js';
import { getMoneySettings, saveMoneySettings } from '../../lib/money/store.js';

/**
 * Every number about money the school controls, on one screen (#29).
 *
 * Two things make this screen different from the other admin forms.
 *
 * **It confirms before it saves.** A deposit is not a phone number: the figure
 * here is what every family on the site is quoted from the moment it is
 * written, so the first Save renders a confirmation naming each change, old
 * value and new, and says the words out loud. The decision is
 * `moneyFormOutcome`; this page only renders the outcome. There is no
 * JavaScript, so the confirmation is a second POST carrying the values back in
 * hidden inputs — a `confirm()` dialog would be both untestable and unavailable
 * to anyone with scripting off.
 *
 * **Permissions are flat.** Jill and George see this screen equally; #16
 * overrode the recommendation to gate it. The stamp below is therefore the only
 * control on the money, which is why saving stamps it and why an identical save
 * deliberately does not.
 *
 * What a change does *not* do is rewrite what an already-enrolled family agreed
 * to — those numbers were copied, not referenced, when they applied (ADR-0006).
 * The confirmation screen says so, because that is the reassurance that lets
 * somebody click Save at all.
 */
const db = await getDb();
const actor = Astro.locals.actor!;

let row = await getMoneySettings(db);
let values: MoneySettings = row;
let errors: MoneyErrors = {};
let banner: Banner | null = republishOutcome(Astro.url.searchParams.get('republished'));
/** Non-empty only on the confirmation screen, which replaces the form. */
let confirming: MoneyChange[] | null = null;

if (Astro.request.method === 'POST') {
  const outcome: MoneyFormOutcome = moneyFormOutcome(await Astro.request.formData(), row);
  values = outcome.values;

  switch (outcome.kind) {
    case 'invalid':
      errors = outcome.errors;
      banner = { ok: false, message: 'Nothing was saved — the fields below need fixing first.' };
      break;
    case 'unchanged':
      banner = { ok: true, message: 'Nothing changed, so nothing was saved.' };
      break;
    case 'confirm':
      confirming = outcome.changes;
      break;
    case 'save': {
      row = await saveMoneySettings(db, outcome.values, actor.name);
      values = row;
      const result = await revalidateAll({
        origin: revalidationOrigin(Astro.url),
        bypassToken: isrBypassToken(),
      });
      banner = { ok: result.ok, message: describeRevalidation(result) };
      break;
    }
  }
}

const stamp = formatStamp(row.lastEditedBy, row.lastEditedAt);

/** A dollar field: the six amounts, which all behave identically. */
type AmountField = Extract<
  MoneyField,
  | 'standardRate'
  | 'highSchoolCreditRate'
  | 'registrationFee'
  | 'classDeposit'
  | 'lateFee'
  | 'studyHallFee'
>;

const AMOUNTS: { name: AmountField; value: number; hint?: string }[] = [
  {
    name: 'standardRate',
    value: values.rates.standard,
    hint: 'Every class price on the site is contact hours × one of these two rates.',
  },
  { name: 'highSchoolCreditRate', value: values.rates.highSchoolCredit },
  { name: 'registrationFee', value: values.registrationFee, hint: 'Once per student per year.' },
  { name: 'classDeposit', value: values.classDeposit, hint: 'Per class, by check, holds the seat.' },
  { name: 'lateFee', value: values.lateFee, hint: 'Added per class when a payment misses its date.' },
  { name: 'studyHallFee', value: values.studyHallFee, hint: STUDY_HALL_FEE_CONTRADICTION },
];

/** The ordinal each instalment date is labelled with. Four, per the handbook. */
const ORDINALS = ['First', 'Second', 'Third', 'Fourth'];
---

<AdminLayout title="Money" actor={actor}>
  <h1 class="text-3xl font-semibold text-navy">Money</h1>
  <p class="mt-2">
    Every figure about money on the public site is read from this page. None of it is typed into
    the wording of a page, so a number changed here is changed everywhere at once.
  </p>

  {banner && <AdminBanner ok={banner.ok} message={banner.message} testId="save-banner" retry />}

  {
    confirming ? (
      <section class="mt-8" data-testid="confirm">
        <h2 class="text-2xl font-semibold text-navy">This affects every family.</h2>
        <p class="mt-3">
          These figures are quoted on the public site and in every application from the moment
          they are saved. Every family inquiring or applying afterwards is told the new numbers.
        </p>
        <p class="mt-3">
          Families who have already enrolled keep the terms they agreed to. Their fees were
          written down when they applied and nothing on this page rewrites them.
        </p>

        <table class="mt-6 w-full border-collapse text-left">
          <caption class="sr-only">What is about to change</caption>
          <thead>
            <tr class="border-b border-navy/25">
              <th scope="col" class="py-2 pr-4 font-semibold">What</th>
              <th scope="col" class="py-2 pr-4 font-semibold">Now</th>
              <th scope="col" class="py-2 font-semibold">After saving</th>
            </tr>
          </thead>
          <tbody>
            {confirming.map((change) => (
              <tr class="border-b border-navy/15 align-top" data-change={change.field}>
                <th scope="row" class="py-2 pr-4 font-normal">
                  {change.label}
                </th>
                <td class="py-2 pr-4">{change.from}</td>
                <td class="py-2 font-semibold">{change.to}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <div class="mt-8 flex flex-wrap gap-4">
          <form method="post">
            {/*
              The submitted values, carried back under the same field names the
              form posts them under, so the confirming post parses identically
              to the first one. Built by `moneyFormFields` rather than listed
              here: the list and `parseMoneySettings` are inverses, and a
              setting this markup forgot would silently revert on confirming.
            */}
            {moneyFormFields(values).map((field) => (
              <input type="hidden" name={field.name} value={field.value} />
            ))}
            <input type="hidden" name={CONFIRM_FIELD} value="yes" />
            <AdminButton>Yes, change it for everyone</AdminButton>
          </form>
          <AdminButton href="/admin/money" variant="secondary">
            Go back without saving
          </AdminButton>
        </div>
      </section>
    ) : (
      <form method="post" class="mt-8 flex flex-col gap-6">
        {AMOUNTS.map((field) => (
          <AdminField
            name={field.name}
            type="text"
            inputmode="numeric"
            label={LABELS[field.name]}
            hint={field.hint}
            value={Number.isFinite(field.value) ? String(field.value) : ''}
            error={errors[field.name]}
          />
        ))}

        {
          /*
            Four dates and one complaint. "Earliest first" is not a complaint
            about the third payment, so it hangs off the fieldset — where a
            screen reader announces it on entering the group — rather than
            being repeated on each box. The four post under one name, so each
            carries the row's id rather than the field's.
          */
        }
        <AdminField
          name="instalmentDates"
          type="group"
          label={LABELS.instalmentDates}
          hint={`The ${INSTALMENT_COUNT} dates a quarterly payment is due, earliest first.`}
          error={errors.instalmentDates}
        >
          <div class="flex flex-wrap gap-4">
            {Array.from({ length: INSTALMENT_COUNT }, (_, index) => (
              <AdminField
                name="instalmentDates"
                id={`instalmentDate-${index}`}
                type="date"
                label={`${ORDINALS[index]} payment`}
                value={values.instalmentDates[index] ?? ''}
                invalid={Boolean(errors.instalmentDates)}
                class="w-48"
              />
            ))}
          </div>
        </AdminField>

        <AdminField
          name="refundTerms"
          type="multiline"
          label={LABELS.refundTerms}
          hint="In the school's own words. Families are asked to agree to this."
          value={values.refundTerms}
          error={errors.refundTerms}
        />

        <AdminField
          name="depositCreditedAgainstTuition"
          type="checkbox"
          label={LABELS.depositCreditedAgainstTuition}
          checked={values.depositCreditedAgainstTuition}
          hint={`Ticked, the deposit comes off the tuition owed. Unticked, it is on top. On three classes that is a difference of $${values.classDeposit * 3} to the family.`}
        />

        <AdminField
          name="notificationAddresses"
          type="multiline"
          rows={3}
          label={LABELS.notificationAddresses}
          hint="One email address per line. More than one is normal — an application nobody is told about is an application nobody answers."
          value={values.notificationAddresses.join('\n')}
          error={errors.notificationAddresses}
        />

        <AdminButton class="self-start">Save</AdminButton>
      </form>
    )
  }

  <AdminPublishing stamp={stamp}>
    <p class="mt-2">
      Saving republishes the whole site. Use this if the site ever looks out of date anyway.
    </p>
  </AdminPublishing>
</AdminLayout>
