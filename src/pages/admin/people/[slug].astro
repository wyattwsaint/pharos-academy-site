---
export const prerender = false;

import AdminBanner from '../../../components/AdminBanner.astro';
import AdminButton from '../../../components/AdminButton.astro';
import AdminConfirm from '../../../components/AdminConfirm.astro';
import AdminField from '../../../components/AdminField.astro';
import AdminPublishing from '../../../components/AdminPublishing.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import type { Banner } from '../../../lib/admin/banner.js';
import { isConfirmed } from '../../../lib/admin/confirmation.js';
import { isrBypassToken } from '../../../lib/admin/isr-token.js';
import { saveErrorMessage } from '../../../lib/admin/save-errors.js';
import {
  LABELS,
  parsePerson,
  personDeletion,
  type PersonErrors,
  type PersonFields,
} from '../../../lib/admin/people.js';
import {
  describeRevalidation,
  revalidateAll,
  revalidationOrigin,
} from '../../../lib/admin/revalidate.js';
import { formatStamp } from '../../../lib/admin/formatting.js';
import { republishOutcome } from '../../../lib/admin/republish-outcome.js';
import { getDb } from '../../../lib/db/client.js';
import { listCoursesForAdmin } from '../../../lib/courses/store.js';
import { instructorsAmong, slugify, type Person } from '../../../lib/people/person.js';
import { createPerson, deletePerson, getPerson, savePerson } from '../../../lib/people/store.js';

/**
 * One person, edited or added (#26).
 *
 * `/admin/people/new` is the add form and every other slug is that person's
 * edit form. One screen rather than two because the fields, the validation and
 * the publishing story are identical — the only difference is whether the save
 * is an insert or an update, and a second nearly-identical page is how the two
 * drift.
 *
 * Save writes the row, stamps it, then revalidates **every** public path and
 * waits for the answer, exactly as school details does (#18 §3). A person's
 * name is printed on the staff page, on each class they teach and in the
 * timetable, so a correction that reached only one of those would be the worst
 * possible outcome: a site that disagrees with itself. What Jill is told
 * afterwards is the answer, not an assumption.
 *
 * Adding does the same. A new instructor exists to be assigned a class, and the
 * class pages are among the paths republished.
 *
 * The field, button, banner and Publishing markup this screen used to spell out
 * for itself now comes from the shared components (#194). It is the same form;
 * what changes is that the `aria-describedby` wiring is written once, where it
 * cannot rot out of one copy without the others noticing.
 */
/** The one slug that is not a person: the add form's address. */
const NEW = 'new';

/** What the add form opens on — a name, a role, and three deliberate absences. */
const EMPTY: PersonFields = {
  name: '',
  role: '',
  bio: null,
  photo: null,
  leadershipRank: null,
};

/**
 * The one refusal that actually happens here is a duplicate slug: two people
 * whose names slugify the same, which is a real thing in a school with two
 * Millers.
 */
const SAVE_ERROR = {
  duplicate: 'somebody with that name is already on the list. Edit them instead.',
} as const;

const db = await getDb();
const actor = Astro.locals.actor!;

const routeSlug = Astro.params.slug ?? '';
const adding = routeSlug === NEW;

let person = adding ? undefined : await getPerson(db, routeSlug);
if (!adding && !person) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

let values: PersonFields = person ? fieldsOf(person) : EMPTY;
let errors: PersonErrors = {};
let banner: Banner | null = republishOutcome(Astro.url.searchParams.get('republished'));
let confirmingDeletion = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const deleting = form.get('delete') !== null && person !== undefined;

  if (deleting && !isConfirmed(form)) {
    /*
     * The first press asks, and nothing is parsed on the way. The delete form
     * carries no fields, so handing it to `parsePerson` would refuse a person
     * for having an empty name the reader never touched.
     */
    confirmingDeletion = true;
  } else if (deleting && person) {
    const deleted = person.name;
    await deletePerson(db, person.slug);
    const result = await revalidateAll({
      origin: revalidationOrigin(Astro.url),
      bypassToken: isrBypassToken(),
    });
    /*
     * The answer travels in the query string, the way a republish's does
     * (#198): this screen is a 404 from here on, and the list is where the
     * deletion is visible. In the URL rather than rendered there so a refresh
     * of the list repeats nothing.
     */
    const back = new URL('/admin/people', Astro.url.origin);
    back.searchParams.set('deleted', deleted);
    back.searchParams.set('republished', result.ok ? 'live' : 'stale');
    return Astro.redirect(`${back.pathname}${back.search}`, 303);
  } else {
    const parsed = parsePerson(form);
    values = parsed.values;
    errors = parsed.errors;

    if (Object.keys(errors).length > 0) {
      banner = { ok: false, message: 'Nothing was saved — the fields below need fixing first.' };
    } else {
      try {
        person = person
          ? await savePerson(db, person.slug, values, actor.name)
          : await createPerson(db, slugFor(values.name), values, actor.name);
        values = fieldsOf(person);
        const result = await revalidateAll({
          origin: revalidationOrigin(Astro.url),
          bypassToken: isrBypassToken(),
        });
        banner = { ok: result.ok, message: describeRevalidation(result) };
      } catch (error) {
        banner = { ok: false, message: saveErrorMessage(error, SAVE_ERROR) };
      }
    }
  }
}

/*
 * After an add succeeds this screen becomes that person's edit screen: the
 * form posts to their own address from here on, so a second Save updates the
 * row just created rather than trying to insert them again. The URL stays
 * `/new` until the next navigation, which is the honest cost of showing the
 * revalidation answer instead of throwing it away in a redirect.
 */
const action = person ? `/admin/people/${person.slug}` : '/admin/people/new';
const heading = person ? person.name : 'Add a Person';
const stamp = person ? formatStamp(person.lastEditedBy, person.lastEditedAt) : null;

/*
 * What the confirmation will say, read only when it is about to be said.
 *
 * The catalogue is a second query and this screen otherwise makes none, so it
 * is asked for on the one request that needs it — the first press of Delete —
 * rather than on every edit.
 *
 * Which classes they teach comes from `instructorsAmong`, which is where
 * ADR-0004 puts that derivation and what the staff page reads. A `filter` on
 * `instructorSlug` here would be the same line written twice, and "cannot
 * drift" is only true of a question asked in one place. It answers for a list
 * of people, so it is handed the one; nobody to name comes back as no entry.
 *
 * `listCoursesForAdmin` rather than `listCourses`: an empty catalogue is a
 * broken deployment on a public page and simply nothing to name here, and a
 * confirmation that threw would leave the school unable to delete anybody on a
 * site with no classes yet.
 */
const deleting = confirmingDeletion ? person : undefined;
const deletion = deleting
  ? personDeletion(
      deleting.name,
      (instructorsAmong([deleting], await listCoursesForAdmin(db))[0]?.courses ?? []).map(
        (course) => course.title,
      ),
    )
  : null;

/**
 * The form's shape. Type decides the control; nothing else varies.
 *
 * `optional` rather than `required`, because that is the shared field's word
 * for it: most fields on the admin must be filled, and the ones that may be
 * left empty say so.
 */
const FIELDS: {
  name: keyof PersonFields;
  type: 'text' | 'multiline' | 'number';
  optional?: true;
  hint?: string;
  rows?: number;
  min?: number;
  step?: number;
}[] = [
  { name: 'name', type: 'text', hint: 'As the school writes it, honorific and all.' },
  {
    name: 'role',
    type: 'text',
    hint: '“Head of School”, “Instructor” — what this person does here.',
  },
  {
    name: 'bio',
    type: 'multiline',
    optional: true,
    rows: 8,
    hint: 'Optional. Leave it empty until the school has written one — the staff page looks right without it.',
  },
  {
    name: 'photo',
    type: 'text',
    optional: true,
    hint: 'Optional, and only a real photograph of this person, uploaded with the site’s images: “/people/their-name.webp”.',
  },
  {
    name: 'leadershipRank',
    type: 'number',
    optional: true,
    min: 1,
    step: 1,
    hint: 'Their place in the Leadership section, 1 first. Leave it empty for everybody else.',
  },
];

function fieldsOf(row: Person): PersonFields {
  return {
    name: row.name,
    role: row.role,
    bio: row.bio,
    photo: row.photo,
    leadershipRank: row.leadershipRank,
  };
}

/**
 * The address of somebody just hired.
 *
 * Derived from the name rather than typed, because a slug is a URL and nobody
 * should have to think about URLs to add a member of staff. Two names are
 * refused rather than stored: one that slugifies to nothing — punctuation only
 * — because it has no page to be reached at, and one that slugifies to `new`,
 * because this screen's own address is `/admin/people/new` and that person
 * would be permanently hidden behind the add form.
 */
function slugFor(name: string): string {
  const slug = slugify(name);
  if (!slug) throw new Error('that name has no letters or numbers in it.');
  if (slug === NEW) {
    throw new Error('“New” is the address of this form — give that person a fuller name.');
  }
  return slug;
}

---

<AdminLayout title={heading} actor={actor}>
  <p><a href="/admin/people" class="underline underline-offset-4">← All people</a></p>
  <h1 class="mt-2 text-3xl font-semibold text-navy">{heading}</h1>
  <p class="mt-2">
    Saved here, this name appears on the staff page and on every class this person teaches.
  </p>

  {banner && <AdminBanner ok={banner.ok} message={banner.message} testId="save-banner" retry />}

  {
    confirmingDeletion && person && deletion ? (
      <AdminConfirm
        heading={deletion.heading}
        action={action}
        confirmLabel={deletion.confirmLabel}
        destructive
        declineHref={action}
        declineLabel={deletion.declineLabel}
      >
        <Fragment slot="fields">
          <input type="hidden" name="delete" value="1" />
        </Fragment>

        <p class="mt-3" data-testid="deletion-goes">
          {deletion.goes}
        </p>
        <p class="mt-3" data-testid="deletion-classes">
          {deletion.classes}
        </p>
        <p class="mt-3" data-testid="deletion-undo">
          {deletion.undo}
        </p>
      </AdminConfirm>
    ) : (
      <form method="post" action={action} class="mt-8 flex flex-col gap-6">
        {FIELDS.map((field) => (
          <AdminField
            name={field.name}
            type={field.type}
            label={LABELS[field.name]}
            value={String(values[field.name] ?? '')}
            hint={field.hint}
            error={errors[field.name]}
            optional={field.optional}
            rows={field.rows}
            min={field.min}
            step={field.step}
          />
        ))}

        <AdminButton class="self-start">Save</AdminButton>
      </form>
    )
  }

  {
    stamp && !confirmingDeletion && (
      <AdminPublishing stamp={stamp}>
        <p class="mt-2">
          Saving republishes the whole site, because this name is printed in more than one place.
        </p>

        <form method="post" action={action} class="mt-6">
          <p class="text-sm">
            Somebody typed in twice, or who has left? Delete them, and they come off the staff page
            and out of this admin. Any class they teach keeps running and is left waiting for an
            instructor — you will be told which ones, and asked to confirm, first.
          </p>
          <AdminButton variant="destructive" name="delete" value="1" class="mt-3">
            Delete this person
          </AdminButton>
        </form>
      </AdminPublishing>
    )
  }
</AdminLayout>
