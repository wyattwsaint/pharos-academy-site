---
export const prerender = false;

import AdminBanner from '../../components/AdminBanner.astro';
import AdminButton from '../../components/AdminButton.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { formatStamp } from '../../lib/admin/formatting.js';
import { policyDeletionOutcome } from '../../lib/admin/republish-outcome.js';
import { getDb } from '../../lib/db/client.js';
import { listPolicies } from '../../lib/policies/store.js';
import { updatedOnLabel } from '../../lib/policies/views.js';
import { POLICIES_PATH } from '../../lib/policies/views.js';

/**
 * The school's policy documents (#28).
 *
 * A list and nothing else; every edit and every upload happens on the policy's
 * own screen. What this screen adds is telling Jill which rows are actually on
 * the public page — a policy created here has no document until one is
 * uploaded, and until then it is deliberately not listed for parents. Without
 * that sentence she would create one, not see it, and reasonably conclude the
 * admin was broken.
 *
 * **The delete lands here** (#260). It happens on the policy's own screen,
 * which stops existing the moment it succeeds, so the outcome travels in the
 * query string and is said on this list — what went, and whether the live site
 * caught up. This screen used to say a policy's address was on printed
 * handbooks and so nothing here could ever be deleted; the addresses that are
 * on paper are the versioned ones, every one of them survives the delete, and
 * that sentence was protecting the wrong thing (ADR-0021).
 */
const db = await getDb();
const actor = Astro.locals.actor!;

const policies = await listPolicies(db);
const awaiting = policies.filter((policy) => policy.version === null).length;
/** What a delete that redirected here has to say for itself. */
const banner = policyDeletionOutcome(
  Astro.url.searchParams.get('deleted'),
  Astro.url.searchParams.get('republished'),
);
---

<AdminLayout title="Policies" actor={actor}>
  <h1 class="text-3xl font-semibold text-navy">Policies</h1>
  <p class="mt-2">
    The documents families read and sign. Everything here with a document behind it is on the <a
      href={POLICIES_PATH}
      class="underline underline-offset-4">policies page</a
    >, in the order below.
  </p>

  {banner && <AdminBanner ok={banner.ok} message={banner.message} testId="policies-banner" retry />}

  {
    policies.length > 0 && (
      <p class="mt-4" data-testid="awaiting-count">
        {awaiting === 0
          ? 'Every policy here has a document and is on the policies page.'
          : `${awaiting} of these has no document yet, so it is not on the policies page. Upload one and it appears.`}
      </p>
    )
  }

  <p class="mt-8">
    <AdminButton href="/admin/policies/new">Add a policy</AdminButton>
  </p>

  {
    policies.length === 0 ? (
      <p class="mt-8 border-t border-navy/15 pt-6" data-testid="no-policies">
        No policies yet, so the policies page has nothing for a family to read or sign. That is a
        real answer for a school between years — this list is allowed to be empty. Every document
        ever uploaded here is still readable at the address it was given, so no link anybody was
        sent has stopped working.
      </p>
    ) : (
      <ul class="mt-8 flex flex-col gap-6">
        {policies.map((policy) => (
          <li class="border-t border-navy/15 pt-6">
            <h2 class="text-xl font-semibold text-navy">
              <a href={`/admin/policies/${policy.slug}`} class="underline underline-offset-4">
                {policy.position}. {policy.title}
              </a>
            </h2>
            <p class="mt-1 text-sm" data-testid={`state-${policy.slug}`}>
              {policy.updatedAt
                ? `Updated ${updatedOnLabel(policy.updatedAt)} · version ${policy.version}`
                : 'No document yet — not on the policies page'}
              {' · '}
              {policy.signed ? 'Parents sign this' : 'Not signed'}
            </p>
            <p class="mt-1 text-sm" data-testid={`stamp-${policy.slug}`}>
              {formatStamp(policy.lastEditedBy, policy.lastEditedAt)}
            </p>
          </li>
        ))}
      </ul>
    )
  }

  <p class="mt-10 border-t border-navy/15 pt-6">
    A policy’s web address never changes. Uploading a replacement puts the new document at the same
    address, so a link in an email or a printed handbook keeps working — and the version it replaced
    is kept. Deleting a policy, on its own screen, takes the policy off the site and keeps every
    document it ever had, so what a family has already agreed to still opens.
  </p>
</AdminLayout>
