---
export const prerender = false;

import AdminBanner from '../../../components/AdminBanner.astro';
import AdminButton from '../../../components/AdminButton.astro';
import AdminConfirm from '../../../components/AdminConfirm.astro';
import AdminPublishing from '../../../components/AdminPublishing.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import type { Banner } from '../../../lib/admin/banner.js';
import { isConfirmed } from '../../../lib/admin/confirmation.js';
import { isrBypassToken } from '../../../lib/admin/isr-token.js';
import { saveErrorMessage } from '../../../lib/admin/save-errors.js';
import {
  LABELS,
  parsePolicy,
  parsePolicyDraft,
  policyDeletion,
  positionNumber,
  type PolicyErrors,
  type PolicyFields,
} from '../../../lib/admin/policies.js';
import {
  describeRevalidation,
  revalidateAll,
  revalidationOrigin,
} from '../../../lib/admin/revalidate.js';
import { formatStamp } from '../../../lib/admin/formatting.js';
import { republishOutcome } from '../../../lib/admin/republish-outcome.js';
import { getDb } from '../../../lib/db/client.js';
import { policySlug, type Policy, type PolicyVersion } from '../../../lib/policies/policy.js';
import {
  createPolicy,
  deletePolicy,
  getPolicy,
  listPolicies,
  listPolicyVersions,
  replacePolicyFile,
  savePolicy,
} from '../../../lib/policies/store.js';
import {
  fileSizeLabel,
  policyPath,
  policyVersionPath,
  updatedOnLabel,
} from '../../../lib/policies/views.js';

/**
 * One policy — created, corrected, and replaced (#28).
 *
 * `/admin/policies/new` is the create form and every other slug is that
 * policy's own screen, one page rather than two as announcements and people
 * are. **The two states are not the same form**, and that is the ticket's one
 * genuinely unusual requirement: creating a policy asks three questions and
 * offers no description field and no file input, because this is the one screen
 * in the admin where a client can create a structurally wrong *thing* rather
 * than merely a wrong value. A fifth document on the parent path is a mistake
 * that cannot be fully undone — the address is permanent by design.
 *
 * After creation the same screen becomes the ordinary edit screen, where
 * everything is a value and every mistake is correctable.
 *
 * **Uploading is what stamps the date.** There is no date control anywhere on
 * this page. A replacement lands at the policy's existing address with no
 * redirect, and the version it replaced keeps its own address forever.
 *
 * **The policy can be deleted; its documents cannot** (#260, ADR-0021). The
 * paragraph above used to end by saying the address was permanent and that was
 * why there was no way back — half right. The versioned addresses are the ones
 * on paper and in a family's record, and they survive this; the row does not
 * have to. So the screen grows a delete, and it confirms first the way every
 * destructive action here does: the first press replaces the form with a screen
 * naming what goes *and what is kept*, and only the second press — the same
 * form plus `confirm` — deletes. Confirming republishes and leaves for the list,
 * because this screen is what has just stopped existing.
 */
const NEW = 'new';

/**
 * The one refusal that actually happens here is a second policy with a title
 * that slugs to the same address as an existing one — which is not a new
 * document, it is the old one under a near-identical name.
 */
const CREATE_ERROR = {
  duplicate: 'there is already a policy at that address. Edit that one instead.',
  verb: 'created',
} as const;

const db = await getDb();
const actor = Astro.locals.actor!;

const routeSlug = Astro.params.slug ?? '';
const adding = routeSlug === NEW;

let policy = adding ? undefined : await getPolicy(db, routeSlug);
if (!adding && !policy) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

/** What the create form opens on: nothing typed, and the end of the list. */
const EMPTY: PolicyFields = {
  title: '',
  description: '',
  position: String((await listPolicies(db)).length + 1),
  signed: false,
};

let values: PolicyFields = policy ? fieldsOf(policy) : EMPTY;
let errors: PolicyErrors = {};
let banner: Banner | null = republishOutcome(Astro.url.searchParams.get('republished'));
/** True only on the confirmation screen, which replaces the form. */
let confirmingDeletion = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  const deleting = form.get('delete') !== null && policy !== undefined;

  if (deleting && !isConfirmed(form)) {
    /*
     * The first press asks, and nothing is parsed on the way. The delete form
     * carries no fields, so handing it to `parsePolicy` would refuse a policy
     * for having an empty title the reader never touched.
     */
    confirmingDeletion = true;
  } else if (deleting && policy) {
    const deleted = policy.title;
    await deletePolicy(db, policy.slug);
    const result = await revalidateAll({
      origin: revalidationOrigin(Astro.url),
      bypassToken: isrBypassToken(),
    });
    /*
     * The answer travels in the query string, the way a republish's does
     * (#198): this screen is a 404 from here on, and the list is where the
     * deletion is visible. In the URL rather than rendered there so a refresh
     * of the list repeats nothing.
     */
    const back = new URL('/admin/policies', Astro.url.origin);
    back.searchParams.set('deleted', deleted);
    back.searchParams.set('republished', result.ok ? 'live' : 'stale');
    return Astro.redirect(`${back.pathname}${back.search}`, 303);
  } else if (policy) {
    const parsed = await parsePolicy(form);
    values = parsed.values;
    errors = parsed.errors;

    if (Object.keys(errors).length > 0) {
      banner = { ok: false, message: 'Nothing was saved — the fields below need fixing first.' };
    } else {
      /*
       * The upload is a second write rather than part of the first, so that the
       * version number and the stamped date come from the moment the bytes
       * arrived and nothing else can supply them.
       *
       * Which means a save can half-succeed, and the banner has to say so
       * rather than say "nothing was saved" over fields that are now in the
       * database. What the screen reports after a save is the truth about the
       * live site (#18 §3) — including the awkward truths.
       */
      let fieldsSaved = false;
      try {
        const edit = {
          title: values.title,
          description: values.description,
          position: positionNumber(values.position),
          signed: values.signed,
        };
        policy = await savePolicy(db, policy.slug, edit, actor.name);
        fieldsSaved = true;

        if (parsed.file) {
          policy = await replacePolicyFile(db, policy.slug, parsed.file, actor.name);
        }
        values = fieldsOf(policy);
        banner = await republish();
      } catch (error) {
        banner = {
          ok: false,
          message: fieldsSaved
            ? `The wording was saved, but the document was not replaced — ${detailOf(error)} Families are still being served the previous document. Choose the PDF again.`
            : `Nothing was saved — ${detailOf(error)}`,
        };
      }
    }
  } else {
    const parsed = parsePolicyDraft(form);
    values = { ...values, ...parsed.values };
    errors = parsed.errors;

    if (Object.keys(errors).length > 0) {
      banner = { ok: false, message: 'Nothing was created — the fields below need fixing first.' };
    } else {
      try {
        policy = await createPolicy(
          db,
          {
            slug: policySlug(values.title),
            title: values.title,
            position: positionNumber(values.position),
            signed: values.signed,
          },
          actor.name,
        );
        values = fieldsOf(policy);
        banner = {
          ok: true,
          message:
            'Created. It is not on the policies page yet — write the line that says what it is, choose the PDF, and save.',
        };
      } catch (error) {
        banner = { ok: false, message: saveErrorMessage(error, CREATE_ERROR) };
      }
    }
  }
}

const versions: PolicyVersion[] = policy ? await listPolicyVersions(db, policy.slug) : [];

/**
 * The confirmation's four sentences, which turn on how many documents there
 * are: a policy nobody ever uploaded to has nothing to reassure the school
 * about, and saying "every document is kept" over an empty list would be a
 * reassurance about nothing.
 */
const deletion = policy ? policyDeletion(policy.title, versions.length) : null;

const action = policy ? `/admin/policies/${policy.slug}` : '/admin/policies/new';
const heading = policy ? policy.title : 'Add a Policy';
const stamp = policy ? formatStamp(policy.lastEditedBy, policy.lastEditedAt) : null;
const control =
  'w-full rounded border border-navy/40 bg-white px-3 py-2 aria-[invalid=true]:border-gold';

async function republish(): Promise<Banner> {
  const result = await revalidateAll({
    origin: revalidationOrigin(Astro.url),
    bypassToken: isrBypassToken(),
  });
  return { ok: result.ok, message: describeRevalidation(result) };
}

function fieldsOf(row: Policy): PolicyFields {
  return {
    title: row.title,
    description: row.description,
    position: String(row.position),
    signed: row.signed,
  };
}

function detailOf(error: unknown): string {
  return error instanceof Error ? error.message : String(error);
}

---

<AdminLayout title={heading} actor={actor}>
  <p><a href="/admin/policies" class="underline underline-offset-4">← All policies</a></p>
  <h1 class="mt-2 text-3xl font-semibold text-navy">{heading}</h1>

  {
    adding && !policy ? (
      <p class="mt-2">
        Three questions, and that is the whole form. A policy's web address is made from its title
        and never changes afterwards, so this is the one screen here worth reading twice. Everything
        else — what it says it is, and the document itself — comes next and can be changed at any
        time.
      </p>
    ) : (
      <p class="mt-2">
        Saved here, this appears on the policies page. Choosing a PDF replaces the document at the
        same web address — every link that ever pointed at it keeps working.
      </p>
    )
  }

  {banner && <AdminBanner ok={banner.ok} message={banner.message} testId="save-banner" retry />}

  {
    confirmingDeletion && policy && deletion ? (
      <AdminConfirm
        heading={deletion.heading}
        action={action}
        confirmLabel={deletion.confirmLabel}
        destructive
        declineHref={action}
        declineLabel={deletion.declineLabel}
      >
        <Fragment slot="fields">
          <input type="hidden" name="delete" value="1" />
        </Fragment>

        <p class="mt-3" data-testid="deletion-goes">
          {deletion.goes}
        </p>
        <p class="mt-3" data-testid="deletion-kept">
          {deletion.kept}
        </p>
        <p class="mt-3" data-testid="deletion-undo">
          {deletion.undo}
        </p>
      </AdminConfirm>
    ) : (
      <form method="post" action={action} enctype="multipart/form-data" class="mt-8 flex flex-col gap-6">
    <div class="flex flex-col gap-2">
      <label for="title" class="font-semibold">{LABELS.title}</label>
      <p id="title-hint" class="text-sm">
        {
          policy
            ? 'What the document is called. Renaming it does not move its web address.'
            : 'What the document is called — “Handbook”, “Code of Conduct”.'
        }
      </p>
      <input
        id="title"
        name="title"
        type="text"
        value={values.title}
        required
        aria-invalid={errors.title ? 'true' : undefined}
        aria-describedby={errors.title ? 'title-hint title-error' : 'title-hint'}
        class={control}
      />
      {
        errors.title && (
          <p id="title-error" class="font-semibold">
            {errors.title}
          </p>
        )
      }
    </div>

    {
      policy && (
        <div class="flex flex-col gap-2">
          <label for="description" class="font-semibold">
            {LABELS.description}
          </label>
          <p id="description-hint" class="text-sm">
            One sentence, shown under the title on the policies page, so a parent knows which
            document this is without opening it.
          </p>
          <textarea
            id="description"
            name="description"
            rows={3}
            required
            aria-invalid={errors.description ? 'true' : undefined}
            aria-describedby={
              errors.description ? 'description-hint description-error' : 'description-hint'
            }
            class={control}
          >
            {values.description}
          </textarea>
          {errors.description && (
            <p id="description-error" class="font-semibold">
              {errors.description}
            </p>
          )}
        </div>
      )
    }

    <div class="flex flex-col gap-2">
      <label for="position" class="font-semibold">{LABELS.position}</label>
      <p id="position-hint" class="text-sm">
        Where it sits on the policies page. 1 is the top.
      </p>
      <input
        id="position"
        name="position"
        type="number"
        min="1"
        max="99"
        value={values.position}
        required
        aria-invalid={errors.position ? 'true' : undefined}
        aria-describedby={errors.position ? 'position-hint position-error' : 'position-hint'}
        class="w-24 rounded border border-navy/40 bg-white px-3 py-2 aria-[invalid=true]:border-gold"
      />
      {
        errors.position && (
          <p id="position-error" class="font-semibold">
            {errors.position}
          </p>
        )
      }
    </div>

    <div class="flex flex-col gap-2">
      <label class="flex items-center gap-2 font-semibold">
        <input type="checkbox" name="signed" value="on" checked={values.signed} />
        {LABELS.signed}
      </label>
      <p class="text-sm">
        Tick this if families put a signature on it at enrollment. It adds a note on the policies
        page and nothing else.
      </p>
    </div>

    {
      policy && (
        <div class="flex flex-col gap-2">
          <label for="file" class="font-semibold">
            {LABELS.file}
          </label>
          <p id="file-hint" class="text-sm">
            A PDF. Choosing one here replaces the document at the same address and stamps today as
            the updated date — you never type that date. Leave it alone to save the fields above on
            their own.
          </p>
          {policy.filename && (
            <p class="text-sm">
              Now serving:{' '}
              <a
                href={policyPath(policy.slug)}
                class="underline underline-offset-4"
                data-testid="current-file"
              >
                {policy.filename}
              </a>{' '}
              at <code>{policyPath(policy.slug)}</code>
            </p>
          )}
          <input
            id="file"
            name="file"
            type="file"
            accept="application/pdf"
            aria-invalid={errors.file ? 'true' : undefined}
            aria-describedby={errors.file ? 'file-hint file-error' : 'file-hint'}
            class={control}
          />
          {errors.file && (
            <p id="file-error" class="font-semibold">
              {errors.file}
            </p>
          )}
        </div>
      )
    }

    <button
      type="submit"
      class="self-start rounded bg-navy px-5 py-2.5 font-semibold text-cream hover:bg-navy-deep"
    >
      {policy ? 'Save' : 'Create'}
    </button>
      </form>
    )
  }

  {
    policy && !confirmingDeletion && (
      <section class="mt-10 border-t border-navy/15 pt-6">
        <h2 class="text-xl font-semibold text-navy">Versions</h2>
        {versions.length === 0 ? (
          <p class="mt-2" data-testid="versions-empty">
            No document has been uploaded yet, so this policy is not on the policies page.
          </p>
        ) : (
          <>
            <p class="mt-2">
              Every version ever uploaded, newest first. They are kept so the school can see what a
              family actually signed.
            </p>
            <ul class="mt-4 flex flex-col gap-3" data-testid="versions">
              {versions.map((version) => (
                <li>
                  <a
                    href={policyVersionPath(policy!.slug, version.version)}
                    class="underline underline-offset-4"
                  >
                    Version {version.version} — {version.filename}
                  </a>
                  <span class="text-sm">
                    {' · '}
                    {updatedOnLabel(version.uploadedAt)}
                    {' · '}
                    {fileSizeLabel(version.size)}
                    {version.uploadedBy ? ` · uploaded by ${version.uploadedBy}` : ''}
                    {version.version === policy!.version ? ' · this is the current one' : ''}
                  </span>
                </li>
              ))}
            </ul>
          </>
        )}
      </section>
    )
  }

  {
    stamp && !confirmingDeletion && (
      <AdminPublishing stamp={stamp}>
        <p class="mt-2" data-testid="updated-on">
          {policy!.updatedAt
            ? `Parents are told this was updated ${updatedOnLabel(policy!.updatedAt)} — the day the current document was uploaded.`
            : 'Parents are told nothing yet: there is no document, so this policy is not on the policies page.'}
        </p>

        <form method="post" action={action} class="mt-6">
          <p class="text-sm">
            No longer part of the school’s policy set? Delete it, and it comes off the policies page
            and out of this admin. Every document already uploaded is kept and stays readable at the
            address it was given, so nothing a family has already agreed to is lost. You will be
            asked to confirm first.
          </p>
          <AdminButton variant="destructive" name="delete" value="1" class="mt-3">
            Delete this policy
          </AdminButton>
        </form>
      </AdminPublishing>
    )
  }
</AdminLayout>
