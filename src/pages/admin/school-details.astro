---
export const prerender = false;

import AdminBanner from '../../components/AdminBanner.astro';
import AdminButton from '../../components/AdminButton.astro';
import AdminField from '../../components/AdminField.astro';
import AdminPublishing from '../../components/AdminPublishing.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import type { Banner } from '../../lib/admin/banner.js';
import { formatStamp } from '../../lib/admin/formatting.js';
import { isrBypassToken } from '../../lib/admin/isr-token.js';
import { republishOutcome } from '../../lib/admin/republish-outcome.js';
import {
  describeRevalidation,
  revalidateAll,
  revalidationOrigin,
} from '../../lib/admin/revalidate.js';
import {
  getSchoolDetails,
  LABELS,
  parseSchoolDetails,
  saveSchoolDetails,
  schoolDetailsFields,
  type SchoolDetailsErrors,
  type SchoolDetailsFields,
} from '../../lib/admin/school-details.js';
import { getDb } from '../../lib/db/client.js';

/**
 * The one small form this whole ticket exists to prove (#18 §10).
 *
 * Save writes the row, stamps it, then revalidates *every* public path and
 * waits for the answer. What Jill is told afterwards is the answer, not an
 * assumption — a save that failed to revalidate looks exactly like an edit that
 * vanished, and that is the thing most likely to make her stop trusting this.
 */
const db = await getDb();
const actor = Astro.locals.actor!;

let row = await getSchoolDetails(db);
let values: SchoolDetailsFields = schoolDetailsFields(row);
let errors: SchoolDetailsErrors = {};
/*
 * The strip that reports the last action. Named for the result rather than for
 * the component, because `banner` on this screen now also means the home
 * page's announcement banner below, and the two are unrelated.
 */
let saveResult: Banner | null = republishOutcome(Astro.url.searchParams.get('republished'));

if (Astro.request.method === 'POST') {
  const parsed = parseSchoolDetails(await Astro.request.formData());
  values = parsed.values;
  errors = parsed.errors;

  if (Object.keys(errors).length > 0) {
    saveResult = { ok: false, message: 'Nothing was saved — the fields below need fixing first.' };
  } else {
    row = await saveSchoolDetails(db, values, actor.name);
    values = schoolDetailsFields(row);
    const result = await revalidateAll({
      origin: revalidationOrigin(Astro.url),
      bypassToken: isrBypassToken(),
    });
    saveResult = { ok: result.ok, message: describeRevalidation(result) };
  }
}

const stamp = formatStamp(row.lastEditedBy, row.lastEditedAt);

/**
 * The form's shape. Type decides the control; nothing else varies.
 *
 * `optional` is the banner's doing (#15), and now the registration payment
 * link's (#111). `required` was a constant when every field here had to be
 * filled; the banner's fields are legitimately empty while it is switched off —
 * marking them required would make the browser refuse the submission that turns
 * it off — and an empty payment link is "no online option yet".
 */
type Field = {
  /**
   * The string-valued fields only. `bannerEnabled` is a boolean and is drawn as
   * its own checkbox below — excluded here rather than stringified, so a stray
   * entry cannot render the word "true" into a text box.
   */
  name: Exclude<keyof SchoolDetailsFields, 'bannerEnabled'>;
  type: 'text' | 'tel' | 'email' | 'date' | 'url' | 'multiline';
  hint?: string;
  optional?: true;
  rows?: number;
};

const FIELDS: Field[] = [
  { name: 'address', type: 'multiline', hint: 'One line per line, as it should appear.', rows: 3 },
  { name: 'phone', type: 'tel' },
  { name: 'email', type: 'email' },
  { name: 'schoolYearStart', type: 'date', hint: 'The first day of classes.' },
  { name: 'mission', type: 'multiline' },
  { name: 'vision', type: 'multiline' },
  {
    name: 'giveUrl',
    type: 'url',
    hint: 'Where the Give button goes. Changed here, it changes everywhere.',
  },
  {
    name: 'payOnlineUrl',
    type: 'url',
    hint: 'Optional. Where families pay the registration and the tuition online, in one payment — the Vanco page. Left empty, the Apply page offers no online payment at all.',
    optional: true,
  },
];

/** The banner's three written fields, below its switch. */
const BANNER_FIELDS: Field[] = [
  {
    name: 'bannerMessage',
    type: 'text',
    hint: 'The date is added after it, so “Register now! Classes begin” reads “Register now! Classes begin August 31”.',
    optional: true,
  },
  { name: 'bannerDate', type: 'date', hint: 'What the message is about.', optional: true },
  {
    name: 'bannerLink',
    type: 'url',
    hint: 'Optional. Where the message goes when someone clicks it.',
    optional: true,
  },
];
---

<AdminLayout title="School Details" actor={actor}>
  <h1 class="text-3xl font-semibold text-navy">School Details</h1>
  <p class="mt-2">Entered once here, and rendered everywhere the school's details appear.</p>

  {
    saveResult && (
      <AdminBanner ok={saveResult.ok} message={saveResult.message} testId="save-banner" retry />
    )
  }

  <form method="post" class="mt-8 flex flex-col gap-6">
    {
      FIELDS.map((field) => (
        <AdminField
          name={field.name}
          type={field.type}
          label={LABELS[field.name]}
          value={values[field.name]}
          hint={field.hint}
          error={errors[field.name]}
          optional={field.optional}
          rows={field.rows}
        />
      ))
    }

    <fieldset class="flex flex-col gap-6 border-t border-navy/15 pt-6">
      <legend class="sr-only">Home Page Banner</legend>
      <div>
        <h2 class="text-xl font-semibold text-navy">Home Page Banner</h2>
        <p class="mt-2">
          A single line across the top of the home page, for something the school needs families to
          see now. Switched off, the home page shows nothing there at all.
        </p>
      </div>

      <AdminField
        name="bannerEnabled"
        type="checkbox"
        label={LABELS.bannerEnabled}
        checked={values.bannerEnabled}
      />

      {
        BANNER_FIELDS.map((field) => (
          <AdminField
            name={field.name}
            type={field.type}
            label={LABELS[field.name]}
            value={values[field.name]}
            hint={field.hint}
            error={errors[field.name]}
            optional={field.optional}
          />
        ))
      }
    </fieldset>

    <AdminButton class="self-start">Save</AdminButton>
  </form>

  <AdminPublishing stamp={stamp}>
    <p class="mt-2">
      Saving republishes the whole site. Use this if the site ever looks out of date anyway.
    </p>
  </AdminPublishing>
</AdminLayout>
