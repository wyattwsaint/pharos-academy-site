---
export const prerender = false;

import AdminBanner from '../../components/AdminBanner.astro';
import AdminButton from '../../components/AdminButton.astro';
import AdminField from '../../components/AdminField.astro';
import AdminPublishing from '../../components/AdminPublishing.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import type { Banner } from '../../lib/admin/banner.js';
import { isrBypassToken } from '../../lib/admin/isr-token.js';
import {
  describeRevalidation,
  revalidateAll,
  revalidationOrigin,
} from '../../lib/admin/revalidate.js';
import { formatStamp } from '../../lib/admin/formatting.js';
import { republishOutcome } from '../../lib/admin/republish-outcome.js';
import {
  emptyFields,
  fieldsOf,
  parseSchoolYear,
  SPARE_CLOSURE_ROWS,
  termKey,
  type SchoolYearErrors,
  type SchoolYearFields,
} from '../../lib/admin/school-year.js';
import { CALENDAR_PATH } from '../../lib/calendar/views.js';
import { getSchoolYear, saveSchoolYear } from '../../lib/calendar/store.js';
import { SEMESTERS } from '../../lib/calendar/year.js';
import { semesterHeading } from '../../lib/calendar/views.js';
import { DAY_TRACKS } from '../../lib/courses/schedule.js';
import { getDb } from '../../lib/db/client.js';

/**
 * The School Year screen — the whole calendar, typed once a summer (#23).
 *
 * Eight first-class dates, two week counts and a list of closed days. Every one
 * of the 112 dates and each track's own week numbering is computed from them,
 * so the four tracks cannot drift apart the way the school's five hand-made
 * PDFs already have.
 *
 * **The Tuesday row is left blank to leave the Tuesday track out.** A year in
 * which it has no first class date and no courses is complete, not incomplete
 * (#14), so a blank row is not an error and there is no "no Tuesday this year"
 * tick to remember. Half a row is an error, because a date with no week count
 * is a track that runs for no weeks.
 *
 * The preview to the right of the form is computed **in the browser, from the
 * same module the site renders with** — `calendar/year.ts`. It updates as she
 * types, before anything is saved, which is what makes a mistyped closure
 * visible as a shifted column rather than as a wrong date on a live site.
 */
const db = await getDb();
const actor = Astro.locals.actor!;

let year = await getSchoolYear(db);
let values: SchoolYearFields = year ? fieldsOf(year) : emptyFields();
let errors: SchoolYearErrors = {};
let banner: Banner | null = republishOutcome(Astro.url.searchParams.get('republished'));

if (Astro.request.method === 'POST') {
  const parsed = parseSchoolYear(await Astro.request.formData());
  values = parsed.values;
  errors = parsed.errors;

  if (Object.keys(errors).length > 0) {
    banner = { ok: false, message: 'Nothing was saved — the fields below need fixing first.' };
  } else {
    try {
      year = await saveSchoolYear(db, parsed.edit, actor.name);
      values = fieldsOf(year);
      const result = await revalidateAll({
        origin: revalidationOrigin(Astro.url),
        bypassToken: isrBypassToken(),
      });
      banner = { ok: result.ok, message: describeRevalidation(result) };
    } catch (error) {
      banner = {
        ok: false,
        message: `Nothing was saved — ${error instanceof Error ? error.message : String(error)}`,
      };
    }
  }
}

/** The closure rows to render: the real ones, plus spares to type into. */
const closureRows = [
  ...values.closures,
  ...Array.from({ length: SPARE_CLOSURE_ROWS }, () => ({ date: '', label: '' })),
];
---

<AdminLayout title="School Year" actor={actor}>
  <h1 class="text-3xl font-semibold text-navy">School Year</h1>
  <p class="mt-2">
    Type the year once. Every class date on <a href={CALENDAR_PATH} class="underline underline-offset-4"
      >the calendar</a
    >, the parents’ subscribe link and each track’s week numbering are computed from what is on
    this screen.
  </p>

  {banner && <AdminBanner ok={banner.ok} message={banner.message} testId="save-banner" retry />}

  <form method="post" action="/admin/school-year" class="mt-8 flex flex-col gap-10" data-year-form>
    <AdminField
      name="label"
      type="text"
      label="Which year this is"
      hint="As it is written on the sheets — “2026–2027”."
      value={values.label}
      error={errors.label}
    />

    {
      /*
        Every control below is `optional` in the HTML sense: the browser must
        not stop the form. A blank Tuesday row is a complete year (#14) and a
        blank closure row is a spare, so the parser is the only thing that
        knows whether what is missing is missing wrongly.
      */
    }
    {
      SEMESTERS.map((semester) => (
        <fieldset class="flex flex-col gap-4">
          <legend class="text-xl font-semibold text-navy">{semesterHeading(semester)}</legend>
          <p class="text-sm">
            The first class date for each track, and how many weeks of classes it runs. Leave a
            track empty if it does not run this semester — that is a complete year, not an
            unfinished one.
          </p>

          {DAY_TRACKS.map((track) => {
            const key = termKey(semester, track);
            const fields = values.terms[key]!;
            const dateError = errors[`${key}.firstClassDate`];
            const weeksError = errors[`${key}.weeks`];

            return (
              <div class="flex flex-wrap gap-4">
                <AdminField
                  name={`${key}.firstClassDate`}
                  type="date"
                  label={`${track} — first class`}
                  value={fields.firstClassDate}
                  error={dateError}
                  class="min-w-56 flex-1"
                  optional
                />
                <AdminField
                  name={`${key}.weeks`}
                  type="number"
                  label="Weeks"
                  value={fields.weeks}
                  error={weeksError}
                  min={1}
                  step={1}
                  class="min-w-56 flex-1"
                  optional
                />
              </div>
            );
          })}
        </fieldset>
      ))
    }

    <fieldset class="flex flex-col gap-4" data-closures>
      <legend class="text-xl font-semibold text-navy">Days the School Is Closed</legend>
      <p class="text-sm">
        A closed day takes a week off whichever track meets that weekday, which is exactly why the
        four tracks’ week numbers differ. Thanksgiving is several rows, one per day off.
      </p>

      {
        closureRows.map((closure, index) => {
          const dateError = errors[`closures.${index}.date`];
          const labelError = errors[`closures.${index}.label`];
          return (
            /*
              Both complaints, each with its own control (#196, #190).
              Every row posts under the same two names, so the ids are the
              row's rather than the field's — and the row that is wrong twice
              says so twice, which is the difference between fixing it in one
              pass and being told about the date only after the label is fixed.
            */
            <div class="flex flex-wrap gap-4" data-closure-row>
              <AdminField
                name="closure.date"
                id={`closure-date-${index}`}
                type="date"
                label="Closed on"
                value={closure.date}
                error={dateError}
                class="min-w-56"
                optional
              />
              <AdminField
                name="closure.label"
                id={`closure-label-${index}`}
                type="text"
                label="What for"
                value={closure.label}
                error={labelError}
                class="min-w-56 flex-1"
                optional
              />
            </div>
          );
        })
      }

      <p class="text-sm">
        Clearing both boxes on a row removes that closed day. There are always spare rows at the
        bottom.
      </p>
    </fieldset>

    <AdminButton class="self-start">Save the year</AdminButton>
  </form>

  <section class="mt-12 border-t border-navy/15 pt-6">
    <h2 class="text-xl font-semibold text-navy">What This Produces</h2>
    <p class="mt-2 text-sm">
      Computed here in the browser as you type, from the same code the calendar page renders with.
      Nothing is saved until you press Save.
    </p>
    <div class="mt-6 flex flex-col gap-8" data-preview aria-live="polite">
      <p data-preview-empty>Fill in a track above and its dates appear here.</p>
    </div>
  </section>

  <AdminPublishing stamp={formatStamp(year?.lastEditedBy ?? null, year?.lastEditedAt ?? null)}>
    <p class="mt-2">
      Saving republishes the whole site, and changes what
      <code>/calendar.ics</code> hands to every subscribed phone. Those phones check on their own
      schedule — usually within a few hours, sometimes a day or two — so a change made this week
      still needs a text message. Nobody controls that, and no calendar service would change it.
    </p>
  </AdminPublishing>
</AdminLayout>

<script>
  import { previewRows, SEMESTERS, type Closure, type SchoolYear, type Term } from '../../lib/calendar/year.js';
  import { DAY_TRACKS } from '../../lib/courses/schedule.js';

  /**
   * The live preview (#23 AC 4).
   *
   * It imports the site's own computation rather than reimplementing it in the
   * browser. A second implementation here would be the one place the preview
   * could disagree with what is published — which is precisely the failure the
   * five hand-made PDFs are, moved into the admin.
   */
  const form = document.querySelector<HTMLFormElement>('[data-year-form]');
  const preview = document.querySelector<HTMLElement>('[data-preview]');
  if (form && preview) {
    const draw = () => {
      const year = readYear(form);
      preview.replaceChildren(...render(year));
    };
    form.addEventListener('input', draw);
    form.addEventListener('change', draw);
    draw();
  }

  /** The form as a school year, ignoring anything not yet typed. */
  function readYear(form: HTMLFormElement): SchoolYear {
    const data = new FormData(form);
    const value = (name: string) => String(data.get(name) ?? '').trim();

    const terms: Term[] = [];
    for (const semester of SEMESTERS) {
      for (const track of DAY_TRACKS) {
        const firstClassDate = value(`${semester}.${track}.firstClassDate`);
        const weeks = Number(value(`${semester}.${track}.weeks`));
        if (!firstClassDate || !Number.isInteger(weeks) || weeks < 1) continue;
        terms.push({ semester, track, firstClassDate, weeks });
      }
    }

    const dates = data.getAll('closure.date').map((one) => String(one).trim());
    const labels = data.getAll('closure.label').map((one) => String(one).trim());
    const closures: Closure[] = [];
    dates.forEach((date, index) => {
      if (date) closures.push({ date, label: labels[index] ?? '' });
    });

    return { label: value('label'), terms, closures, lastEditedBy: null, lastEditedAt: null };
  }

  /** The four-column sheet, one table per semester. */
  function render(year: SchoolYear): HTMLElement[] {
    const sections: HTMLElement[] = [];

    for (const semester of SEMESTERS) {
      const rows = previewRows(year, semester);
      if (rows.length === 0) continue;

      const section = document.createElement('section');
      const heading = document.createElement('h3');
      heading.className = 'font-semibold text-navy';
      heading.textContent = semester === 'fall' ? 'Fall semester' : 'Spring semester';
      section.append(heading);

      const table = document.createElement('table');
      table.className = 'mt-3 w-full text-sm';
      const head = document.createElement('thead');
      head.append(row(['Week', ...DAY_TRACKS], 'col'));
      const body = document.createElement('tbody');

      for (const entry of rows) {
        const cells =
          entry.kind === 'week'
            ? [String(entry.week), ...DAY_TRACKS.map((track) => label(entry.cells[track]))]
            : ['', ...DAY_TRACKS.map((track) => entry.cells[track] ?? '')];
        const line = row(cells, entry.kind === 'week' ? 'row' : null);
        if (entry.kind === 'closure') line.className = 'italic';
        body.append(line);
      }

      table.append(head, body);
      section.append(table);
      sections.push(section);
    }

    if (sections.length === 0) {
      const empty = document.createElement('p');
      empty.textContent = 'Fill in a track above and its dates appear here.';
      return [empty];
    }
    return sections;
  }

  /**
   * One row, with its headers declared (#196, #190).
   *
   * `scope` is what turns four columns of computed dates into something a
   * screen reader can read cell by cell: `col` for the track names across the
   * top, `row` for the week number down the side. Both are needed, because
   * every date in here answers a track *and* a week. A closure row has no week
   * number, so its first cell is an empty `td` rather than a header of
   * nothing.
   */
  function row(cells: readonly string[], scope: 'col' | 'row' | null): HTMLTableRowElement {
    const line = document.createElement('tr');
    cells.forEach((value, index) => {
      const header = scope !== null && (scope === 'col' || index === 0);
      const cell = header ? document.createElement('th') : document.createElement('td');
      if (header && scope) cell.scope = scope;
      cell.className = 'border-b border-navy/15 py-1 pr-3 text-left';
      // A row header is still a week number, not a heading: `font-normal`
      // keeps the sheet looking exactly as it did, the way the Money
      // confirmation's row headers already do.
      if (scope === 'row') cell.classList.add('font-normal');
      cell.textContent = value;
      line.append(cell);
    });
    return line;
  }

  /** "31 Aug 2026" — short, because eight of these sit side by side. */
  function label(date: string | null): string {
    if (!date) return '';
    return new Date(`${date}T00:00:00Z`).toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      timeZone: 'UTC',
    });
  }
</script>
