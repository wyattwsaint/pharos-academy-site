---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSchoolDetails } from '../lib/admin/school-details.js';
import {
  admissionCosts,
  agesLabel,
  APPLICATION_HREF,
  instalmentSentence,
  morningsLabel,
} from '../lib/admissions/admissions.js';
import { listCourses } from '../lib/courses/store.js';
import { getDb } from '../lib/db/client.js';
import { INQUIRY_HREF } from '../lib/home/sections.js';
import { getMoneySettings } from '../lib/money/store.js';
import { publishedPolicies } from '../lib/policies/policy.js';
import { listPolicies } from '../lib/policies/store.js';
import { POLICIES_PATH, policyPath } from '../lib/policies/views.js';

/**
 * How applying works, said plainly before anybody is asked for anything (#29).
 *
 * This page exists because of what comes after it. The application asks a
 * stranger for two cheques, four signatures and a year of their child's
 * mornings, and the worst moment on this site is a parent halfway into that
 * form working out what they have committed to. One page of honest explanation
 * beforehand is the cheapest possible mitigation of it.
 *
 * So the order here is the order of a family's questions: is this for us, when
 * would we be here, what does applying actually involve, what does it cost, and
 * what are we signing. The button is last, on purpose — it is the answer to the
 * page, not the point of it.
 *
 * **Not one figure below is typed.** The fees, the four payment dates, the ages
 * and the mornings all come from the money settings and the catalogue (#29
 * AC 1), and the documents are the policies the school has actually marked as
 * signed rather than a list somebody kept up to date by hand.
 */
const db = await getDb();
const details = await getSchoolDetails(db);
const courses = await listCourses(db);
const settings = await getMoneySettings(db);
const signedPolicies = publishedPolicies(await listPolicies(db)).filter((policy) => policy.signed);

const costs = admissionCosts(settings);
const ages = agesLabel(courses);
const mornings = morningsLabel(courses);

const description =
  'How to apply to Pharos Academy — who the classes are for, what applying involves, what it costs, and which documents families sign.';
---

<BaseLayout details={details} title="Admissions" description={description}>
  <section class="band band-quiet" data-section="admissions-header">
    <div class="wide">
      <p class="label">Admissions</p>
      <h1 class="mt-4">How applying works</h1>
      <p class="sub mt-5">
        Everything before the form, so that nothing in the form is a surprise. Read this first —
        it takes about three minutes, and it is the whole of what we ask of a family.
      </p>
    </div>
  </section>

  <section class="band" id="who" data-section="admissions-who">
    <div class="wide">
      <h2>Who it is for</h2>
      <p class="mt-4">
        Homeschooling families in and around Enola who want a few subjects taught alongside other
        children, and the rest taught at home. You choose the classes you want; we do not enrol
        anybody full time and we do not replace what you are already doing.
      </p>
      {
        ages && (
          <p class="mt-4">
            Classes are written for ages {ages}, and each one states the ages it is open to on
            <a href="/classes"> the classes page</a>. A class with no age on it is gated on
            readiness instead, and its own page says how.
          </p>
        )
      }
      <p class="mt-4">
        We are a Christian classical school and we teach that way in every subject. Families do
        not have to belong to our church, but you should read
        <a href="/#faith"> why we do this</a> before applying.
      </p>
    </div>
  </section>

  <section class="band band-quiet" id="mornings" data-section="admissions-mornings">
    <div class="wide">
      <h2>The mornings</h2>
      <p class="mt-4">
        Classes meet on {mornings} mornings. Afternoons are yours. Most families come for one or
        two mornings rather than all of them —
        <a href="/classes/by-day">the timetable</a> shows which classes run when and which of them
        overlap, which is worth checking before you choose.
      </p>
      <p class="mt-4">
        Parents stay on site. This is a hybrid school, not a drop-off, and the mornings work
        because the adults are part of them.
      </p>
    </div>
  </section>

  <section class="band" id="applying" data-section="admissions-applying">
    <div class="wide">
      <h2>What applying involves</h2>
      <ol class="steps mt-6">
        <li>
          <h3>Tell us about your family</h3>
          <p class="mt-2">
            A short conversation first — your children's ages, what you are looking for, and any
            questions you want answered before you commit to anything. Nothing is binding.
          </p>
        </li>
        <li>
          <h3>Choose your classes</h3>
          <p class="mt-2">
            One at a time or several. Each class states its ages, its morning, its length and its
            cost, so you can price your year before you apply.
          </p>
        </li>
        <li>
          <h3>Send the application and the cheques</h3>
          <p class="mt-2">
            The fees below are paid by cheque, made out to Pharos Academy. Until we have them the
            seat is not held, and we will tell you plainly if a class is already full.
          </p>
        </li>
        <li>
          <h3>Sign the documents at enrolment</h3>
          <p class="mt-2">
            In person, on paper, once you have read them. They are all on this site, in full,
            beforehand.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="band band-quiet" id="cost" data-section="admissions-cost">
    <div class="wide">
      <h2>What it costs to apply</h2>
      <p class="mt-4">
        Two cheques, and both are paid to the school. Tuition is separate and is paid directly to
        the instructor who teaches your child.
      </p>

      <ul class="costs mt-7">
        {
          costs.map((cost) => (
            <li>
              <b>{cost.amount}</b>
              <span class="what">{cost.what}</span>
              <span class="detail">{cost.detail}</span>
            </li>
          ))
        }
      </ul>

      <p class="mt-7">{instalmentSentence(settings)}</p>
      <p class="mt-4">
        Every class's own cost is on <a href="/classes">the classes page</a>, computed from the
        hours it meets — there is no fee on this site that is not worked out the same way for
        every family.
      </p>
      <details class="refunds mt-7">
        <summary>What happens if you withdraw</summary>
        <p class="mt-3">{settings.refundTerms}</p>
      </details>
    </div>
  </section>

  <section class="band" id="documents" data-section="admissions-documents">
    <div class="wide">
      <h2>What you sign</h2>
      {
        signedPolicies.length === 0 ? (
          <p class="mt-4">
            The documents families sign are being prepared and will be published here before the
            intake opens.
          </p>
        ) : (
          <>
            <p class="mt-4">
              {signedPolicies.length === 1
                ? 'One document, signed in person at enrolment.'
                : `${signedPolicies.length} documents, signed in person at enrolment.`}{' '}
              All of them are here to read in full first, and none of them is signed as part of
              the application itself.
            </p>
            <ul class="signed mt-6">
              {signedPolicies.map((policy) => (
                <li>
                  <a href={policyPath(policy.slug)}>{policy.title}</a>
                  {policy.description && <span class="detail">{policy.description}</span>}
                </li>
              ))}
            </ul>
          </>
        )
      }
      <p class="mt-6 text-ink-2">
        <a href={POLICIES_PATH}>Every policy the school publishes</a>, including the ones nobody signs.
      </p>
    </div>
  </section>

  <section class="band band-quiet" id="start" data-section="admissions-start">
    <div class="wide">
      <h2>Ready?</h2>
      <p class="sub mt-4">
        Applying starts with a conversation. Tell us who you are and what you are looking for, and
        we will answer before anything is signed or sent.
      </p>
      <p class="mt-7">
        <a class="startbutton" href={APPLICATION_HREF}>Start your application</a>
      </p>
      <p class="mt-6 text-ink-2">
        Not ready to apply? <a href={INQUIRY_HREF}>Ask us anything</a> — we would far rather answer
        a question now than have you find the answer halfway through a form.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .steps {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    counter-reset: step;
    list-style: none;
    padding: 0;
  }

  .steps > li {
    border-left: 2px solid var(--color-gold-orn);
    padding-left: 1.25rem;
    counter-increment: step;
  }

  .steps h3::before {
    content: counter(step) '. ';
    color: var(--color-gold-orn);
  }

  .costs {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    list-style: none;
    padding: 0;
  }

  .costs > li {
    display: grid;
    grid-template-columns: minmax(5rem, auto) 1fr;
    column-gap: 1.5rem;
    align-items: baseline;
  }

  .costs b {
    font-family: var(--font-sans);
    font-feature-settings: 'tnum';
    font-size: 1.75rem;
    color: var(--color-navy);
  }

  .costs .what {
    font-weight: 600;
  }

  .costs .detail {
    grid-column: 2;
  }

  /* The amount stacks above its label on a phone rather than squeezing it. */
  @media (max-width: 32rem) {
    .costs > li {
      grid-template-columns: 1fr;
    }

    .costs .detail {
      grid-column: 1;
    }
  }

  .signed {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    list-style: none;
    padding: 0;
  }

  .signed > li {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border-left: 2px solid var(--color-gold-orn);
    padding-left: 1.25rem;
  }

  .refunds > summary {
    cursor: pointer;
    font-weight: 600;
  }

  .startbutton {
    display: inline-block;
    background: var(--color-navy);
    color: var(--color-cream);
    font-weight: 600;
    padding: 0.85rem 1.75rem;
    border-radius: 0.25rem;
    text-decoration: none;
  }

  .startbutton:hover {
    background: var(--color-deep-blue);
  }
</style>
