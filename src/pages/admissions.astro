---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSchoolDetails } from '../lib/admin/school-details.js';
import { admissionCosts, APPLICATION_HREF } from '../lib/admissions/admissions.js';
import { getDb } from '../lib/db/client.js';
import { INQUIRY_HREF } from '../lib/home/sections.js';
import { getMoneySettings } from '../lib/money/store.js';
import { publishedPolicies } from '../lib/policies/policy.js';
import { listPolicies } from '../lib/policies/store.js';
import { POLICIES_PATH, policyPath } from '../lib/policies/views.js';

/**
 * How applying works, said plainly before anybody is asked for anything (#29).
 *
 * This page exists because of what comes after it. The application asks a
 * stranger for two checks, four signatures and a year of their child's
 * mornings, and the worst moment on this site is a parent halfway into that
 * form working out what they have committed to. One page of honest explanation
 * beforehand is the cheapest possible mitigation of it.
 *
 * So the order here is the order of a family's questions: who is this for, what
 * makes it different from anywhere else, what does it cost, and what are we
 * signing. The button is last, on purpose — it is the answer to the page, not
 * the point of it.
 *
 * The prose in the first two bands is the client's own, rewritten by them and
 * landed here verbatim (#107), as is the money and agreements copy below it
 * (#108). It is not ours to tighten.
 *
 * **Not one figure below is typed.** The fees come from the money settings (#29
 * AC 1), and the documents are the policies the school has actually marked as
 * signed rather than a list somebody kept up to date by hand. The ages and the
 * mornings the page used to derive left with the client's rewrite (#107), and
 * the four quarterly payment dates left with #108 — the school took them off
 * the page rather than moving them, so the admin still owns them and no page
 * prints them.
 */
const db = await getDb();
const details = await getSchoolDetails(db);
const settings = await getMoneySettings(db);
const signedPolicies = publishedPolicies(await listPolicies(db)).filter((policy) => policy.signed);

const costs = admissionCosts(settings);

const description =
  'How to apply to Pharos Academy — the families we serve, what makes us different, what it costs, and which documents families sign.';
---

<BaseLayout details={details} title="Admissions" description={description}>
  <section class="band band-quiet" data-section="admissions-header">
    <div class="wide">
      {/*
        The plate is the homepage's accent treatment, unchanged: heading left,
        picture in the 38% column, dissolved into the band. It is the H.O.P.E.
        "Educate" painting — the globe, the botanical book, the blue-and-gold
        bindings — reused at the size it is already built for rather than
        re-cropped, because the accent column and an H.O.P.E. card are the same
        width to within a few pixels and a second encode of one painting buys
        nothing. Decorative, so `alt` is empty: the heading beside it already
        says what the section is.
      */}
      <div class="accent">
        <div>
          <p class="label">Admissions</p>
          <h1 class="mt-4">How Applying Works</h1>
        </div>
        <figure class="plate">
          <img src="/imagery/hope-e.webp" alt="" width="800" height="533" loading="eager" />
        </figure>
      </div>
    </div>
  </section>

  <section class="band" id="who" data-section="admissions-who">
    <div class="wide">
      <h2>Families We Serve</h2>
      <p class="mt-4">
        Families in central PA who desire a few subjects taught alongside other children, and the
        rest taught at home. You choose the classes you want; we do not enroll anybody full time
        and we do not replace what you are already doing.
      </p>
      <p class="mt-4">
        We are a Christian classical school and we teach that way in every subject. Families do
        not have to belong to our church, but you should read
        <a href="/#faith"> what we believe</a> before applying.
      </p>
    </div>
  </section>

  <section class="band band-quiet" id="different" data-section="admissions-different">
    <div class="wide">
      <h2>What Makes Us Different</h2>
      {/*
        The four letters are the school's own name for what it is, so the
        expansion is `<strong>` — the client marked it as the load-bearing
        phrase in the paragraph, not as text that wanted to be heavier. A bold
        class here would have said the same thing to a sighted reader and
        nothing at all to a screen reader (#107 AC 3).
      */}
      <p class="mt-4">
        We are a supportive community of homeschooling families. That is what H.O.P.E. stands for
        — <strong>Helping Our Parents Educate</strong> — and it is the whole of our posture:
        parents remain the primary educators, and Pharos comes alongside them rather than taking
        their place.
      </p>
      <p class="mt-4">
        Learning here is flexible. Families take what serves them and teach the rest at home, and
        the week is arranged around the shape of your family rather than against it.
      </p>
      <p class="mt-4">
        You choose the courses your child takes, one or several. Drop-off is welcome, and parents
        who would rather stay are at home in the Parent Lounge for the morning.
      </p>
    </div>
  </section>

  <section class="band" id="cost" data-section="admissions-cost">
    <div class="wide">
      <h2>Prices for Partner Families</h2>

      <ul class="costs mt-7">
        {
          costs.map((cost) => (
            <li>
              <b>{cost.amount}</b>
              <span class="what">{cost.what}</span>
            </li>
          ))
        }
      </ul>

      <p class="mt-7">
        Every class's own cost is on <a href="/classes">the classes page</a>, computed from the
        hours it meets — there is no fee on this site that is not worked out the same way for
        every family.
      </p>
      <details class="refunds mt-7">
        <summary>What Happens If You Withdraw?</summary>
        <p class="mt-3">{settings.refundTerms}</p>
      </details>
    </div>
  </section>

  <section class="band band-quiet" id="documents" data-section="admissions-documents">
    <div class="wide">
      <h2>Is Pharos the Right Fit for your Family?</h2>
      {
        signedPolicies.length === 0 ? (
          <p class="mt-4">
            The documents families sign are being prepared and will be published here before the
            intake opens.
          </p>
        ) : (
          <>
            <p class="mt-4">
              At enrollment, the parent or guardian must sign two agreement statements. We
              encourage you to read them before you apply, to ensure that what you desire aligns
              with our code of conduct and policies.
            </p>
            <ul class="signed mt-6">
              {signedPolicies.map((policy) => (
                <li>
                  <a href={policyPath(policy.slug)}>{policy.title}</a>
                  {policy.description && <span class="detail">{policy.description}</span>}
                </li>
              ))}
            </ul>
          </>
        )
      }
      <p class="mt-6 text-ink-2">
        <a href={POLICIES_PATH}>All of our policies</a>
      </p>
    </div>
  </section>

  <section class="band" id="start" data-section="admissions-start">
    <div class="wide">
      <h2>Become a Pharos Family</h2>
      <p class="sub mt-4">
        Let's chat! Tell us who you are and what you are looking for, and we will answer before
        anything is signed or sent.
      </p>
      <p class="mt-7">
        <a class="startbutton" href={APPLICATION_HREF}>Start your application</a>
      </p>
      <p class="mt-6 text-ink-2">
        Not ready to apply? <a href={INQUIRY_HREF}>Ask us anything</a> — we would far rather answer
        a question now than have you find the answer halfway through a form.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Each charge lost its sentence (#144), so an entry is now one line on a
     desktop and two stacked ones on a phone. The gap came down with it: it
     separates entries, and it has to stay clearly wider than the zero row gap
     inside a stacked entry or the two read as one list of five things. */
  .costs {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    list-style: none;
    padding: 0;
  }

  .costs > li {
    display: grid;
    grid-template-columns: minmax(5rem, auto) 1fr;
    column-gap: 1.5rem;
    align-items: baseline;
  }

  .costs b {
    font-family: var(--font-sans);
    font-feature-settings: 'tnum';
    font-size: 1.75rem;
    color: var(--color-navy);
  }

  .costs .what {
    font-weight: 600;
  }

  /* The amount stacks above its label on a phone rather than squeezing it. */
  @media (max-width: 32rem) {
    .costs > li {
      grid-template-columns: 1fr;
    }
  }

  .signed {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    list-style: none;
    padding: 0;
  }

  .signed > li {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border-left: 2px solid var(--color-gold-orn);
    padding-left: 1.25rem;
  }

  .refunds > summary {
    cursor: pointer;
    font-weight: 600;
  }

  .startbutton {
    display: inline-block;
    background: var(--color-navy);
    color: var(--color-cream);
    font-weight: 600;
    padding: 0.85rem 1.75rem;
    border-radius: 0.25rem;
    text-decoration: none;
  }

  .startbutton:hover {
    background: var(--color-deep-blue);
  }
</style>
