---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { BELIEFS_ARTICLES, BELIEFS_CLOSING, BELIEFS_PATH } from '../../lib/about/beliefs.js';
import { getSchoolDetails } from '../../lib/admin/school-details.js';
import {
  APPLICATION_STAGES,
  applicationCost,
  FAITH_QUESTIONS,
  FAITH_RESPONDENTS,
  faithAnswer,
  faithKey,
  familyClashes,
  firstError,
  MAX_CHILDREN,
  parseApplication,
  prefillFrom,
  statementVersion,
  validateApplication,
  type ApplicationChild,
  type ApplicationErrors,
  type ApplicationFields,
  type ErrorField,
} from '../../lib/application/application.js';
import {
  AGREEMENT_CHOICES,
  agreementAnswer,
  agreementHref,
  agreementKey,
  askableAgreements,
} from '../../lib/application/agreements.js';
import {
  clashSentence,
  offeringKey,
  offeringsOf,
  title as offeringTitle,
} from '../../lib/application/offerings.js';
import { deliverApplication } from '../../lib/application/notices.js';
import {
  createApplication,
  listApplications,
  recordApplicationDelivery,
} from '../../lib/application/store.js';
import { classTally } from '../../lib/application/tally.js';
import { configuredMailer } from '../../lib/backup/monthly.js';
import { SITE_URL } from '../../lib/site.js';
import { getSchoolYear } from '../../lib/calendar/store.js';
import { SEEDED_SCHOOL_YEAR } from '../../lib/calendar/year.js';
import { timeLabel } from '../../lib/courses/schedule.js';
import { listCourses } from '../../lib/courses/store.js';
import { getDb } from '../../lib/db/client.js';
import { INQUIRY_PATH } from '../../lib/inquiry/inquiry.js';
import { getInquiry } from '../../lib/inquiry/store.js';
import { formatMoney, type MoneySettings } from '../../lib/money/settings.js';
import { getMoneySettings, recordAgreedTerms } from '../../lib/money/store.js';
import { publishedPolicies } from '../../lib/policies/policy.js';
import { listPolicies } from '../../lib/policies/store.js';

/**
 * The family's application (#31).
 *
 * Stages on one long document — the Statement of Faith, the classes, the two
 * agreements a family signs (#71), what to post, and sending it — with the
 * `APPLICATION_STAGES` ids as anchors. One
 * page rather than a stepped flow because the entry point is warm: a family
 * reaches this from a conversation and from a link Jill pasted into an email,
 * so the abandonment argument that favours splitting is weak, and headed
 * sections keep a stepped variant a CSS decision rather than a rebuild.
 *
 * `prerender = false`, because the form posts here and because the page is
 * pre-filled from *one family's* inquiry: a cached copy would show the next
 * family the last one's name and email.
 *
 * **Two buttons, not one.** "Check these choices" re-renders the warnings and
 * the totals and writes nothing; "Send the application" writes the row. A
 * clash is a warning and never a block (#31 AC 3–5), so the family has to be
 * able to see it *before* they commit — a page that only ever warns on the way
 * out is a page that tells a family about a $280 clash after they have
 * posted the cheque. Only Send is gated: **Check** is never greyed, because a
 * family who cannot yet send is exactly the family who wants to look.
 *
 * **The application gates on having answered, never on having agreed** (#85,
 * **ADR-0009**). "Send the application" is greyed until the form is complete,
 * and complete means *answered*: a family name, an email address we could reply
 * to, a child with a name and an age, a class, one full column of the Statement
 * of Faith grid by any one respondent, and an answer to each document the
 * school has actually published. What was answered is never the gate's business
 * — "No" passes, "Neither agrees" passes, an objection passes and still routes
 * the application to a conversation rather than to a refusal. The ADR holds the
 * reasoning, and holds what would count as reversing it.
 *
 * **There is still no scroll-gate** (#31 AC 7). Nothing waits on scroll
 * position or on reading time: the Statement's disclosure opens with a click,
 * the children's section is editable from the first paint, and the gate below
 * reads answers and nothing else. What `hidden` does here is fold away things
 * that have nothing to say yet — a spare child row (#84), an error sentence, a
 * line of the still-needed list — never a section held back until something has
 * been scrolled through. A gate like that is a WCAG 2.2 AA hazard for the
 * keyboard and screen-reader users least able to work around it, and it buys no
 * evidence that anybody read anything. Read ADR-0009 before reading the greyed
 * button as this rule's reversal: it is one of three things that decision went
 * out of its way to leave alone.
 *
 * **Greyed, never `disabled`.** `aria-disabled` plus a greyed appearance, so the
 * button stays focusable and can explain itself: a keyboard or screen-reader
 * user reaches it, activates it, is told what is missing and is taken there.
 * `disabled` would remove it from the tab order and leave that user with a dead
 * control and no explanation — the same WCAG 2.2 AA hazard the no-gate rule is
 * about (ADR-0009).
 *
 * **Errors arrive while the family types, and nothing jumps to the top.** Each
 * field checks itself on blur — a radio or a checkbox on change, since there is
 * no half-made choice to interrupt — and re-checks on every keystroke once it
 * has already gone wrong. What has been left is tracked per *control* rather
 * than per rule (#90), so a family typing a second child's name is not told
 * about the age they have not reached yet. The still-needed list beside the
 * button is an `aria-live` region. A refused send — from the greyed button, or
 * from the server round trip a family with scripting off gets — puts focus on
 * the first outstanding control rather than depositing the family on a banner
 * five thousand words above the field that needs them.
 *
 * **How many children is a question, not a guess.** The family picks the number
 * from a dropdown and that many rows are shown; all eight are rendered and the
 * spare ones are `hidden` *and* `disabled`, so they neither clutter the page nor
 * post. The picker is the only script this page ships, and it is an enhancement
 * rather than a dependency: with scripting off every row is visible and the
 * count still changes — one "Check these choices" behind, because `child-count`
 * round-trips through the POST like everything else here.
 *
 * **The children's sensitive data does not enter this form** (#31 AC 9). Name,
 * age and the classes, and nothing else — no date of birth, no home address,
 * no allergies, no medical or evaluation history, no custody arrangement.
 * Those move to paper signed at enrolment, and `application.test.ts` reads this
 * file back and fails if a field named for any of them appears. ADR-0007 is
 * why, and what adding one back would cost.
 */
const db = await getDb();
const details = await getSchoolDetails(db);
const settings = await getMoneySettings(db);
const courses = await listCourses(db);
const offerings = offeringsOf(courses);

/*
 * The year the clash rule measures against.
 *
 * `getSchoolYear` is undefined only before the first migration seeds the row,
 * and the seeded year is exactly what that migration writes — so falling back
 * to it warns from the school's own published dates rather than going quiet.
 * Silence would be the worse failure: no warning reads as "no clash".
 */
const year = (await getSchoolYear(db)) ?? SEEDED_SCHOOL_YEAR;

/*
 * The two documents the family agrees to (#71), and only the ones with a file
 * behind them. `publishedPolicies` is the same filter the public policies page
 * uses — a policy that exists in the admin but has never been uploaded is a
 * title with nothing to download, and asking a family to agree to a link to
 * nothing is the failure this ticket names.
 */
const askable = askableAgreements(publishedPolicies(await listPolicies(db)));

/**
 * Every application, or none of them.
 *
 * The tally rides on an email, and a read that failed must not turn a stored
 * application into an error page for the family who just sent it. A
 * notification carrying an empty tally is a worse email; a 500 over a form this
 * long is a worse afternoon.
 */
const applicationsForTally = async () => {
  try {
    return await listApplications(db);
  } catch (cause) {
    console.error('[application] tally not read:', cause);
    return [];
  }
};

/**
 * How many child rows to show.
 *
 * UI state and nothing else. `child-count` posts and comes back so the picker
 * survives a check, but `parseApplication` never reads it — a child is still a
 * row with something in it, and the count cannot add one or take one away. A
 * missing field, a garbled one, or a count smaller than the rows actually
 * filled in all fall back to the children that are there: shrinking the form
 * must never be a way to silently drop a child somebody typed in.
 */
const childRows = (posted: FormDataEntryValue | null, filled: number): number => {
  const asked = Number(typeof posted === 'string' ? posted : NaN);
  return Math.min(MAX_CHILDREN, Math.max(Number.isInteger(asked) ? asked : 0, filled, 1));
};

let values: ApplicationFields;
let errors: ApplicationErrors = {};
let sentId: string | null = null;
let storeFailed = false;
let checked = false;
let rows: number;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const parsed = parseApplication(form, offerings, askable);
  const sending = form.get('intent') === 'send';

  values = parsed.values;
  rows = childRows(form.get('child-count'), values.children.length);
  checked = !sending;
  // A check is "did I pick two classes that collide", not "you forgot your
  // name". Reporting missing fields against a button that submits nothing is
  // an error message about a form the family is still filling in.
  errors = sending ? parsed.errors : {};

  if (sending && Object.keys(errors).length === 0) {
    /*
     * The fees this family applied at, frozen before the application is
     * written (ADR-0006). Its failure is swallowed the way the inquiry's
     * delivery stamp is: the application itself is the thing that must not be
     * lost, and a missing terms row is bookkeeping the school can reconstruct.
     */
    let agreed: MoneySettings | null = null;
    let agreedTermsId: string | null = null;
    try {
      const terms = await recordAgreedTerms(db, values.familyName, settings);
      agreed = terms;
      agreedTermsId = terms.id;
    } catch (cause) {
      console.error('[application] terms not frozen:', cause);
    }

    try {
      sentId = await createApplication(db, values, {
        statementVersion: statementVersion(),
        flagged: parsed.flagged,
        agreedTermsId,
      });
    } catch (cause) {
      // The operator's copy. The family is told plainly, and given the address
      // to write to, rather than shown a 500 over a form this long.
      console.error('[application] not stored:', cause);
      storeFailed = true;
    }

    /*
     * Telling the school (#32 AC 6), and telling the family.
     *
     * Both are attempted whether or not the row was written, which is the half
     * of "neither failure silently loses the other" that points outwards: a
     * refused write makes the school's email the only copy of the application,
     * and it says so — and it is what turns a refused submission into a family
     * who was told rather than one who finds out in September (AC 4).
     *
     * The figures are the ones frozen for this family a moment ago, so the
     * email quotes what they agreed to rather than what the settings say by the
     * time somebody opens it (ADR-0006).
     */
    const applied = agreed ?? settings;
    const submission = {
      values,
      cost: applicationCost(values, offerings, applied),
      settings: applied,
      // Read back including this application, so the count in the email is the
      // count Jill would see on the admin screen a second later — deduplicated,
      // never the raw number of rows.
      tally: classTally(await applicationsForTally(), offerings),
      flagged: parsed.flagged,
      reference: sentId,
    };

    // Spelled out rather than handed the whole of `import.meta.env` — see `MailEnv`.
    const mailer = configuredMailer({
      GMAIL_USER: import.meta.env.GMAIL_USER,
      GMAIL_APP_PASSWORD: import.meta.env.GMAIL_APP_PASSWORD,
      RESEND_API_KEY: import.meta.env.RESEND_API_KEY,
      MAIL_FROM: import.meta.env.MAIL_FROM,
    });

    const delivery = await deliverApplication(submission, {
      // The list the school keeps on its own Money screen, never an address in
      // this file (#32 AC 6).
      sender: mailer?.sender,
      to: settings.notificationAddresses,
      from: mailer?.from ?? '',
      postTo: details.address,
      schoolEmail: details.email.trim(),
      site: Astro.site?.toString() ?? SITE_URL,
    });

    if (sentId) await recordApplicationDelivery(db, sentId, delivery);

    // The operator's copy: a deployment whose notifications are silently
    // failing must not be discoverable only by opening the admin.
    if (delivery.notificationError) {
      console.error('[application] school not notified:', delivery.notificationError);
    }
    if (delivery.confirmationError) {
      console.error('[application] family not told:', delivery.confirmationError);
    }
  }
} else {
  /*
   * The prefill (#31 AC 1). `?inquiry=<id>` is the link Jill pastes into an
   * email; `getInquiry` already answers undefined for a stale id *and* for a
   * malformed one, so no link, a dead link and a link an email client wrapped
   * all land on the same clean slate.
   */
  const row = await getInquiry(db, Astro.url.searchParams.get('inquiry') ?? '');
  values = prefillFrom(row ? { name: row.name, email: row.email, ages: row.ages } : null);
  // "6, 9 and 13" on the inquiry opens the form on three, so the family sees
  // the number they already told us rather than being asked it twice.
  rows = childRows(null, values.children.length);
}

const rejected = Object.keys(errors).length > 0;

/**
 * What the form is still short of, whatever button was last pressed (#85).
 *
 * Deliberately *not* `errors`: `errors` is what the family is being told off
 * about, and a check must not tell anyone off. `outstanding` is what the gate
 * reads — the button's greyness and the still-needed list — and it is derived on
 * every render from the values in hand. There is no "checked" flag and no
 * "valid" flag anywhere on this page, which is why editing a class after a
 * passing check cannot leave the button lying about the form.
 *
 * The same function the browser calls on every keystroke, and the same one the
 * POST above already called. One rule set, three callers, no way to disagree.
 */
const outstanding = validateApplication(values, askable);
const incomplete = Object.keys(outstanding).length > 0;

/**
 * The still-needed list, in reading order.
 *
 * A greyed button with no list is a dead end. Each line links to the control it
 * is about, because on a document this long "a child needs an age" without a
 * link is an instruction to go hunting. Rendered whole and hidden line by line
 * so the browser has only to flip `hidden` — a server-raised line and a
 * browser-raised one are then the same element, not two spellings of one.
 */
const childAt = (index: number): ApplicationChild =>
  values.children[index] ?? { name: '', age: '', offeringKeys: [] };

/**
 * Which box on which child row a refused send should land in.
 *
 * The first *shown* row short of a name, else short of an age — the same walk
 * `FOCUS.children` makes in the browser, over the same rows: a row past the
 * count is `disabled`, posts nothing, and is skipped by both halves. Landing on
 * row 0 whatever the count would be the two paths disagreeing, and a family
 * whose second child has no age would be sent to their first child's filled-in
 * age box.
 */
const childNeeds = ((): { index: number; box: 'name' | 'age' } => {
  for (let index = 0; index < rows; index += 1) {
    const child = childAt(index);
    if (!child.name.trim()) return { index, box: 'name' };
    if (!child.age.trim()) return { index, box: 'age' };
  }
  return { index: 0, box: 'name' };
})();

/**
 * Where a refused send puts the family.
 *
 * The first outstanding field in reading order, focused on arrival, so the page
 * answers "you cannot send this yet" by showing them the thing rather than by
 * scrolling them to a banner. With scripting on the browser does this without a
 * round trip; this is the server's half, and the two land in the same place.
 *
 * The row goes with it because the class lists live inside the child rows, so
 * which row needs attention decides whether the classes are above it or below
 * (#88, `firstError`).
 */
const focus: ErrorField | null = rejected ? firstError(errors, childNeeds.index) : null;

/**
 * Which document a refused send should land on — the first one nobody has
 * answered, matching `FOCUS.agreements`. "Not answered" posts an empty value,
 * so an explicit "Not answered" and an untouched question are the same thing
 * here, exactly as the rules read them.
 */
const agreementNeeds = Math.max(
  askable.findIndex((document) => !agreementAnswer(values.agreements, document.slug)),
  0,
);

const NEEDED: { field: ErrorField; href: string; label: string }[] = [
  { field: 'faith', href: '#apply-faith', label: 'One parent or guardian’s answers to the three questions' },
  { field: 'familyName', href: '#apply-family-name', label: 'Your family name' },
  { field: 'email', href: '#apply-email', label: 'An email address we can reply to' },
  {
    field: 'children',
    href: `#apply-child-${childNeeds.index}-${childNeeds.box}`,
    label: 'Each child’s name and their age',
  },
  { field: 'classes', href: '#apply-classes', label: 'At least one class, for one child' },
  { field: 'agreements', href: '#apply-agreements', label: 'Who agrees to each of the documents' },
];

const cost = applicationCost(values, offerings, settings);
const clashing = familyClashes(values, offerings, year);
const clashCount = clashing.reduce((sum, one) => sum + one.clashes.length, 0);

/**
 * Who a warning is about. The name the family typed, or their place in the form
 * — a family often picks classes before they finish typing names, and "your
 * second child" is still an address.
 */
const ORDINALS = ['first', 'second', 'third', 'fourth', 'fifth', 'sixth', 'seventh', 'eighth'];
const childLabel = (child: ApplicationChild, index: number): string =>
  child.name.trim() || `Your ${ORDINALS[index] ?? `${index + 1}th`} child`;

const stage = (id: string): string =>
  APPLICATION_STAGES.find((one) => one.id === id)?.title ?? '';

const description =
  'Apply to Pharos Academy — what we believe, the classes your children would take, and what to post.';
---

<BaseLayout details={details} title="Apply to Pharos" description={description}>
  <section class="band band-quiet" data-section="apply-header">
    <div class="wide">
      <p class="label">Applying</p>
      <h1 class="mt-4">Your application</h1>
      <p class="sub mt-5">
        All of it on one page: what we believe, the classes you are choosing, the documents families
        sign, what to post, and sending it. Nothing here is a test — the questions about what we
        believe exist so we can talk, not so we can turn anyone away.
      </p>

      {
        sentId && (
          <p class="notice mt-7" data-outcome="received" role="status">
            Your application is with us. Reference {sentId}.
          </p>
        )
      }

      {
        storeFailed && (
          <p class="notice mt-7" data-outcome="failed" role="status">
            Something went wrong at our end and your application was not saved. Nothing was lost
            from the form below — please try again, or send it to {details.email} and we will enter
            it ourselves.
          </p>
        )
      }

      {
        rejected && (
          <p class="notice mt-7" data-outcome="failed" role="status">
            Nothing was sent — the fields below need fixing first.
          </p>
        )
      }

      {
        checked && (
          <p class="notice mt-7" data-outcome="checked" role="status">
            {clashCount === 0
              ? 'Nothing in that selection collides. The totals below are what you would post.'
              : 'Have a look at the warnings under Choosing classes before you send this.'}
          </p>
        )
      }
    </div>
  </section>

  {
    sentId ? (
      <section class="band" id="confirmation" data-section="apply-confirmation">
        <div class="wide">
          <h2>{stage('confirmation')}</h2>
          <p class="sub mt-4">
            We have your application for {values.familyName}, and we will be in touch. A place is
            held for each class as soon as your check reaches us.
          </p>

          <h3 class="mt-8">What you chose</h3>
          <ul class="chosen mt-4">
            {cost.perChild
              .filter((one) => one.child.name || one.offerings.length > 0)
              .map((one) => (
                <li>
                  <strong>{one.child.name || 'A child'}</strong>
                  {one.child.age && <span class="detail">age {one.child.age}</span>}
                  <ul class="picked">
                    {one.offerings.length === 0 ? (
                      <li>No classes chosen yet.</li>
                    ) : (
                      one.offerings.map((offering) => <li>{offeringTitle(offering)}</li>)
                    )}
                  </ul>
                </li>
              ))}
          </ul>

          <h3 class="mt-8">What to post</h3>
          <p class="mt-4">
            A check for <strong>{formatMoney(cost.total.dueNow)}</strong> — that is{' '}
            {formatMoney(cost.total.registration)} in registration and{' '}
            {formatMoney(cost.total.deposits)} in deposits — made out to Pharos Academy, to:
          </p>
          <p class="address mt-4">{details.address}</p>
          <p class="mt-6 text-ink-2">
            Tuition is paid to your instructors, not to the school:{' '}
            {formatMoney(cost.total.dueToInstructors)} across the year at today's rates.
          </p>

          <p class="mt-8">
            <a class="btn" href="/classes">See the classes again</a>{' '}
            <a class="btn" href={BELIEFS_PATH}>Read what we believe</a>
          </p>
        </div>
      </section>
    ) : (
      <form method="post" novalidate data-application-form>
        <section class="band" id="faith" data-section="apply-faith">
          <div class="wide">
            <h2>{stage('faith')}</h2>
            <p class="sub mt-4">{BELIEFS_CLOSING}</p>
            <p class="mt-5">
              <a href={BELIEFS_PATH}>Our Statement of Faith and Practice in full</a> — the same
              eleven articles are below, so you can read them without leaving this page.
            </p>

            {/*
              A disclosure, not a gate. It opens with a click or with the
              keyboard, it is open to anyone who wants it, and nothing on this
              page waits on it: no field is hidden until it has been scrolled
              through, and leaving these articles unopened costs a family
              nothing (#31 AC 7). Send is greyed until the questions *below* are
              answered (#85) — never until this is opened.
            */}
            <details class="statement mt-6">
              <summary>Read the eleven articles here</summary>
              <ol class="articles mt-5">
                {BELIEFS_ARTICLES.map((article) => (
                  <li>{article}</li>
                ))}
              </ol>
            </details>

            <p class="mt-7 text-ink-2">
              We ask each parent or guardian separately, because a household where one of you is
              not sure is exactly the conversation these questions exist to start. Leave a column
              alone if it does not apply to your family — an unanswered question is not a "no".
            </p>

            <div class="faith mt-7" id="apply-faith" data-faith-grid>
              {FAITH_QUESTIONS.map((question, row) => (
                <fieldset class="question">
                  <legend>{question.text}</legend>
                  <div class="respondents">
                    {FAITH_RESPONDENTS.map((respondent, column) => (
                      <fieldset class="respondent">
                        <legend>{respondent}</legend>
                        {(
                          [
                            { value: 'yes', label: 'Yes' },
                            { value: 'no', label: 'No' },
                            { value: '', label: 'Not answered' },
                          ] as const
                        ).map((choice, choiceAt) => (
                          <label class="check">
                            <input
                              type="radio"
                              name={faithKey(respondent, question.id)}
                              value={choice.value}
                              checked={
                                faithAnswer(values.faith, respondent, question.id) === choice.value
                              }
                              aria-describedby={errors.faith ? 'apply-faith-error' : undefined}
                              autofocus={
                                focus === 'faith' && row === 0 && column === 0 && choiceAt === 0
                              }
                            />
                            <span>{choice.label}</span>
                          </label>
                        ))}
                      </fieldset>
                    ))}
                  </div>
                </fieldset>
              ))}
            </div>

            {/*
              One column, and never a verdict on what is in it (#85). The grid is
              incomplete until some one respondent has answered all three; which
              respondent, and what they answered, is not this page's business.
            */}
            <p class="error mt-5" id="apply-faith-error" hidden={!errors.faith}>
              {errors.faith}
            </p>

            <div class="field mt-7">
              <label for="apply-objections">
                Anything you disagree with, or want to talk about (optional)
              </label>
              <textarea id="apply-objections" name="objections">{values.objections}</textarea>
              <p class="hint" id="apply-objections-hint">
                Writing something here does not stop your application. It routes it to a
                conversation with us, which is what we would rather have.
              </p>
            </div>
          </div>
        </section>

        <section class="band band-quiet" id="classes" data-section="apply-classes">
          <div class="wide">
            <h2>{stage('classes')}</h2>
            <p class="sub mt-4">
              Who is applying, and what they would take. Only the classes we are actually enrolling
              are listed.
            </p>

            <div class="form mt-7">
              <div>
                <label for="apply-family-name">Family name</label>
                <input
                  id="apply-family-name"
                  name="familyName"
                  autocomplete="family-name"
                  value={values.familyName}
                  aria-describedby={errors.familyName ? 'apply-family-name-error' : undefined}
                  aria-invalid={errors.familyName ? 'true' : undefined}
                  autofocus={focus === 'familyName'}
                />
                <p class="error" id="apply-family-name-error" hidden={!errors.familyName}>
                  {errors.familyName}
                </p>
              </div>

              <div>
                <label for="apply-email">Email</label>
                <input
                  id="apply-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  value={values.email}
                  aria-describedby={errors.email ? 'apply-email-error' : undefined}
                  aria-invalid={errors.email ? 'true' : undefined}
                  autofocus={focus === 'email'}
                />
                <p class="error" id="apply-email-error" hidden={!errors.email}>
                  {errors.email}
                </p>
              </div>
            </div>

            {/*
              Rendered whether or not they say anything, and hidden when they do
              not. The browser flips `hidden` and writes the sentence, so an
              error raised while the family types is the same element a refused
              POST fills in — indistinguishable to a screen reader, which is the
              point.
            */}
            <p class="error mt-6" id="apply-children-error" hidden={!errors.children}>
              {errors.children}
            </p>
            <p class="error mt-4" id="apply-classes-error" hidden={!errors.classes}>
              {errors.classes}
            </p>

            {/*
              The count, above the rows it governs.

              Eight rows are always rendered and the spare ones carry both
              `hidden` and `disabled` — `hidden` so the page is not eight copies
              of a picker carrying every offering the school sells, `disabled`
              so a row nobody is applying for posts nothing, costs nothing and
              clashes with nothing. Raising the count again finds whatever was
              typed in the row still sitting there — until the next POST, which
              carries back only the children the family is applying for.
            */}
            <div class="field count mt-8">
              <label for="apply-child-count">How many children are you applying for?</label>
              <select id="apply-child-count" name="child-count" data-child-count>
                {Array.from({ length: MAX_CHILDREN }, (_unused, index) => index + 1).map(
                  (count) => (
                    <option value={String(count)} selected={count === rows}>
                      {count}
                    </option>
                  ),
                )}
              </select>
              <p class="hint">
                Change it whenever you like. Lowering it hides the rows you are not using, and
                only the children you are applying for are sent to us.
              </p>
            </div>

            {Array.from({ length: MAX_CHILDREN }, (_unused, index) => index).map((index) => (
              <fieldset
                class="child mt-8"
                data-child-row={index}
                hidden={index >= rows}
                disabled={index >= rows}
              >
                <legend>Child {index + 1}</legend>
                <div class="form">
                  <div>
                    <label for={`apply-child-${index}-name`}>Name</label>
                    <input
                      id={`apply-child-${index}-name`}
                      name={`child-${index}-name`}
                      value={childAt(index).name}
                      aria-describedby={errors.children ? 'apply-children-error' : undefined}
                      autofocus={
                        focus === 'children' &&
                        index === childNeeds.index &&
                        childNeeds.box === 'name'
                      }
                    />
                  </div>
                  <div>
                    <label for={`apply-child-${index}-age`}>Age</label>
                    <input
                      id={`apply-child-${index}-age`}
                      name={`child-${index}-age`}
                      inputmode="numeric"
                      value={childAt(index).age}
                      aria-describedby={errors.children ? 'apply-children-error' : undefined}
                      autofocus={
                        focus === 'children' &&
                        index === childNeeds.index &&
                        childNeeds.box === 'age'
                      }
                    />
                  </div>
                </div>

                <fieldset class="picker mt-6" id={index === 0 ? 'apply-classes' : undefined}>
                  <legend>Classes for this child</legend>
                  {offerings.length === 0 ? (
                    <p class="hint">
                      Nothing is open for enrollment at the moment. Please{' '}
                      <a href={INQUIRY_PATH}>write to us</a> and we will tell you when it is.
                    </p>
                  ) : (
                    <ul class="offerings">
                      {offerings.map((offering, at) => (
                        <li>
                          <label class="check">
                            <input
                              type="checkbox"
                              name={`child-${index}-classes`}
                              value={offeringKey(offering)}
                              checked={childAt(index).offeringKeys.includes(offeringKey(offering))}
                              aria-describedby={errors.classes ? 'apply-classes-error' : undefined}
                              autofocus={focus === 'classes' && index === 0 && at === 0}
                            />
                            <span>
                              <strong>{offeringTitle(offering)}</strong>
                              <span class="blurb">
                                {offering.course.days.join(' and ')},{' '}
                                {timeLabel(offering.course.start, offering.course.end)}
                              </span>
                            </span>
                          </label>
                        </li>
                      ))}
                    </ul>
                  )}
                </fieldset>
              </fieldset>
            ))}

            {/*
              The clash warnings (#31 AC 3, 4, 5). Warnings and never a block:
              a family may have a reason, and the school would rather they made
              the choice knowing. #85 did not change that — the gate reads
              whether the questions were answered and never what the timetable
              says, so no clash has ever greyed the button. The "you can send
              this anyway" below is about the clash, not about the gate.
              The Wednesday 10:40 slot's five electives
              produce nothing here unless *one child* selects two of them —
              grouped per child, because siblings in two rooms at one time is
              not a clash and must never be reported as one.
            */}
            <div class="warnings mt-8" data-clashes={clashCount} role="status">
              {clashing.length > 0 && (
                <>
                  <h3>Some of these do not fit together</h3>
                  {clashing.map(({ child, index, clashes }) => (
                    <div class="mt-4" data-child-clashes={index}>
                      <p><strong>{childLabel(child, index)}</strong></p>
                      <ul class="mt-2">
                        {clashes.map((clash) => (
                          <li data-severity={clash.severity}>{clashSentence(clash)}</li>
                        ))}
                      </ul>
                    </div>
                  ))}
                  <p class="mt-4 text-ink-2">
                    You can send this anyway — nothing here stops you. We would rather sort it out
                    with you before term than after.
                  </p>
                </>
              )}
            </div>
          </div>
        </section>

        {/*
          The two agreements (#71). Rendered only for documents the school has
          actually published: the section disappears rather than asking a family
          to agree to a link to nothing.

          The links go to each policy's *fixed* address, because a family reads
          the current document. The version they were shown travels in a hidden
          field's stead — it is on `askable`, and the parser records it — so what
          this family agreed to survives the next upload.

          Since #85 an *asked* question has to be answered before the
          application can be sent — and that is a requirement to answer, never a
          requirement to agree. All three choices pass, "Neither agrees"
          included. A document the school has not published produces no question
          and no requirement, so the gate can never be about something a family
          was not shown.
        */}
        {askable.length > 0 && (
          <section class="band" id="agreements" data-section="apply-agreements">
            <div class="wide">
              <h2>{stage('agreements')}</h2>
              <p class="sub mt-4">
                Two documents families sign. Read them here — they open in full — and tell us who
                agrees. We need an answer to each, and any of them will do: "Neither agrees" is a
                real answer rather than a problem, and none of them stops your application.
              </p>

              <div class="faith mt-7" id="apply-agreements" data-agreements>
                {askable.map((document, at) => (
                  <fieldset class="question" data-agreement={document.slug}>
                    <legend>{document.question}</legend>
                    <p class="hint">
                      <a href={agreementHref(document.slug)}>Read the {document.title}</a> — the
                      version published today.
                    </p>
                    <div class="mt-4">
                      {[...AGREEMENT_CHOICES, { value: '', label: 'Not answered' } as const].map(
                        (choice, choiceAt) => (
                          <label class="check">
                            <input
                              type="radio"
                              name={agreementKey(document.slug)}
                              value={choice.value}
                              checked={
                                agreementAnswer(values.agreements, document.slug) === choice.value
                              }
                              aria-describedby={
                                errors.agreements ? 'apply-agreements-error' : undefined
                              }
                              autofocus={
                                focus === 'agreements' && at === agreementNeeds && choiceAt === 0
                              }
                            />
                            <span>{choice.label}</span>
                          </label>
                        ),
                      )}
                    </div>
                  </fieldset>
                ))}
              </div>

              <p class="error mt-5" id="apply-agreements-error" hidden={!errors.agreements}>
                {errors.agreements}
              </p>
            </div>
          </section>
        )}

        <section class="band band-quiet" id="payment" data-section="apply-payment">
          <div class="wide">
            <h2>{stage('payment')}</h2>
            <p class="sub mt-4">
              Every figure here comes from the school's current fee settings, and it changes when
              they do.
            </p>

            <ul class="totals mt-7">
              <li>
                <span class="amount">{formatMoney(cost.total.registration)}</span>
                <span>Registration — once per student, not refundable</span>
              </li>
              <li>
                <span class="amount">{formatMoney(cost.total.deposits)}</span>
                <span>Deposits — one per class, holding the seats</span>
              </li>
              <li class="due">
                <span class="amount">{formatMoney(cost.total.dueNow)}</span>
                <span>The check you post with this application</span>
              </li>
              <li>
                <span class="amount">{formatMoney(cost.total.dueToInstructors)}</span>
                <span>
                  Tuition, paid to your instructors across the year
                  {cost.total.creditedAgainstTuition > 0 &&
                    ` — the deposits come off this, ${formatMoney(cost.total.creditedAgainstTuition)} of it`}
                </span>
              </li>
            </ul>

            <p class="mt-7">Make the check out to Pharos Academy and post it to:</p>
            <p class="address mt-4">{details.address}</p>

            {/*
              The payment slot, designed in and deliberately empty (#31). There
              is no provider here and no card field. When one lands, the only
              thing that changes for a family is that this paragraph offers a
              second way to pay — and the only thing that changes in the row is
              that the next submission reads "paid online" rather than
              "awaiting check".
            */}
            <p class="mt-6 text-ink-2">
              There is no way to pay online yet. When there is, it will appear here, and posting a
              check will still work.
            </p>
          </div>
        </section>

        <section class="band" id="confirmation" data-section="apply-send">
          <div class="wide">
            <h2>{stage('confirmation')}</h2>
            <p class="sub mt-4">
              Check what you have chosen first if you would like to — it saves nothing and sends
              nothing. When you send it, we will read it and be in touch.
            </p>

            <p class="mt-7">
              <button class="btn" type="submit" name="intent" value="check">
                Check these choices
              </button>{' '}
              {/*
                Greyed with `aria-disabled`, never with `disabled` (#85). It
                stays in the tab order and it stays activatable, because a
                keyboard or screen-reader user who reaches it must be told what
                is missing and taken there rather than handed a dead control.
                With scripting off it submits, and the server says the same
                thing by round trip.
              */}
              <button
                class="btn solid"
                type="submit"
                name="intent"
                value="send"
                aria-disabled={incomplete ? 'true' : undefined}
                aria-describedby="apply-missing"
                data-send
              >
                Send the application
              </button>
            </p>

            {/*
              What the greyed button would say if it could talk. Polite rather
              than assertive: it changes on every keystroke while a family types
              their email, and an assertive region would interrupt them mid-word.
            */}
            <div class="missing mt-6" id="apply-missing" aria-live="polite" data-missing>
              <p data-missing-intro hidden={!incomplete}>Still needed before you can send this:</p>
              <ul>
                {NEEDED.map((one) => (
                  <li data-missing-for={one.field} hidden={!outstanding[one.field]}>
                    <a href={one.href}>{one.label}</a>
                  </li>
                ))}
              </ul>
              <p data-missing-done hidden={incomplete}>
                That is everything we need. You can send this whenever you are ready.
              </p>
            </div>

            <p class="mt-6 text-ink-2">
              Not ready? <a href={INQUIRY_PATH}>Ask us a question instead</a> — we would far rather
              answer one now than have you find the answer halfway through this.
            </p>
          </div>
        </section>
      </form>
    )
  }
</BaseLayout>

<script>
  /*
    The client behaviour on this page: the count picker, and the gate (#85).

    Both are enhancements and neither is a dependency. With scripting off the
    server sets every `hidden` and `disabled` on the way out, applies the same
    rules on POST, and lands focus on the same first outstanding control — so
    what this file buys a family is *when* they are told, never *whether*.

    The rules themselves are imported rather than restated. `validation.ts` is a leaf
    for this reason: importing `application.ts` here would ship the Statement of
    Faith text, the catalogue, the clash rule and the money graph to a browser
    that only needs to notice an empty box.
  */
  import type {
    AgreementAnswer,
    AgreementSlug,
    Agreements,
  } from '../../lib/application/agreements.js';
  import {
    ERROR_FIELDS,
    FAITH_QUESTIONS,
    FAITH_RESPONDENTS,
    faithKey,
    firstError,
    validateApplication,
    type ApplicationChild,
    type ApplicationErrors,
    type ApplicationFields,
    type ErrorField,
    type FaithAnswers,
  } from '../../lib/application/validation.js';

  const found = document.querySelector<HTMLFormElement>('form[data-application-form]');

  if (found) {
    // Bound once, non-null, so every closure below can say `form` without
    // re-asserting that a page with a confirmation on it has one.
    const form: HTMLFormElement = found;

    const picker = form.querySelector<HTMLSelectElement>('select[data-child-count]');
    const rows = [...form.querySelectorAll<HTMLFieldSetElement>('fieldset[data-child-row]')];
    const send = form.querySelector<HTMLButtonElement>('button[data-send]');
    const missing = form.querySelector<HTMLElement>('[data-missing]');

    /*
      The documents the page actually asked about. Read off the rendered
      questions rather than passed in, so the browser's rule and the server's
      are looking at the same form: a policy with nothing published produces no
      question here, and therefore no requirement.
    */
    const asked = [...form.querySelectorAll<HTMLElement>('[data-agreement]')].map((question) => ({
      slug: question.dataset.agreement as AgreementSlug,
    }));

    /**
      Which *controls* the family has finished with, by the name they post under.

      A control is checked once they have left it — or, for a radio or a
      checkbox, the moment it changes, since there is no half-made choice to
      interrupt — and re-checked on every keystroke after that. Before that it
      says nothing: a form that reports an empty family name while somebody is
      still typing the first letter of it is a form that feels like an argument.

      **Controls and not rules**, because the children's rule is one rule over
      eight rows (#90). A family who has finished the first child has left that
      rule, and revealing it rule-wide would shout "Second needs an age" at the
      second child's *name* box, mid-word, before they have reached the age box
      at all. `reveals` below is where the difference is spent.

      Which is why "every section with something outstanding carries its own
      note" (#89) is true from the moment a family has been anywhere near that
      section — but not true of a form nobody has touched yet. The still-needed
      list beside the button is the one that is complete from the first paint,
      and it is the one a family reads before they have started.
    */
    const touched = new Set<string>();

    /**
      Every section at once, from the moment the greyed button is activated.

      A family who has asked to send has asked for the whole answer, and #89's
      "every section carries its own note" is true of every section from then
      on. It never goes back to false: having been told, a family is not
      untold.
    */
    let revealAll = false;

    /*
      Where each error's sentence goes, and who points at it.

      The same elements the server fills in, so an error raised while the family
      types and one raised by a refused POST are the same thing to a screen
      reader. `invalid` is set only where the server sets it.
    */
    const enabledRow = 'fieldset[data-child-row]:not([disabled])';
    const WIRING: Record<ErrorField, { error: string; describes: string; invalid?: string }> = {
      faith: { error: 'apply-faith-error', describes: '[data-faith-grid] input' },
      familyName: {
        error: 'apply-family-name-error',
        describes: '#apply-family-name',
        invalid: '#apply-family-name',
      },
      email: { error: 'apply-email-error', describes: '#apply-email', invalid: '#apply-email' },
      children: {
        error: 'apply-children-error',
        describes: `${enabledRow} input[name$="-name"], ${enabledRow} input[name$="-age"]`,
      },
      classes: {
        error: 'apply-classes-error',
        describes: `${enabledRow} input[name$="-classes"]`,
      },
      agreements: { error: 'apply-agreements-error', describes: '[data-agreements] input' },
    };

    /** The control a refused send should land on, per field. */
    const FOCUS: Record<ErrorField, () => HTMLElement | null> = {
      faith: () => form.querySelector('[data-faith-grid] input'),
      familyName: () => form.querySelector('#apply-family-name'),
      email: () => form.querySelector('#apply-email'),
      children: () => {
        for (const row of visibleRows()) {
          const name = row.querySelector<HTMLInputElement>('input[name$="-name"]');
          const age = row.querySelector<HTMLInputElement>('input[name$="-age"]');
          if (!name?.value.trim()) return name;
          if (!age?.value.trim()) return age;
        }
        return null;
      },
      classes: () => visibleRows()[0]?.querySelector('input[name$="-classes"]') ?? null,
      agreements: () => {
        for (const { slug } of asked) {
          const question = form.querySelector<HTMLElement>(`[data-agreement="${slug}"]`);
          if (!answerIn(question)) return question?.querySelector('input') ?? null;
        }
        return null;
      },
    };

    const visibleRows = (): HTMLFieldSetElement[] => rows.filter((row) => !row.disabled);

    /**
     * Which shown row the children rule is about — `childNeeds.index` on the
     * server, over the same rows. `firstError` needs it to know whether the
     * class lists are above that row or below it (#88).
     */
    const childRow = (): number => {
      const shown = visibleRows();
      const at = shown.findIndex((row) => {
        const name = row.querySelector<HTMLInputElement>('input[name$="-name"]');
        const age = row.querySelector<HTMLInputElement>('input[name$="-age"]');
        return !name?.value.trim() || !age?.value.trim();
      });
      return Math.max(at, 0);
    };

    const answerIn = (scope: HTMLElement | null): string =>
      scope?.querySelector<HTMLInputElement>('input:checked')?.value ?? '';

    const valueOf = (selector: string): string =>
      form.querySelector<HTMLInputElement | HTMLTextAreaElement>(selector)?.value.trim() ?? '';

    /**
      The form as the rules see it — the same shape `parseApplication` builds.

      A hidden row is a row that is not there, exactly as it is on the server: it
      carries `disabled` as well as `hidden`, it posts nothing, and it is skipped
      here. So lowering the count cannot leave stale text blocking a send, and
      raising it again brings the row back under the rule from that moment.
    */
    function read(): ApplicationFields {
      const children: ApplicationChild[] = [];
      for (const row of visibleRows()) {
        const name = row.querySelector<HTMLInputElement>('input[name$="-name"]')?.value.trim() ?? '';
        const age = row.querySelector<HTMLInputElement>('input[name$="-age"]')?.value.trim() ?? '';
        const offeringKeys = [
          ...row.querySelectorAll<HTMLInputElement>('input[name$="-classes"]:checked'),
        ].map((box) => box.value);

        if (name || age || offeringKeys.length > 0) children.push({ name, age, offeringKeys });
      }

      const faith: FaithAnswers = {};
      for (const respondent of FAITH_RESPONDENTS) {
        for (const question of FAITH_QUESTIONS) {
          const key = faithKey(respondent, question.id);
          const chosen =
            form.querySelector<HTMLInputElement>(`input[name="${key}"]:checked`)?.value ?? '';
          // "Not answered" is a real radio on this grid, and it posts an empty
          // value. Empty is unanswered and is never read as a "no".
          faith[key] = chosen === 'yes' || chosen === 'no' ? chosen : '';
        }
      }

      const agreements: Agreements = {};
      for (const { slug } of asked) {
        const answer = answerIn(form.querySelector(`[data-agreement="${slug}"]`));
        // The version is the server's to record; the rule only asks whether
        // anything was answered at all.
        if (answer !== '') agreements[slug] = { answer: answer as AgreementAnswer, version: null };
      }

      return {
        familyName: valueOf('#apply-family-name'),
        email: valueOf('#apply-email'),
        children,
        faith,
        objections: valueOf('#apply-objections'),
        agreements,
      };
    }

    /** Show or clear one field's sentence, and the wiring that points at it. */
    function paint(field: ErrorField, message: string | undefined): void {
      const wiring = WIRING[field];
      const paragraph = document.getElementById(wiring.error);
      if (paragraph) {
        paragraph.textContent = message ?? '';
        paragraph.hidden = message === undefined;
      }

      for (const control of form.querySelectorAll(wiring.describes)) {
        if (message === undefined) control.removeAttribute('aria-describedby');
        else control.setAttribute('aria-describedby', wiring.error);
      }

      const invalid = wiring.invalid ? form.querySelector(wiring.invalid) : null;
      if (message === undefined) invalid?.removeAttribute('aria-invalid');
      else invalid?.setAttribute('aria-invalid', 'true');
    }

    /**
      Re-derive everything from the form as it stands.

      Nothing is remembered between renders except which fields have been left
      once. There is no "valid" flag to go stale, which is why changing a class
      after a passing check cannot leave the button saying something the form no
      longer supports.
    */
    function render(): ApplicationErrors {
      const errors = validateApplication(read(), asked);
      const incomplete = Object.keys(errors).length > 0;

      if (send) {
        if (incomplete) send.setAttribute('aria-disabled', 'true');
        else send.removeAttribute('aria-disabled');
      }

      for (const field of ERROR_FIELDS) {
        const shown = reveals(field) ? errors[field] : undefined;
        paint(field, shown);

        const item = missing?.querySelector<HTMLElement>(`[data-missing-for="${field}"]`);
        if (item) item.hidden = errors[field] === undefined;
      }

      /*
        The children line names a row, so it has to move as the rows do.
        The server points it at the row it would focus; here that row can
        change on a keystroke, and a link to a box the family already filled in
        is the hunt the list exists to save them.
      */
      const childLink = missing?.querySelector<HTMLAnchorElement>(
        '[data-missing-for="children"] a',
      );
      const childTarget = FOCUS.children();
      if (childLink && childTarget?.id) childLink.href = `#${childTarget.id}`;

      const intro = missing?.querySelector<HTMLElement>('[data-missing-intro]');
      const done = missing?.querySelector<HTMLElement>('[data-missing-done]');
      if (intro) intro.hidden = !incomplete;
      if (done) done.hidden = incomplete;

      return errors;
    }

    /** Which rule a control belongs to, from the name it posts under. */
    function fieldOf(name: string): ErrorField | null {
      if (name.startsWith('faith-')) return 'faith';
      if (name.startsWith('agreement-')) return 'agreements';
      if (name === 'familyName') return 'familyName';
      if (name === 'email') return 'email';
      if (name.endsWith('-classes')) return 'classes';
      if (/^child-\d+-(name|age)$/.test(name)) return 'children';
      return null;
    }

    /**
      Whether this rule's sentence has been earned yet.

      Every rule but one is earned by any of its controls: the family answered a
      faith cell, or left the email box, and the rule that cell or box belongs to
      may speak. The children's rule is earned by the one *box* its sentence is
      about, because that rule is one rule over sixteen boxes: "Second needs an
      age" is about the age box, so tabbing out of the name box beside it has
      not earned it — the family is standing in the empty age box, having typed
      nothing into it yet, which is the moment story 6 is about.
    */
    function reveals(field: ErrorField): boolean {
      if (revealAll) return true;
      if (field === 'children') {
        const row = childRow();
        const named = form.querySelector<HTMLInputElement>(`#apply-child-${row}-name`)?.value.trim();
        // A row with a name is short of an age, and vice versa — the same
        // reading `validateApplication` and `FOCUS.children` make of it.
        return touched.has(`child-${row}-${named ? 'age' : 'name'}`);
      }
      return [...touched].some((name) => fieldOf(name) === field);
    }

    const check = (event: Event): void => {
      const name = (event.target as Element | null)?.getAttribute('name') ?? '';
      if (fieldOf(name)) touched.add(name);
      render();
    };

    // Leaving a field checks it; a radio or a checkbox is answered the moment it
    // changes, so there is nothing to wait for. A keystroke re-checks whatever
    // has already been checked and nothing else.
    form.addEventListener('blur', check, true);
    form.addEventListener('change', check);
    form.addEventListener('input', () => void render());

    /*
      The count picker.

      It moves `hidden` and `disabled` together, never one without the other: a
      row that is out of sight but still posting would put a child on the
      application the family cannot see, and one that is disabled but still
      visible would silently ignore what they typed into it. A row appearing or
      disappearing changes what the rules can see, so the gate is re-derived with
      it.
    */
    picker?.addEventListener('change', () => {
      const wanted = Number(picker.value);
      for (const row of rows) {
        const spare = Number(row.dataset.childRow) >= wanted;
        row.hidden = spare;
        row.disabled = spare;
      }
      render();
    });

    /*
      The greyed button explains itself.

      `aria-disabled` does not stop a click, which is the whole reason it was
      chosen: the family reaches the button, activates it, is shown everything
      that is missing and is put on the first of it. A `disabled` button would
      have said nothing and could not have been reached at all.
    */
    send?.addEventListener('click', (event) => {
      if (send.getAttribute('aria-disabled') !== 'true') return;
      event.preventDefault();

      revealAll = true;
      const first = firstError(render(), childRow());
      const target = first ? FOCUS[first]() : null;
      target?.focus();
      target?.scrollIntoView({ block: 'center', behavior: 'smooth' });
    });

    render();

    /*
      The enhancement is live.

      A module script is deferred, so for a moment after the page paints the
      form is the server's form: the count picker is a round trip and the gate
      is whatever the last render decided. That is a correct page and not a
      broken one — but it is a *different* page, and a test that clicks into the
      window between the two is testing neither. The marker says which one is on
      screen.
    */
    form.setAttribute('data-enhanced', '');
  }
</script>

