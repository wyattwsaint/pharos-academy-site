---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { BELIEFS_ARTICLES, BELIEFS_CLOSING, BELIEFS_PATH } from '../../lib/about/beliefs.js';
import { getSchoolDetails } from '../../lib/admin/school-details.js';
import {
  APPLICATION_STAGES,
  applicationCost,
  FAITH_QUESTIONS,
  FAITH_RESPONDENTS,
  faithAnswer,
  faithKey,
  familyClashes,
  MAX_CHILDREN,
  parseApplication,
  prefillFrom,
  statementVersion,
  type ApplicationChild,
  type ApplicationErrors,
  type ApplicationFields,
} from '../../lib/application/application.js';
import {
  AGREEMENT_CHOICES,
  agreementAnswer,
  agreementHref,
  agreementKey,
  askableAgreements,
} from '../../lib/application/agreements.js';
import {
  clashSentence,
  offeringKey,
  offeringsOf,
  title as offeringTitle,
} from '../../lib/application/offerings.js';
import { deliverApplication } from '../../lib/application/notices.js';
import {
  createApplication,
  listApplications,
  recordApplicationDelivery,
} from '../../lib/application/store.js';
import { classTally } from '../../lib/application/tally.js';
import { resendSender } from '../../lib/backup/monthly.js';
import { SITE_URL } from '../../lib/site.js';
import { getSchoolYear } from '../../lib/calendar/store.js';
import { SEEDED_SCHOOL_YEAR } from '../../lib/calendar/year.js';
import { timeLabel } from '../../lib/courses/schedule.js';
import { listCourses } from '../../lib/courses/store.js';
import { getDb } from '../../lib/db/client.js';
import { INQUIRY_PATH } from '../../lib/inquiry/inquiry.js';
import { getInquiry } from '../../lib/inquiry/store.js';
import { formatMoney, type MoneySettings } from '../../lib/money/settings.js';
import { getMoneySettings, recordAgreedTerms } from '../../lib/money/store.js';
import { publishedPolicies } from '../../lib/policies/policy.js';
import { listPolicies } from '../../lib/policies/store.js';

/**
 * The family's application (#31).
 *
 * Stages on one long document — the Statement of Faith, the classes, the two
 * agreements a family signs (#71), what to post, and sending it — with the
 * `APPLICATION_STAGES` ids as anchors. One
 * page rather than a stepped flow because the entry point is warm: a family
 * reaches this from a conversation and from a link Jill pasted into an email,
 * so the abandonment argument that favours splitting is weak, and headed
 * sections keep a stepped variant a CSS decision rather than a rebuild.
 *
 * `prerender = false`, because the form posts here and because the page is
 * pre-filled from *one family's* inquiry: a cached copy would show the next
 * family the last one's name and email.
 *
 * **Two buttons, not one.** "Check these choices" re-renders the warnings and
 * the totals and writes nothing; "Send the application" writes the row. A
 * clash is a warning and never a block (#31 AC 3–5), so the family has to be
 * able to see it *before* they commit — a page that only ever warns on the way
 * out is a page that tells a family about a $280 collision after they have
 * posted the cheque.
 *
 * **There is no scroll-gate** (#31 AC 7) and nothing here could implement one:
 * no submit is disabled, nothing is behind an `overflow` container, and the
 * Statement's disclosure opens with a click rather than with a scroll to the
 * bottom. A gate is a WCAG 2.2 AA hazard for keyboard and screen-reader users
 * that buys no evidence anybody read anything.
 *
 * **The children's sensitive data does not enter this form** (#31 AC 9). Name,
 * age and the classes, and nothing else — no date of birth, no home address,
 * no allergies, no medical or evaluation history, no custody arrangement.
 * Those move to paper signed at enrolment, and `application.test.ts` reads this
 * file back and fails if a field named for any of them appears. ADR-0007 is
 * why, and what adding one back would cost.
 */
const db = await getDb();
const details = await getSchoolDetails(db);
const settings = await getMoneySettings(db);
const courses = await listCourses(db);
const offerings = offeringsOf(courses);

/*
 * The year the clash rule measures against.
 *
 * `getSchoolYear` is undefined only before the first migration seeds the row,
 * and the seeded year is exactly what that migration writes — so falling back
 * to it warns from the school's own published dates rather than going quiet.
 * Silence would be the worse failure: no warning reads as "no clash".
 */
const year = (await getSchoolYear(db)) ?? SEEDED_SCHOOL_YEAR;

/*
 * The two documents the family agrees to (#71), and only the ones with a file
 * behind them. `publishedPolicies` is the same filter the public policies page
 * uses — a policy that exists in the admin but has never been uploaded is a
 * title with nothing to download, and asking a family to agree to a link to
 * nothing is the failure this ticket names.
 */
const askable = askableAgreements(publishedPolicies(await listPolicies(db)));

/**
 * Every application, or none of them.
 *
 * The tally rides on an email, and a read that failed must not turn a stored
 * application into an error page for the family who just sent it. A
 * notification carrying an empty tally is a worse email; a 500 over a form this
 * long is a worse afternoon.
 */
const applicationsForTally = async () => {
  try {
    return await listApplications(db);
  } catch (cause) {
    console.error('[application] tally not read:', cause);
    return [];
  }
};

let values: ApplicationFields;
let errors: ApplicationErrors = {};
let sentId: string | null = null;
let storeFailed = false;
let checked = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const parsed = parseApplication(form, offerings, askable);
  const sending = form.get('intent') === 'send';

  values = parsed.values;
  checked = !sending;
  // A check is "did I pick two classes that collide", not "you forgot your
  // name". Reporting missing fields against a button that submits nothing is
  // an error message about a form the family is still filling in.
  errors = sending ? parsed.errors : {};

  if (sending && Object.keys(errors).length === 0) {
    /*
     * The fees this family applied at, frozen before the application is
     * written (ADR-0006). Its failure is swallowed the way the inquiry's
     * delivery stamp is: the application itself is the thing that must not be
     * lost, and a missing terms row is bookkeeping the school can reconstruct.
     */
    let agreed: MoneySettings | null = null;
    let agreedTermsId: string | null = null;
    try {
      const terms = await recordAgreedTerms(db, values.familyName, settings);
      agreed = terms;
      agreedTermsId = terms.id;
    } catch (cause) {
      console.error('[application] terms not frozen:', cause);
    }

    try {
      sentId = await createApplication(db, values, {
        statementVersion: statementVersion(),
        flagged: parsed.flagged,
        agreedTermsId,
      });
    } catch (cause) {
      // The operator's copy. The family is told plainly, and given the address
      // to write to, rather than shown a 500 over a form this long.
      console.error('[application] not stored:', cause);
      storeFailed = true;
    }

    /*
     * Telling the school (#32 AC 6), and telling the family.
     *
     * Both are attempted whether or not the row was written, which is the half
     * of "neither failure silently loses the other" that points outwards: a
     * refused write makes the school's email the only copy of the application,
     * and it says so — and it is what turns a refused submission into a family
     * who was told rather than one who finds out in September (AC 4).
     *
     * The figures are the ones frozen for this family a moment ago, so the
     * email quotes what they agreed to rather than what the settings say by the
     * time somebody opens it (ADR-0006).
     */
    const applied = agreed ?? settings;
    const submission = {
      values,
      cost: applicationCost(values, offerings, applied),
      settings: applied,
      // Read back including this application, so the count in the email is the
      // count Jill would see on the admin screen a second later — deduplicated,
      // never the raw number of rows.
      tally: classTally(await applicationsForTally(), offerings),
      flagged: parsed.flagged,
      reference: sentId,
    };

    const apiKey = import.meta.env.RESEND_API_KEY;
    const from = import.meta.env.MAIL_FROM;

    const delivery = await deliverApplication(submission, {
      // The list the school keeps on its own Money screen, never an address in
      // this file (#32 AC 6).
      sender: apiKey && from ? resendSender(apiKey) : undefined,
      to: settings.notificationAddresses,
      from: typeof from === 'string' ? from : '',
      postTo: details.address,
      schoolEmail: details.email.trim(),
      site: Astro.site?.toString() ?? SITE_URL,
    });

    if (sentId) await recordApplicationDelivery(db, sentId, delivery);

    // The operator's copy: a deployment whose notifications are silently
    // failing must not be discoverable only by opening the admin.
    if (delivery.notificationError) {
      console.error('[application] school not notified:', delivery.notificationError);
    }
    if (delivery.confirmationError) {
      console.error('[application] family not told:', delivery.confirmationError);
    }
  }
} else {
  /*
   * The prefill (#31 AC 1). `?inquiry=<id>` is the link Jill pastes into an
   * email; `getInquiry` already answers undefined for a stale id *and* for a
   * malformed one, so no link, a dead link and a link an email client wrapped
   * all land on the same clean slate.
   */
  const row = await getInquiry(db, Astro.url.searchParams.get('inquiry') ?? '');
  values = prefillFrom(row ? { name: row.name, email: row.email, ages: row.ages } : null);
}

const rejected = Object.keys(errors).length > 0;
const cost = applicationCost(values, offerings, settings);
const clashing = familyClashes(values, offerings, year);
const clashCount = clashing.reduce((sum, one) => sum + one.clashes.length, 0);

/**
 * Who a warning is about. The name the family typed, or their place in the form
 * — a family often picks classes before they finish typing names, and "your
 * second child" is still an address.
 */
const ORDINALS = ['first', 'second', 'third', 'fourth', 'fifth', 'sixth', 'seventh', 'eighth'];
const childLabel = (child: ApplicationChild, index: number): string =>
  child.name.trim() || `Your ${ORDINALS[index] ?? `${index + 1}th`} child`;

/**
 * How many child rows to render.
 *
 * The children the family has already named, plus one spare, and never fewer
 * than two. `MAX_CHILDREN` rows unconditionally would be eight copies of a
 * picker carrying every offering the school sells — a page a family scrolls
 * past rather than reads. The parser reads all eight indexes regardless, so
 * the cap is the only thing this number has to respect.
 */
const rows = Math.min(MAX_CHILDREN, Math.max(values.children.length + 1, 2));
const childAt = (index: number): ApplicationChild =>
  values.children[index] ?? { name: '', age: '', offeringKeys: [] };

const stage = (id: string): string =>
  APPLICATION_STAGES.find((one) => one.id === id)?.title ?? '';

const description =
  'Apply to Pharos Academy — what we believe, the classes your children would take, and what to post.';
---

<BaseLayout details={details} title="Apply to Pharos" description={description}>
  <section class="band band-quiet" data-section="apply-header">
    <div class="wide">
      <p class="label">Applying</p>
      <h1 class="mt-4">Your application</h1>
      <p class="sub mt-5">
        All of it on one page: what we believe, the classes you are choosing, the documents families
        sign, what to post, and sending it. Nothing here is a test — the questions about what we
        believe exist so we can talk, not so we can turn anyone away.
      </p>

      {
        sentId && (
          <p class="notice mt-7" data-outcome="received" role="status">
            Your application is with us. Reference {sentId}.
          </p>
        )
      }

      {
        storeFailed && (
          <p class="notice mt-7" data-outcome="failed" role="status">
            Something went wrong at our end and your application was not saved. Nothing was lost
            from the form below — please try again, or send it to {details.email} and we will enter
            it ourselves.
          </p>
        )
      }

      {
        rejected && (
          <p class="notice mt-7" data-outcome="failed" role="status">
            Nothing was sent — the fields below need fixing first.
          </p>
        )
      }

      {
        checked && (
          <p class="notice mt-7" data-outcome="checked" role="status">
            {clashCount === 0
              ? 'Nothing in that selection collides. The totals below are what you would post.'
              : 'Have a look at the warnings under Choosing classes before you send this.'}
          </p>
        )
      }
    </div>
  </section>

  {
    sentId ? (
      <section class="band" id="confirmation" data-section="apply-confirmation">
        <div class="wide">
          <h2>{stage('confirmation')}</h2>
          <p class="sub mt-4">
            We have your application for {values.familyName}, and we will be in touch. A place is
            held for each class as soon as your cheque reaches us.
          </p>

          <h3 class="mt-8">What you chose</h3>
          <ul class="chosen mt-4">
            {cost.perChild
              .filter((one) => one.child.name || one.offerings.length > 0)
              .map((one) => (
                <li>
                  <strong>{one.child.name || 'A child'}</strong>
                  {one.child.age && <span class="detail">age {one.child.age}</span>}
                  <ul class="picked">
                    {one.offerings.length === 0 ? (
                      <li>No classes chosen yet.</li>
                    ) : (
                      one.offerings.map((offering) => <li>{offeringTitle(offering)}</li>)
                    )}
                  </ul>
                </li>
              ))}
          </ul>

          <h3 class="mt-8">What to post</h3>
          <p class="mt-4">
            A cheque for <strong>{formatMoney(cost.total.dueNow)}</strong> — that is{' '}
            {formatMoney(cost.total.registration)} in registration and{' '}
            {formatMoney(cost.total.deposits)} in deposits — made out to Pharos Academy, to:
          </p>
          <p class="address mt-4">{details.address}</p>
          <p class="mt-6 text-ink-2">
            Tuition is paid to your instructors, not to the school:{' '}
            {formatMoney(cost.total.dueToInstructors)} across the year at today's rates.
          </p>

          <p class="mt-8">
            <a class="btn" href="/classes">See the classes again</a>{' '}
            <a class="btn" href={BELIEFS_PATH}>Read what we believe</a>
          </p>
        </div>
      </section>
    ) : (
      <form method="post" novalidate data-application-form>
        <section class="band" id="faith" data-section="apply-faith">
          <div class="wide">
            <h2>{stage('faith')}</h2>
            <p class="sub mt-4">{BELIEFS_CLOSING}</p>
            <p class="mt-5">
              <a href={BELIEFS_PATH}>Our Statement of Faith and Practice in full</a> — the same
              eleven articles are below, so you can read them without leaving this page.
            </p>

            {/*
              A disclosure, not a gate. It opens with a click or with the
              keyboard, it is open to anyone who wants it, and nothing on this
              page waits on it — no button is disabled and no field is hidden
              until it has been scrolled through (#31 AC 7).
            */}
            <details class="statement mt-6">
              <summary>Read the eleven articles here</summary>
              <ol class="articles mt-5">
                {BELIEFS_ARTICLES.map((article) => (
                  <li>{article}</li>
                ))}
              </ol>
            </details>

            <p class="mt-7 text-ink-2">
              We ask each parent or guardian separately, because a household where one of you is
              not sure is exactly the conversation these questions exist to start. Leave a column
              alone if it does not apply to your family — an unanswered question is not a "no".
            </p>

            <div class="faith mt-7">
              {FAITH_QUESTIONS.map((question) => (
                <fieldset class="question">
                  <legend>{question.text}</legend>
                  <div class="respondents">
                    {FAITH_RESPONDENTS.map((respondent) => (
                      <fieldset class="respondent">
                        <legend>{respondent}</legend>
                        {(
                          [
                            { value: 'yes', label: 'Yes' },
                            { value: 'no', label: 'No' },
                            { value: '', label: 'Not answered' },
                          ] as const
                        ).map((choice) => (
                          <label class="check">
                            <input
                              type="radio"
                              name={faithKey(respondent, question.id)}
                              value={choice.value}
                              checked={
                                faithAnswer(values.faith, respondent, question.id) === choice.value
                              }
                            />
                            <span>{choice.label}</span>
                          </label>
                        ))}
                      </fieldset>
                    ))}
                  </div>
                </fieldset>
              ))}
            </div>

            <div class="field mt-7">
              <label for="apply-objections">
                Anything you disagree with, or want to talk about (optional)
              </label>
              <textarea id="apply-objections" name="objections">{values.objections}</textarea>
              <p class="hint" id="apply-objections-hint">
                Writing something here does not stop your application. It routes it to a
                conversation with us, which is what we would rather have.
              </p>
            </div>
          </div>
        </section>

        <section class="band band-quiet" id="classes" data-section="apply-classes">
          <div class="wide">
            <h2>{stage('classes')}</h2>
            <p class="sub mt-4">
              Who is applying, and what they would take. Only the classes we are actually enrolling
              are listed.
            </p>

            <div class="form mt-7">
              <div>
                <label for="apply-family-name">Family name</label>
                <input
                  id="apply-family-name"
                  name="familyName"
                  autocomplete="family-name"
                  value={values.familyName}
                  aria-describedby={errors.familyName ? 'apply-family-name-error' : undefined}
                  aria-invalid={errors.familyName ? 'true' : undefined}
                />
                {errors.familyName && (
                  <p class="error" id="apply-family-name-error">
                    {errors.familyName}
                  </p>
                )}
              </div>

              <div>
                <label for="apply-email">Email</label>
                <input
                  id="apply-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  value={values.email}
                  aria-describedby={errors.email ? 'apply-email-error' : undefined}
                  aria-invalid={errors.email ? 'true' : undefined}
                />
                {errors.email && (
                  <p class="error" id="apply-email-error">
                    {errors.email}
                  </p>
                )}
              </div>
            </div>

            {errors.children && (
              <p class="error mt-6" id="apply-children-error">
                {errors.children}
              </p>
            )}
            {errors.classes && (
              <p class="error mt-4" id="apply-classes-error">
                {errors.classes}
              </p>
            )}

            {Array.from({ length: rows }, (_unused, index) => index).map((index) => (
              <fieldset class="child mt-8">
                <legend>Child {index + 1}</legend>
                <div class="form">
                  <div>
                    <label for={`apply-child-${index}-name`}>Name</label>
                    <input
                      id={`apply-child-${index}-name`}
                      name={`child-${index}-name`}
                      value={childAt(index).name}
                      aria-describedby={errors.children ? 'apply-children-error' : undefined}
                    />
                  </div>
                  <div>
                    <label for={`apply-child-${index}-age`}>Age</label>
                    <input
                      id={`apply-child-${index}-age`}
                      name={`child-${index}-age`}
                      inputmode="numeric"
                      value={childAt(index).age}
                      aria-describedby={errors.children ? 'apply-children-error' : undefined}
                    />
                  </div>
                </div>

                <fieldset class="picker mt-6">
                  <legend>Classes for this child</legend>
                  {offerings.length === 0 ? (
                    <p class="hint">
                      Nothing is open for enrolment at the moment. Please{' '}
                      <a href={INQUIRY_PATH}>write to us</a> and we will tell you when it is.
                    </p>
                  ) : (
                    <ul class="offerings">
                      {offerings.map((offering) => (
                        <li>
                          <label class="check">
                            <input
                              type="checkbox"
                              name={`child-${index}-classes`}
                              value={offeringKey(offering)}
                              checked={childAt(index).offeringKeys.includes(offeringKey(offering))}
                              aria-describedby={errors.classes ? 'apply-classes-error' : undefined}
                            />
                            <span>
                              <strong>{offeringTitle(offering)}</strong>
                              <span class="blurb">
                                {offering.course.days.join(' and ')},{' '}
                                {timeLabel(offering.course.start, offering.course.end)}
                              </span>
                            </span>
                          </label>
                        </li>
                      ))}
                    </ul>
                  )}
                </fieldset>
              </fieldset>
            ))}

            {/*
              The clash warnings (#31 AC 3, 4, 5). Warnings and never a block:
              a family may have a reason, and the school would rather they made
              the choice knowing. The Wednesday 10:40 slot's five electives
              produce nothing here unless *one child* selects two of them —
              grouped per child, because siblings in two rooms at one time is
              not a clash and must never be reported as one.
            */}
            <div class="warnings mt-8" data-clashes={clashCount} role="status">
              {clashing.length > 0 && (
                <>
                  <h3>Some of these do not fit together</h3>
                  {clashing.map(({ child, index, clashes }) => (
                    <div class="mt-4" data-child-clashes={index}>
                      <p><strong>{childLabel(child, index)}</strong></p>
                      <ul class="mt-2">
                        {clashes.map((clash) => (
                          <li data-severity={clash.severity}>{clashSentence(clash)}</li>
                        ))}
                      </ul>
                    </div>
                  ))}
                  <p class="mt-4 text-ink-2">
                    You can send this anyway — nothing here stops you. We would rather sort it out
                    with you before term than after.
                  </p>
                </>
              )}
            </div>
          </div>
        </section>

        {/*
          The two agreements (#71). Rendered only for documents the school has
          actually published: the section disappears rather than asking a family
          to agree to a link to nothing.

          The links go to each policy's *fixed* address, because a family reads
          the current document. The version they were shown travels in a hidden
          field's stead — it is on `askable`, and the parser records it — so what
          this family agreed to survives the next upload.

          Nothing here can block a submission. "Neither agrees" is an answer the
          school's own form allows, "Not answered" leaves the row absent, and no
          error can be attached to either.
        */}
        {askable.length > 0 && (
          <section class="band" id="agreements" data-section="apply-agreements">
            <div class="wide">
              <h2>{stage('agreements')}</h2>
              <p class="sub mt-4">
                Two documents families sign. Read them here — they open in full — and tell us who
                agrees. You can send the application whatever you answer, and "Neither agrees" is a
                real answer rather than a problem.
              </p>

              <div class="faith mt-7">
                {askable.map((document) => (
                  <fieldset class="question" data-agreement={document.slug}>
                    <legend>{document.question}</legend>
                    <p class="hint">
                      <a href={agreementHref(document.slug)}>Read the {document.title}</a> — the
                      version published today.
                    </p>
                    <div class="mt-4">
                      {[...AGREEMENT_CHOICES, { value: '', label: 'Not answered' } as const].map(
                        (choice) => (
                          <label class="check">
                            <input
                              type="radio"
                              name={agreementKey(document.slug)}
                              value={choice.value}
                              checked={
                                agreementAnswer(values.agreements, document.slug) === choice.value
                              }
                            />
                            <span>{choice.label}</span>
                          </label>
                        ),
                      )}
                    </div>
                  </fieldset>
                ))}
              </div>
            </div>
          </section>
        )}

        <section class="band band-quiet" id="payment" data-section="apply-payment">
          <div class="wide">
            <h2>{stage('payment')}</h2>
            <p class="sub mt-4">
              Every figure here comes from the school's current fee settings, and it changes when
              they do.
            </p>

            <ul class="totals mt-7">
              <li>
                <span class="amount">{formatMoney(cost.total.registration)}</span>
                <span>Registration — once per student, not refundable</span>
              </li>
              <li>
                <span class="amount">{formatMoney(cost.total.deposits)}</span>
                <span>Deposits — one per class, holding the seats</span>
              </li>
              <li class="due">
                <span class="amount">{formatMoney(cost.total.dueNow)}</span>
                <span>The cheque you post with this application</span>
              </li>
              <li>
                <span class="amount">{formatMoney(cost.total.dueToInstructors)}</span>
                <span>
                  Tuition, paid to your instructors across the year
                  {cost.total.creditedAgainstTuition > 0 &&
                    ` — the deposits come off this, ${formatMoney(cost.total.creditedAgainstTuition)} of it`}
                </span>
              </li>
            </ul>

            <p class="mt-7">Make the cheque out to Pharos Academy and post it to:</p>
            <p class="address mt-4">{details.address}</p>

            {/*
              The payment slot, designed in and deliberately empty (#31). There
              is no provider here and no card field. When one lands, the only
              thing that changes for a family is that this paragraph offers a
              second way to pay — and the only thing that changes in the row is
              that the next submission reads "paid online" rather than
              "awaiting cheque".
            */}
            <p class="mt-6 text-ink-2">
              There is no way to pay online yet. When there is, it will appear here, and posting a
              cheque will still work.
            </p>
          </div>
        </section>

        <section class="band" id="confirmation" data-section="apply-send">
          <div class="wide">
            <h2>{stage('confirmation')}</h2>
            <p class="sub mt-4">
              Check what you have chosen first if you would like to — it saves nothing and sends
              nothing. When you send it, we will read it and be in touch.
            </p>

            <p class="mt-7">
              <button class="btn" type="submit" name="intent" value="check">
                Check these choices
              </button>{' '}
              <button class="btn solid" type="submit" name="intent" value="send">
                Send the application
              </button>
            </p>

            <p class="mt-6 text-ink-2">
              Not ready? <a href={INQUIRY_PATH}>Ask us a question instead</a> — we would far rather
              answer one now than have you find the answer halfway through this.
            </p>
          </div>
        </section>
      </form>
    )
  }
</BaseLayout>

