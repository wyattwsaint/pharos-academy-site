---
import CourseDates from '../../components/classes/CourseDates.astro';
import CourseFacts from '../../components/classes/CourseFacts.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSchoolDetails } from '../../lib/admin/school-details.js';
import { getSchoolYear } from '../../lib/calendar/store.js';
import { ageLine } from '../../lib/courses/ages.js';
import { courseMeetings } from '../../lib/courses/meetings.js';
import { priceSummary } from '../../lib/courses/pricing.js';
import { coursesOnTrack, timeLabel } from '../../lib/courses/schedule.js';
import { getCourse, listCourses } from '../../lib/courses/store.js';
import { courseJsonLd } from '../../lib/courses/structured-data.js';
import { classPath, CLASS_VIEWS } from '../../lib/courses/views.js';
import { getDb } from '../../lib/db/client.js';
import { getMoneySettings } from '../../lib/money/store.js';
import { SITE_URL } from '../../lib/site.js';

import { INQUIRY_HREF } from '../../lib/home/sections.js';
import { bySlug, instructorOf } from '../../lib/people/person.js';
import { listPeople } from '../../lib/people/store.js';

/**
 * One class, at its own address (#22).
 *
 * The reason this page exists is a sentence in the brief: Jill sends a link to
 * a single class. So the page has to stand alone — it carries the required
 * text, the prerequisites, the instructor, the contact hours and both fees,
 * because the parent who lands here arrived from a message and not from the
 * list.
 *
 * A slug that is not a class is a 404, not an empty page. Rendering a blank
 * course would be the site claiming the school offers something it does not.
 */
const { slug } = Astro.params;
const db = await getDb();
const details = await getSchoolDetails(db);
const course = slug ? await getCourse(db, slug) : undefined;

if (!course) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

// The other classes running on the same morning. A parent reading one class is
// usually working out what else that trip can carry — and the ones that
// overlap are exactly what they need to see, so they are shown rather than
// filtered out, with their times attached.
const everyCourse = await listCourses(db);
const { rates } = await getMoneySettings(db);
/*
 * The instructor comes from the one list of people (#26), never from a name
 * typed onto the course, so a correction on the staff page lands here too — and
 * it may be nobody (#257), for a class the school has scheduled and not staffed
 * yet. Asked **once**, here: the facts list below and the structured data
 * further down both read this one answer, so the markup cannot claim a name the
 * page does not print.
 */
const instructor = instructorOf(bySlug(await listPeople(db)), course);
const seen = new Set<string>([course.slug]);
const alongside = course.days
  .flatMap((day) => coursesOnTrack(everyCourse, day))
  .filter((other) => (seen.has(other.slug) ? false : seen.add(other.slug)));

/*
 * When it meets (#233).
 *
 * The dates are computed here from the saved school year, by the same function
 * the editor's clash check uses, so this page and that warning cannot disagree.
 * No school year saved means no dates to compute, which the section says in
 * words rather than rendering an empty list.
 */
const schoolYear = await getSchoolYear(db);
const meetings = schoolYear ? courseMeetings(schoolYear, course) : null;

const description = `${course.title} at Pharos Academy — ${ageLine(course)}, ${course.days.join(
  ' and ',
)} ${timeLabel(course.start, course.end)}, ${priceSummary(course, rates)}.`;

/*
 * The class, in structured data (#151).
 *
 * Built from the same `course`, the same rates and the same instructor the page
 * below renders, so the two cannot disagree — a class whose markup quoted a
 * different price or a different morning from the facts list beside it would be
 * the #22 failure again, in the half a parent never sees.
 */
const jsonLd = [
  courseJsonLd({
    course,
    rates,
    instructorName: instructor?.name ?? null,
    site: Astro.site ?? SITE_URL,
  }),
];
---

<BaseLayout details={details} title={course.title} description={description} jsonLd={jsonLd}>
  <section class="band band-quiet" data-section="class-header">
    <div class="wide">
      <p class="label">
        <a href={CLASS_VIEWS[0]?.path}>Classes</a> · {course.stages.join(' · ')}
      </p>
      <h1 class="mt-4">{course.title}</h1>
      <p class="sub mt-5">
        {course.days.join(' and ')} · {timeLabel(course.start, course.end)} · {ageLine(course)}
      </p>
    </div>
  </section>

  <section class="band" data-section="class-detail">
    <div class="wide">
      <div class="classdetail">
        <div>
          <p class="classdetail-lede">{course.description}</p>
          <a class="btn solid" href={INQUIRY_HREF}>Ask us about this class</a>
        </div>
        <CourseFacts
          course={course}
          instructor={instructor}
          rates={rates}
          meetingDates={false}
        />
      </div>

      <CourseDates meetings={meetings} />

      <h2 class="mt-9">Also on {course.days.join(' and ')}</h2>
      <ul class="alongside">
        {
          alongside.map((other) => (
            <li>
              <a href={classPath(other.slug)}>{other.title}</a>
              <span>
                {timeLabel(other.start, other.end)} · {ageLine(other)}
              </span>
            </li>
          ))
        }
      </ul>

      <p class="mt-7 text-ink-2">
        Times are the school’s own. Two classes listed here can run at the same time —
        <a href="/classes/by-day">the week drawn to the clock</a> shows exactly where they overlap.
      </p>
    </div>
  </section>
</BaseLayout>
