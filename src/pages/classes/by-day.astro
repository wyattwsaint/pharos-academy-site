---
import ClassesHeader from '../../components/classes/ClassesHeader.astro';
import DayTimetable from '../../components/classes/DayTimetable.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSchoolDetails } from '../../lib/admin/school-details.js';
import { layoutWeek } from '../../lib/courses/schedule.js';
import { listCourses } from '../../lib/courses/store.js';
import { courseListJsonLd } from '../../lib/courses/structured-data.js';
import { viewFor } from '../../lib/courses/views.js';
import { getDb } from '../../lib/db/client.js';
import { getMoneySettings } from '../../lib/money/store.js';
import { SITE_URL } from '../../lib/site.js';

import { bySlug } from '../../lib/people/person.js';
import { listPeople } from '../../lib/people/store.js';

/**
 * By Day — the timetable, drawn to scale.
 *
 * One section per day track that actually runs a class. Tuesday is not drawn:
 * an empty day track is complete, not incomplete (CONTEXT.md, "day track"), and
 * a permanently blank column says the opposite.
 *
 * The morning is drawn as time rather than as a list of rows, which is the one
 * thing the live site's timetable gets wrong about the school's own schedule.
 * See `DayTimetable.astro` for what that costs and why it is worth it.
 */
const view = viewFor('by-day');
const db = await getDb();
const details = await getSchoolDetails(db);
const week = layoutWeek(await listCourses(db));
const { rates } = await getMoneySettings(db);
// Every name in the grid is read from the one list of people (#26).
const directory = bySlug(await listPeople(db));

// The classes drawn on the timetable, in the order the week runs them (#151),
// each pointing at its own page rather than being described again here.
const jsonLd = [
  courseListJsonLd(
    week.flatMap((day) => day.placed.map((placed) => placed.course)),
    view.path,
    Astro.site ?? SITE_URL,
  ),
];
---

<BaseLayout
  details={details}
  title={view.title}
  description={view.description}
  jsonLd={jsonLd}
>
  <ClassesHeader
    current="by-day"
    heading="The week, drawn to the clock"
    lede="Three mornings, drawn to scale. Classes side by side run at the same time — some of the school’s classes really do overlap, and this is where you can see by how much."
  />

  <section class="band" data-section="by-day">
    <div class="wide">
      {week.map((layout) => <DayTimetable layout={layout} directory={directory} rates={rates} />)}

      <p class="mt-9 text-ink-2">
        Wednesday’s 10:40 hour carries several short electives on purpose — they run in different
        parts of the year, so the column is busy by design rather than by mistake. Every class
        links to its own page, with texts, prerequisites and fees.
      </p>
    </div>
  </section>
</BaseLayout>
