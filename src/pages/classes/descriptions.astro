---
import ClassesHeader from '../../components/classes/ClassesHeader.astro';
import CourseFacts from '../../components/classes/CourseFacts.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSchoolDetails } from '../../lib/admin/school-details.js';
import { listCourses } from '../../lib/courses/store.js';
import { courseListJsonLd } from '../../lib/courses/structured-data.js';
import { classPath, viewFor } from '../../lib/courses/views.js';
import { getDb } from '../../lib/db/client.js';
import { getMoneySettings } from '../../lib/money/store.js';

import { SITE_URL } from '../../lib/site.js';

import { bySlug, instructorOf } from '../../lib/people/person.js';
import { listPeople } from '../../lib/people/store.js';

/**
 * Full Descriptions — the whole catalogue on one page, in the school's own
 * words, alphabetically.
 *
 * The live site's equivalent is a PDF and a page that disagree with each other.
 * This is the same rows the other three surfaces read, so it cannot disagree
 * with them; what makes it a distinct surface is that everything is open at
 * once, for the parent who would rather read than click.
 *
 * The lede states no count (#247). It carried a derived one, which made "all"
 * a promise with a number attached; without the number the promise is the same
 * and the page is still the thing that keeps it — every course row is below,
 * and the jump nav lists them.
 */
const view = viewFor('full-descriptions');
const db = await getDb();
const details = await getSchoolDetails(db);
const courses = await listCourses(db);
const { rates } = await getMoneySettings(db);
// One read of the one list, shared by every entry below.
const directory = bySlug(await listPeople(db));

// The classes on this page, each pointing at its own address (#151). The full
// description of each is on that page; this says which classes there are.
const jsonLd = [courseListJsonLd(courses, view.path, Astro.site ?? SITE_URL)];
---

<BaseLayout
  details={details}
  title={view.title}
  description={view.description}
  jsonLd={jsonLd}
>
  <ClassesHeader
    current="full-descriptions"
    heading="Every Class, in Full"
    lede="Every class, alphabetically, with the description, texts, prerequisites and fees the school publishes for each."
  />

  <section class="band" data-section="full-descriptions">
    <div class="wide">
      <nav class="bandjump" aria-label="Jump to a class">
        {courses.map((course) => <a href={`#${course.slug}`}>{course.title}</a>)}
      </nav>

      {
        courses.map((course) => (
          <article class="coursefull" data-course={course.slug}>
            <h2 id={course.slug}>{course.title}</h2>
            <p class="coursefull-lede">{course.description}</p>
            <CourseFacts course={course} instructor={instructorOf(directory, course)} rates={rates} />
            <a class="btn" href={classPath(course.slug)}>
              This class on its own page
            </a>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
