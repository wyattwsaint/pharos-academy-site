---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSchoolDetails } from '../../lib/admin/school-details.js';
import { eventDateLabel, eventTimeLabel, upcomingEvents } from '../../lib/calendar/event.js';
import { getSchoolYear, listPublishedEvents } from '../../lib/calendar/store.js';
import { eventJsonLd } from '../../lib/calendar/structured-data.js';
import { CALENDAR_FEED_PATH, SUBSCRIPTION_CAVEAT } from '../../lib/calendar/views.js';
import { monthGrid, printedYear, WEEKDAY_COLUMNS } from '../../lib/calendar/months.js';
import { schoolToday, type SchoolYear } from '../../lib/calendar/year.js';
import { listCourses } from '../../lib/courses/store.js';
import { getDb } from '../../lib/db/client.js';
import { SITE_URL } from '../../lib/site.js';

/**
 * The school year, as a calendar (#23, #186, #237).
 *
 * One page and one drawing of the year on the screen: the subscribe block, and
 * the months. It used to be two — a four-column **day track** sheet above the
 * grid, carried over from the five hand-made PDFs this page retired. The sheet
 * is deleted (ADR-0018): it answered "on which dates does my *track* meet" to a
 * parent who asked about a *course*, and it never named one. That question is
 * answered on the course page now (#233), where the course has a name.
 *
 * **Week numbers left the public site with it, and are not given a new home
 * here.** A row of this grid is a calendar week and the four tracks number it
 * four different ways, so there is no honest place to print one. The subscribed
 * feed keeps them, because a feed entry names its track and so exactly one
 * numbering applies.
 *
 * Nothing here is typed. Every date is computed from the eight numbers and the
 * closure list on the admin's School Year screen.
 *
 * One download, and it is the same bytes the subscribe link serves. Printing is
 * the other half, and what it puts on paper is neither of the things on the
 * screen: a school office gets the year as a dated list (#236), which is the
 * sheet it already maintains by hand, and the print rules at the bottom of this
 * file are why it comes out as that rather than as a website with a navigation
 * bar across the top.
 */
const db = await getDb();
const details = await getSchoolDetails(db);
const year = (await getSchoolYear(db)) as SchoolYear | undefined;
/*
 * Both sources, one calendar (#153): what the school typed on the Events screen
 * and what it keeps in its own Google calendar, interleaved by date. A visitor
 * is not told which is which, because it is not a fact about the school's year —
 * it is a fact about where the school happens to keep its diary.
 *
 * **The grid draws all of them and the markup draws the ones still ahead.** The
 * filter that used to run over the whole page (#146) was written for a list,
 * where a fundraiser that has been and gone leads; in a grid the cell's position
 * says the date has passed and a hole where October was says nothing at all.
 * What is still ahead is a claim about the present, and that is what the
 * structured data below and the search result it feeds are for.
 */
const published = await listPublishedEvents(db);
const events = upcomingEvents(published, new Date());
/*
 * The catalogue, because a teaching date reveals what meets on it (#235).
 *
 * The whole catalogue rather than a query per date: the grid asks about roughly
 * two hundred dates, and the meeting dates are computed from the same eight
 * numbers the months are.
 */
const courses = await listCourses(db);

const description =
  'The Pharos Academy school year, month by month — the year’s one-off events on their dates, ' +
  'the days the school is closed, and what meets on each class day. Subscribe to it or print it.';

/*
 * The year, as a calendar (#186).
 *
 * "What is happening in October", which is the question a family asks in
 * October. The dates a particular course meets on — the question they ask in
 * August — are answered on that course's own page (#233), where they can be
 * answered by naming the course.
 *
 * A calendar prints what is exceptional and reveals what is routine (ADR-0018),
 * and both halves of that sentence are decided in the view model rather than
 * here: the cell arrives already knowing its one-offs, its closure and what
 * meets on it.
 */
const months = year ? monthGrid(year, published, courses) : [];
/*
 * The month it is in Enola, so the page opens on it.
 *
 * Read at render rather than in the browser: this page is revalidated, so the
 * value is at worst an hour late on the one night a year a month turns over,
 * and a browser's own clock would be a second definition of "now" on a page
 * whose other dated decision (what is still ahead) is already made here.
 */
const currentMonth = schoolToday(new Date()).slice(0, 7);

/*
 * The same year a third time, as the sheet a school office pins up (#236, #271).
 *
 * Rendered always and shown only to a printer. It is folded from the grid above
 * rather than computed again, so paper cannot say something the screen does not:
 * the two-column list is the same months, the same closures and the same
 * one-offs — the school's own and the ones synced from its Google calendar —
 * with the runs of shut days folded into ranges and a one-off's note left off,
 * because prose in a two-column list is what breaks the page.
 *
 * The year comes in beside the grid for the **term boundaries** alone: which day
 * each semester opened and closed on is a fact about a semester, and a cell
 * carries none. Everything else on the sheet is still the grid's.
 *
 * What is *not* on it is the offerings and the week numbers. The reference the
 * school already maintains by hand has neither, and paper is where space is
 * scarcest.
 */
const printedMonths = year ? printedYear(months, year) : [];

/*
 * The events, in structured data (#151) — the upcoming subset of what the grid
 * above draws, so the page and the markup cannot disagree about when something
 * is on.
 *
 * A subset rather than the whole of it, and deliberately: the grid draws the
 * year, past one-offs included, because a cell says its own date. A crawler has
 * no such cell, and last spring's concert offered to a search result as though
 * it were on is a wrong claim about today.
 *
 * The 112 meeting dates are deliberately *not* here. They are one school day
 * repeated, not 112 events a family would want in a search result, and a page
 * carrying a hundred `Event` nodes is what a crawler treats as spam. The dates
 * belong on the course page and in the subscribed calendar, which is what they
 * are for.
 */
const jsonLd = events.map((event) => eventJsonLd({ event, site: Astro.site ?? SITE_URL }));
---

<BaseLayout details={details} title="Calendar" description={description} jsonLd={jsonLd}>
  <section class="band band-quiet" data-section="calendar-header">
    <div class="wide">
      <p class="label">Current Families</p>
      <h1 class="mt-4">The {year?.label ?? ''} Calendar</h1>
      <p class="sub mt-5">
        The school year, month by month — open houses, concerts and picture days on their dates,
        the days the school is closed, and what meets on each class day. For every date a
        particular class meets, see that class’s own page.
      </p>
    </div>
  </section>

  <section class="band" id="subscribe" data-section="calendar-subscribe">
    <div class="wide">
      <h2>Take It with You</h2>
      <p class="mt-5">
        One file, generated from the same dates the months below are drawn from. Open it to add
        the year to the calendar on your phone or computer, or subscribe to this address so it
        stays in step when the school changes something.
      </p>
      <p class="mt-6 actions">
        <a class="btn" href={CALENDAR_FEED_PATH} data-testid="calendar-download">
          Download the calendar
        </a>
        <button type="button" class="btn" data-print-calendar>Print this page</button>
      </p>
      <p class="mt-6 caveat" data-testid="subscription-caveat">{SUBSCRIPTION_CAVEAT}</p>
    </div>
  </section>

  {/*
    Still `id="events"`, because this is still where the school's events are
    published: the structured data above points a search result at this
    fragment, and a family who bookmarked it should land on the calendar rather
    than at the top of the page.
  */}
  <section class="band band-quiet" id="events" data-section="calendar-months">
    <div class="wide">
      <h2>Month by month</h2>
      <p class="sub mt-5">
        The same year, drawn as a calendar. Open houses, concerts and picture days sit on their
        dates with their times — from the school’s own calendar and from the office, without
        distinction — and a weekday in term time with no classes on it says so. On a teaching
        day, press the count to see what meets.
      </p>

      {
        months.length === 0 ? (
          <p class="mt-6">
            There is no calendar to draw yet. The months appear here as soon as the school year is
            set.
          </p>
        ) : (
          /*
            One group across every month, not one per month: `disclosure-group`
            keeps a single panel open at a time, and two panels open in two
            months is the same overlap the rule exists to prevent.
          */
          <disclosure-group class="months mt-7" data-disclosure-group="calendar-months">
            {months.map((month) => (
              <div
                class="month"
                data-month={month.id}
                data-current-month={month.id === currentMonth ? '' : undefined}
              >
                <table class="month-grid">
                  <caption>{month.heading}</caption>
                  <thead>
                    <tr>
                      {WEEKDAY_COLUMNS.map((weekday) => (
                        <th scope="col">
                          <span class="sr-only">{weekday.long}</span>
                          <span aria-hidden="true">{weekday.short}</span>
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {month.weeks.map((week) => (
                      <tr>
                        {week.map((cell) =>
                          cell === null ? (
                            <td class="blank" />
                          ) : (
                            <td
                              class:list={[
                                'date',
                                {
                                  shut: cell.noSchool,
                                  /*
                                    A cell carrying nothing at all — no mark, no
                                    one-off and nothing meeting — is the phone
                                    list's blank: it is a date and nothing else,
                                    and a phone shows only the dates something is
                                    true of.

                                    `empty` rather than the `quiet` this was
                                    called, because under #235 "quiet" is exactly
                                    what a cell holding classes it does not print
                                    would want to be called, and one word cannot
                                    mean both states (ADR-0018).
                                  */
                                  empty:
                                    !cell.noSchool &&
                                    cell.events.length === 0 &&
                                    cell.classLabel === null,
                                },
                              ]}
                            >
                              <time class="num" datetime={cell.date}>
                                <span class="short">{cell.day}</span>
                                <span class="long">{cell.label}</span>
                              </time>
                              {cell.noSchool && (
                                <span class="mark">
                                  No school{cell.closure ? ` — ${cell.closure}` : ''}
                                </span>
                              )}
                              {cell.events.map((event) => (
                                <div class="one-off" data-disclosure-cell>
                                  <button
                                    class="one-off-trigger"
                                    type="button"
                                    data-disclosure-trigger
                                    aria-expanded="false"
                                    aria-controls={`one-off-${event.slug}`}
                                  >
                                    <span class="one-off-name">{event.title}</span>
                                    {event.startTime && (
                                      <time class="one-off-time" datetime={event.startTime}>
                                        {eventTimeLabel(event.startTime)}
                                      </time>
                                    )}
                                  </button>
                                  <div
                                    class="one-off-panel"
                                    id={`one-off-${event.slug}`}
                                    data-disclosure-panel
                                  >
                                    <p class="when">
                                      <time datetime={event.heldOn}>
                                        {eventDateLabel(event.heldOn)}
                                      </time>
                                    </p>
                                    {event.place && <p class="where">{event.place}</p>}
                                    {event.note && <p class="mt-2">{event.note}</p>}
                                  </div>
                                </div>
                              ))}
                              {/*
                                What meets that day, revealed rather than printed
                                (#235). Last in the cell because the printed
                                things come first and the control that opens more
                                comes after them.

                                A distinct labelled control and **not the date
                                number turned into a button**: the number would
                                give this page roughly a hundred identically
                                named controls, which is a screen-reader failure,
                                and would make one number mean two things. The
                                date is in the name rather than the label so that
                                "6 classes" is what is read and "6 classes on
                                Wednesday 4 November" is what tells one control
                                from the next.
                              */}
                              {cell.classLabel && (
                                <div class="classes" data-disclosure-cell>
                                  <button
                                    class="classes-trigger"
                                    type="button"
                                    data-disclosure-trigger
                                    aria-expanded="false"
                                    aria-controls={`classes-${cell.date}`}
                                  >
                                    {cell.classLabel}
                                    <span class="sr-only"> on {cell.label}</span>
                                  </button>
                                  <div
                                    class="classes-panel"
                                    id={`classes-${cell.date}`}
                                    data-disclosure-panel
                                  >
                                    {cell.slots.map((slot) => (
                                      <div class="slot">
                                        <p class="slot-time">{slot.time}</p>
                                        <ul class="slot-classes">
                                          {slot.offerings.map((offering) => (
                                            <li>
                                              <a href={offering.href}>{offering.title}</a>
                                            </li>
                                          ))}
                                        </ul>
                                      </div>
                                    ))}
                                  </div>
                                </div>
                              )}
                            </td>
                          ),
                        )}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ))}
          </disclosure-group>
        )
      }
    </div>
  </section>

  {/*
    The printed year (#236).

    Off the screen entirely and on the paper alone: a family reading this page
    has the grid, which says what is on in October better than any list can, and
    a school office walking to the printer wants the whole year on one pinnable
    sheet. Rendered rather than generated in the browser, so printing works with
    no JavaScript and the same bytes come out of a phone.
  */}
  <section class="printed" data-section="calendar-print">
    <div class="wide">
      {/*
        The masthead the sheet is headed by (#271).

        Its own, and not the page's `<h1>` band, which is hidden in print below.
        A left-aligned label band over a website's heading is what a *page*
        looks like; a mark, the school's name and a centred title is what the
        sheet an office pins up looks like, and matching that shape is the whole
        of what the school asked for.

        **No revision date, here or anywhere on the sheet.** The reference
        carries one and this site holds no such fact: the stamp on the year
        record is attribution for an edit, and today's date says nothing at all
        about when the calendar last changed.
      */}
      {
        /*
          Headed only where there is a year to head it with. A school that has
          not set one yet gets a blank sheet rather than one titled "The
          Calendar" over nothing — the same answer the screen gives, where the
          months say the calendar appears as soon as the year is set.
        */
        year && (
          <header class="printed-masthead" data-print-masthead>
            <img class="printed-mark" src="/mark.svg" alt="" width="268" height="302" />
            <p class="printed-wordmark">Pharos Academy</p>
            <h2 class="printed-title">The {year.label} Calendar</h2>
          </header>
        )
      }

      <div class="printed-columns">
        {
          printedMonths.map((month) => (
            <div class="printed-month" data-print-month={month.id}>
              <h3>{month.heading}</h3>
              <ul>
                {month.lines.map((line) => (
                  <li class:list={['printed-line', { 'printed-term': line.entry.kind === 'term' }]}>
                    <span class="printed-days">{line.days}</span>
                    <span class="printed-what">
                      {line.entry.kind === 'term' ? (
                        line.entry.label
                      ) : line.entry.kind === 'closure' ? (
                        <Fragment>
                          No school{line.entry.label ? ` — ${line.entry.label}` : ''}
                        </Fragment>
                      ) : (
                        <Fragment>
                          {line.entry.title}
                          {line.entry.time && `, ${line.entry.time}`}
                          {line.entry.place && `, ${line.entry.place}`}
                        </Fragment>
                      )}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../../components/disclosure-group.js';

  /*
   * The print button, which is the one thing on this page that needs a browser.
   * Rendered as a `button` and wired here rather than shipped as an `onclick`,
   * so a visitor with no JavaScript sees no control that does nothing — and
   * loses nothing either, since their browser prints perfectly well on its own.
   */
  const button = document.querySelector('[data-print-calendar]');
  button?.addEventListener('click', () => window.print());

  /*
   * The page opens on the month it is (#186 AC 2).
   *
   * Every month is rendered, so a visitor with no JavaScript loses the position
   * and none of the calendar. Two things are left alone on purpose: a URL that
   * already names a fragment, because the visitor asked for somewhere, and a
   * page the browser has already scrolled, because that is a back-button
   * returning someone to where they were.
   */
  const current = document.querySelector('[data-current-month]');
  if (current && !window.location.hash && window.scrollY === 0) {
    current.scrollIntoView({ block: 'start' });
  }
</script>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .caveat {
    max-width: 42rem;
    color: var(--color-ink-2);
  }

  /*
    The months, side by side while there is room for them.

    Nine of them stacked is a very long page for a year a family reads a month
    of; two or three abreast is the shape a wall calendar has, and the browser
    picks how many fit rather than a breakpoint guessing.
  */
  .months {
    display: grid;
    gap: 2.5rem 2rem;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
  }

  .month-grid {
    border-collapse: collapse;
    width: 100%;
    table-layout: fixed;
  }

  .month-grid caption {
    text-align: left;
    padding-bottom: 0.4rem;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.06em;
    border-bottom: 2px solid color-mix(in srgb, var(--color-navy) 20%, transparent);
  }

  .month-grid th {
    padding: 0.4rem 0.35rem;
    text-align: left;
    font-weight: 500;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.04em;
  }

  .month-grid td {
    height: 3.4rem;
    vertical-align: top;
    padding: 0.3rem 0.35rem 0.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-navy) 12%, transparent);
  }

  /* A date belonging to the month either side is a hole, not a cell. */
  .month-grid td.blank {
    border-top-color: transparent;
  }

  /*
    Full-strength ink rather than a muted grey, because this band is the quiet
    one and a closed cell tints it further: grey on grey on gold is where the
    contrast goes, and the date is the primary thing in the cell anyway. What
    makes the mark below quieter than the date is its size and its small caps,
    not a colour that has to survive two backgrounds.
  */
  .num .short {
    font-variant-numeric: tabular-nums;
    font-size: 0.85rem;
  }

  /*
    The wide grid has a column heading and a caption to say which Wednesday this
    is; the phone list has neither, so it prints the date in full instead. One
    date, two lengths, and never both at once.
  */
  .num .long {
    display: none;
  }

  /*
    A day off is a property of the cell — a tint and a line, and deliberately
    not the register a one-off is in. Nothing here is a control, because there
    is nothing to open: the whole of what the school has said is the name.
  */
  .month-grid td.shut {
    background: color-mix(in srgb, var(--color-gold-orn) 12%, transparent);
  }

  .mark {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.75rem;
    line-height: 1.2;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.03em;
  }

  /*
    The two things a cell opens: a one-off, and the classes that meet that day.

    Their *shape* is one thing and is written once — a full-width button with a
    rule down its left edge, and a panel that floats over the grid rather than
    expanding inside its cell, because a cell that grew would push a whole week
    of dates down the page under the pointer that opened it. What differs is
    register, and only register is written twice below.
  */
  .one-off,
  .classes {
    position: relative;
    margin-top: 0.25rem;
  }

  .one-off-trigger,
  .classes-trigger {
    display: block;
    width: 100%;
    padding: 0.2rem 0.3rem;
    border: 0;
    border-left-width: 2px;
    border-left-style: solid;
    font: inherit;
    line-height: 1.25;
    text-align: left;
    cursor: pointer;
  }

  .one-off-panel,
  .classes-panel {
    display: none;
    position: absolute;
    z-index: 2;
    top: calc(100% + 0.25rem);
    left: 0;
    width: max-content;
    padding: 0.7rem 0.85rem;
    background: var(--color-cream);
    border: 1px solid var(--color-rule);
    box-shadow: 0 6px 18px color-mix(in srgb, var(--color-navy) 18%, transparent);
    font-size: 0.85rem;
  }

  .one-off[data-open] .one-off-panel,
  .classes[data-open] .classes-panel {
    display: block;
  }

  /*
    A one-off is news, so it takes the gold and the emphasis that goes with it.

    What it prints is the title and the time together (#234): "Fall Open House"
    alone does not say whether a family is coming at ten in the morning or at
    half past six, which is most of what they came to the month for. The time
    sits on its own line rather than after a separator, because a grid cell is
    four or five characters wide and a title that wraps mid-word to make room
    for "6.30pm" is worse than either fact on its own.
  */
  .one-off-trigger {
    border-left-color: var(--color-gold-orn);
    background: color-mix(in srgb, var(--color-gold-orn) 18%, transparent);
    font-size: 0.8rem;
    color: var(--color-navy);
  }

  .one-off-name {
    display: block;
  }

  /*
    Quieter than the title, in the same register the closure mark uses: the time
    is what the title is qualified by, and a cell of two equal lines reads as two
    one-offs. A one-off with no start time has no line here at all — an absent
    time is a real state, and a dash standing in for it would invent a gap.

    **Quieter by size and small caps, and not by colour.** The muted ink measures
    3.9:1 on the trigger's gold and axe fails it, which is the same trap the date
    number two rules up already names: grey on grey on gold is where the contrast
    goes. Inheriting the trigger's navy is 8.7:1 and the hierarchy is unchanged,
    because it was never the colour doing the work.
  */
  .one-off-time {
    display: block;
    font-size: 0.75rem;
    line-height: 1.2;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.04em;
  }

  .one-off-trigger:hover,
  .one-off[data-open] .one-off-trigger {
    background: color-mix(in srgb, var(--color-gold-orn) 32%, transparent);
    color: var(--color-gold-ink);
  }

  .one-off-panel {
    max-width: 15rem;
    line-height: 1.5;
    color: var(--color-ink-2);
  }

  .one-off-panel .when {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.06em;
  }

  .one-off-panel .where {
    margin-top: 0.25rem;
  }

  /*
    A class is routine, so it is a rule and a count in the quiet ink.

    Deliberately not the one-off's gold: if the two looked alike, the thing that
    happens once a year would compete with the thing that happens every week.
  */
  .classes-trigger {
    padding-top: 0.15rem;
    padding-bottom: 0.15rem;
    border-left-color: color-mix(in srgb, var(--color-navy) 30%, transparent);
    background: none;
    font-size: 0.75rem;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.04em;
    color: var(--color-ink-2);
  }

  .classes-trigger:hover,
  .classes[data-open] .classes-trigger {
    background: color-mix(in srgb, var(--color-navy) 8%, transparent);
    color: var(--color-navy);
  }

  .classes-panel {
    max-width: 17rem;
    line-height: 1.4;
  }

  .slot + .slot {
    margin-top: 0.6rem;
  }

  /* The time heads its group, because the group is the answer: the classes
     under one time are alternatives to each other, not a sequence. */
  .slot-time {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.06em;
    color: var(--color-ink-2);
  }

  .slot-classes {
    list-style: none;
    margin: 0.15rem 0 0;
    padding: 0;
  }

  .slot-classes li + li {
    margin-top: 0.15rem;
  }

  /*
    On a phone a month is a dated list, not a grid (#186).

    Seven columns in 390px is four characters a cell, and a grid that scrolls
    sideways hides half the year behind a gesture. So the same cells stay in the
    same order and the ones with nothing to say step out: what is left is the
    dates something is true of, each printing its own date in full.
  */
  @media (max-width: 620px) {
    .months {
