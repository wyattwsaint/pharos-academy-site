---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSchoolDetails } from '../../lib/admin/school-details.js';
import { CALENDAR_PATH, CURRENT_FAMILIES_LINKS } from '../../lib/current-families/section.js';
import { getDb } from '../../lib/db/client.js';
import { INQUIRY_HREF } from '../../lib/home/sections.js';

/**
 * Current Families — the section index (#30).
 *
 * It exists because the nav item does, and a nav item that goes straight to one
 * of its children is a nav item lying about how many children it has. Three
 * things are under it: the calendar, the news and the policies.
 *
 * The calendar section stays a section of its own rather than becoming one more
 * card, because two of the old site's addresses land on it — and because what
 * it says about a subscribed calendar refreshing on the phone's own schedule is
 * the thing families most need told and least expect (#23).
 *
 * Nothing on this page or under it is gated. See `current-families/section.ts`
 * for why that is a decision.
 */
const description =
  'For families already at Pharos Academy — news, policies and the handbook. Nothing here requires a login.';

/*
 * The signpost itself reads nothing; the footer under it reads the school
 * details row. Read here rather than in the layout because a layout's read
 * fails after the 200 has been sent (`BaseLayout.astro`), and this page must
 * answer 500 with the database down like every other one.
 */
const details = await getSchoolDetails(await getDb());
---

<BaseLayout details={details} title="Current Families" description={description}>
  <section class="band band-quiet" data-section="current-families-header">
    <div class="wide">
      <p class="label">Current Families</p>
      <h1 class="mt-4">Families Already Here</h1>
      <p class="sub mt-5">
        The things you need during the year, in one place. None of it is behind a login — if you
        are still deciding whether to apply, you are welcome to read every word of it.
      </p>
    </div>
  </section>

  <section class="band" id="what-is-here" data-section="current-families-links">
    <div class="wide">
      <ul class="cards">
        {
          CURRENT_FAMILIES_LINKS.map((link) => (
            <li class="card">
              <h2><a href={link.path}>{link.label}</a></h2>
              <p class="mt-3">{link.blurb}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band band-quiet" id="calendar" data-section="current-families-calendar">
    <div class="wide">
      <h2>The Calendar</h2>
      <p class="mt-5">
        Every class date for the year is on <a href={CALENDAR_PATH}>the calendar</a>, one column
        per day track — the four do not line up, because each skips only its own holidays, and the
        page shows them as they really are. There is one file to download or subscribe to, and the
        sheet prints.
      </p>
      <p class="mt-4 text-ink-2">
        A subscribed calendar refreshes on your phone’s own schedule, so if something changes at
        short notice the school will still text you. Anything else, <a href={INQUIRY_HREF}
          >ask us</a
        >.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /*
    Two cards side by side above 44rem, stacked below. A list rather than a
    stack of divs because it is a list, and the count is read out.
  */
  .cards {
    display: grid;
    gap: 1.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 56rem;
  }

  @media (min-width: 44rem) {
    .cards {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  .card {
    border-left: 2px solid var(--color-gold-orn);
    padding-left: 1.25rem;
  }

  .card p {
    max-width: 30rem;
  }
</style>
