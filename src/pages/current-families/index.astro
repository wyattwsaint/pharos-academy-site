---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSchoolDetails } from '../../lib/admin/school-details.js';
import { CALENDAR_PATH, CURRENT_FAMILIES_LINKS } from '../../lib/current-families/section.js';
import { getDb } from '../../lib/db/client.js';
import { INQUIRY_HREF } from '../../lib/home/sections.js';

/**
 * Current Families — the section index (#30).
 *
 * It exists because the nav item does, and a nav item that goes straight to one
 * of its children is a nav item lying about how many children it has. Three
 * things are under it: the calendar, the news and the policies.
 *
 * The calendar section stays a section of its own rather than becoming one more
 * card, because two of the old site's addresses land on it — and because what
 * it says about a subscribed calendar refreshing on the phone's own schedule is
 * the thing families most need told and least expect (#23).
 *
 * Nothing on this page or under it is gated. See `current-families/section.ts`
 * for why that is a decision.
 */
const description =
  'For families already at Pharos Academy — news, policies and the handbook. Nothing here requires a login.';

/*
 * The signpost itself reads nothing; the footer under it reads the school
 * details row. Read here rather than in the layout because a layout's read
 * fails after the 200 has been sent (`BaseLayout.astro`), and this page must
 * answer 500 with the database down like every other one.
 */
const details = await getSchoolDetails(await getDb());
---

<BaseLayout details={details} title="Current Families" description={description}>
  <section class="band band-quiet" data-section="current-families-header">
    <div class="wide">
      {/*
        Heading and picture, and nothing else. The paragraph that used to sit
        here said the section is not gated — true, and still said in the meta
        description, but it was a reassurance aimed at somebody who has not
        applied yet, on the one page in the site named for the people who have.
        The cards below say what is here better than a sentence about what is
        not in the way.

        That leaves a band carrying its heading alone, which is the case
        `.accent-wide` was extracted for (#142): the plate takes the room the
        missing type would have. The painting is the same hand as the other
        plates, and decorative — the heading beside it already names the
        section, so `alt` is empty.

        It is the one plate that is not 3:2. `beacon.css` warns the edge ramp
        was drawn for that ratio, but the warning is about the radial mask it
        rejected, not the ratio: a linear ramp on four edges dissolves a 16:9
        plate as cleanly. Cropping to 3:2 would have taken the jug and the globe
        off the ends, which are what hold the composition together.
      */}
      <div class="accent accent-wide">
        <div>
          <p class="label">Current Families</p>
          <h1 class="mt-4">Families Already Here</h1>
        </div>
        <figure class="plate">
          <img src="/imagery/reading-table.webp" alt="" width="1400" height="788" loading="eager" />
        </figure>
      </div>
    </div>
  </section>

  <section class="band" id="what-is-here" data-section="current-families-links">
    <div class="wide">
      <ul class="cards">
        {
          CURRENT_FAMILIES_LINKS.map((link) => (
            <li class="card">
              <h2><a href={link.path}>{link.label}</a></h2>
              <p class="mt-3">{link.blurb}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band band-quiet" id="calendar" data-section="current-families-calendar">
    <div class="wide">
      <h2>The Calendar</h2>
      <p class="mt-5">
        The year is on <a href={CALENDAR_PATH}>the calendar</a>, month by month — open houses,
        concerts and picture days on their dates, the days the school is closed, and what meets
        on each class day. There is one file to download or subscribe to, and the page prints as
        the year’s dated list. For every date a particular class meets, see that class’s own page.
      </p>
      <p class="mt-4 text-ink-2">
        A subscribed calendar refreshes on your phone’s own schedule, so if something changes at
        short notice the school will say so on WhatsApp. Anything else, <a href={INQUIRY_HREF}
          >ask us</a
        >.
      </p>
    </div>
  </section>

  {/*
    A section of its own, not two more sentences under the calendar (#298).
    Which channel the school announces a closing on is not a calendar fact, and
    the line it replaces — “the school will still text you” — drifted precisely
    because it was living inside a section about something else.

    No link and no group address. The invitation is the school’s to send, and a
    join link on a public page is joinable by anybody who finds the page.
  */}
  <section class="band" id="reaching-you" data-section="current-families-reaching-you">
    <div class="wide">
      <h2>How the School Reaches You</h2>
      <p class="mt-5">
        Closings, cancellations and anything else at short notice go out on WhatsApp, and families
        here are asked to be on it. It is free, it is easy to use, and it is what schools like
        ours have found works — but it is also the one place the school announces a closing, so a
        family that is not on it is a family the school cannot reach on the morning it matters.
      </p>
      <p class="mt-4">
        There is nothing to join from this page. The school sends your family the invitation once
        you are enrolled, and announcements come from the school rather than from anybody’s
        personal number.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /*
    Two cards side by side above 44rem, stacked below. A list rather than a
    stack of divs because it is a list, and the count is read out.
  */
  .cards {
    display: grid;
    gap: 1.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 56rem;
  }

  @media (min-width: 44rem) {
    .cards {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  .card {
    border-left: 2px solid var(--color-gold-orn);
    padding-left: 1.25rem;
  }

  .card p {
    max-width: 30rem;
  }
</style>
