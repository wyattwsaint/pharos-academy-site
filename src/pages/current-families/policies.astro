---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb } from '../../lib/db/client.js';
import { INQUIRY_HREF } from '../../lib/home/sections.js';
import { publishedPolicies } from '../../lib/policies/policy.js';
import { listPolicies } from '../../lib/policies/store.js';
import { policyPath, updatedOnAttribute, updatedOnLabel } from '../../lib/policies/views.js';

/**
 * The school's policies, as documents a parent can tell apart (#28).
 *
 * The live site lists five bare titles and nothing else, so working out whether
 * the Child Protection Policy or the Child Protection Background Check Policy
 * is the one you were asked for means opening both. Here each carries one
 * sentence saying what it is and the date it was last updated — which is #18's
 * story 40, and the only reason this page is more than a list of links.
 *
 * The date is not typed anywhere. It is when the current file was uploaded, so
 * it cannot disagree with the document, which is what the hand-maintained
 * "Updated 7-23-2026" on each PDF's cover page eventually will.
 *
 * These four stay **downloads** rather than becoming web pages, deliberately.
 * The school authors them in Word and re-exports them; converting them would
 * make this build the bottleneck for every future edit, which is the opposite
 * of the point of the admin.
 *
 * A policy with no file yet is absent rather than listed — see
 * `publishedPolicies`. The admin says so on its own screen.
 */
const db = await getDb();
const policies = publishedPolicies(await listPolicies(db));

const description =
  'Pharos Academy’s policies — the handbook, the code of conduct and the child protection policies, each with what it covers and when it was last updated.';
---

<BaseLayout title="Policies" description={description}>
  <section class="band band-quiet" data-section="policies-header">
    <div class="wide">
      <p class="label">Current families</p>
      <h1 class="mt-4">Policies</h1>
      <p class="sub mt-5">
        Everything the school asks families to read, with a line on what each one covers and the
        date it was last updated. They are PDFs, so you can keep or print the copy you were given.
      </p>
    </div>
  </section>

  <section class="band" id="documents" data-section="policies-list">
    <div class="wide">
      {
        policies.length === 0 ? (
          <p>The policy documents are being prepared and will appear here shortly.</p>
        ) : (
          <ul class="policy-list">
            {policies.map((policy) => (
              <li id={policy.slug}>
                <h2 class="mt-0">
                  <a href={policyPath(policy.slug)}>{policy.title}</a>
                </h2>
                {policy.description && <p class="mt-3">{policy.description}</p>}
                <p class="label mt-3">
                  PDF
                  {' · '}
                  <span>
                    Updated{' '}
                    <time datetime={updatedOnAttribute(policy.updatedAt)}>
                      {updatedOnLabel(policy.updatedAt)}
                    </time>
                  </span>
                  {policy.signed && ' · Parents sign this'}
                </p>
              </li>
            ))}
          </ul>
        )
      }

      {
        /*
          Said once, at the foot of the list, rather than repeated under each
          signed row. What a family needs to know is that signing happens at
          enrolment on paper, not that four separate documents each have a
          signature page.
        */
      }
      <p class="mt-9 text-ink-2">
        The documents marked <em>Parents sign this</em> are signed at enrolment, in person. Not sure
        which one you need? <a href={INQUIRY_HREF}>Ask us</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .policy-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .policy-list > li {
    border-left: 2px solid var(--color-gold-orn);
    padding-left: 1.25rem;
  }
</style>
