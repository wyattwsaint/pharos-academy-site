---
import Ornament from '../components/Ornament.astro';
import Announcements from '../components/home/Announcements.astro';
import CostsSection from '../components/home/CostsSection.astro';
import FaithSection from '../components/home/FaithSection.astro';
import HomeHero from '../components/home/HomeHero.astro';
import InquirySection from '../components/home/InquirySection.astro';
import TeachersSection from '../components/home/TeachersSection.astro';
import WeekSection from '../components/home/WeekSection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { listCourses } from '../lib/courses/store.js';
import { getDb } from '../lib/db/client.js';
import { getMoneySettings } from '../lib/money/store.js';

/**
 * The homepage, in "Beacon, warmed" — variant E, approved by George and Jill
 * on #13.
 *
 * The section order is #9's and is not open to revision here. It lives in
 * `src/lib/home/sections.ts` as a list, is stamped onto each section as
 * `data-section`, and the browser suite asserts the rendered sequence equals
 * that list — so a section moved in this file alone fails rather than quietly
 * re-ordering what two people signed off on.
 *
 * #9's plain-fact headline is deliberately unchanged. The image does the
 * emotional work, which is what frees the words to be useful.
 *
 * The ornament separates *consecutive light bands* and nothing else, which is
 * not every gap on the page. `FaithSection` is the navy band and separates
 * itself — a gold hairline pressed against it reads as an underline on the
 * band rather than a rule between two sections. And `Announcements` hides when
 * empty, which is its normal state, so an ornament below it would leave a rule
 * hanging directly under the hero with nothing above it.
 */
const description =
  'Christian classical classes in Enola, Pennsylvania, for ages 4 to 18 — mornings on Monday, Wednesday and Thursday.';

/*
 * The catalogue and the money settings, read once here and handed down.
 *
 * Read on the page rather than inside each section for the same reason
 * `/classes` does it (#29 AC 1): no component holds a copy of the school's
 * rates, and the two sections that quote money quote the same figures as each
 * other by construction.
 */
const db = await getDb();
const courses = await listCourses(db);
const settings = await getMoneySettings(db);
---

<BaseLayout title="Home" description={description} overHero>
  <HomeHero />
  <Announcements />
  <WeekSection courses={courses} rates={settings.rates} />
  <Ornament />
  <TeachersSection />
  <Ornament />
  <CostsSection courses={courses} settings={settings} />
  <FaithSection />
  <InquirySection />
</BaseLayout>

<script>
  import '../components/disclosure-group.js';
  import { heroFx, stickyHeader } from '../components/hero-fx.js';

  heroFx();
  stickyHeader();
</script>
