---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSchoolDetails } from '../lib/admin/school-details.js';
import { getDb } from '../lib/db/client.js';
import { listPeople } from '../lib/people/store.js';
import { TEACHER_CONTRACT, leadershipContact } from '../lib/teach/teach.js';

/**
 * Teaching here — off the parent path, deliberately (#30, #9's tree).
 *
 * At the root rather than under About or Current Families, and reachable from
 * the footer rather than the nav, because the audience is neither a prospective
 * family nor a current one. It is somebody who might teach a class, and putting
 * that in a parent's four-item nav costs every parent a decision to make room
 * for a handful of people a year.
 *
 * **The contract is a download, not a row in the policy set**, and #28's
 * comment settles why: every policy in that set is on the parent path by
 * construction, and giving it an `audience` column would put a fourth field on
 * a create form that ticket deliberately keeps at three. Adding a document to
 * the editable set is a decision (CONTEXT.md), not something this page should
 * take on its own. So the file is served from `public/` and this page links it.
 *
 * Nothing here paraphrases the contract. It is a legal document a contractor
 * signs; the page says what it is and who to talk to, and the terms are in the
 * PDF where they can be read whole.
 */
const db = await getDb();
const [details, people] = await Promise.all([getSchoolDetails(db), listPeople(db)]);
const contact = leadershipContact(people);

const description =
  'Teaching at Pharos Academy — what the non-employee teacher contract covers, the Pennsylvania clearances required, and who to talk to.';
---

<BaseLayout details={details} title="Teach at Pharos" description={description}>
  <section class="band band-quiet" data-section="teach-header">
    <div class="wide">
      <p class="label">For prospective teachers</p>
      <h1 class="mt-4">Teaching at Pharos Academy</h1>
      <p class="sub mt-5">
        Instructors here are independent contractors, not employees — they keep their own
        professional judgement over how a class is taught, and they are free to teach elsewhere.
      </p>
    </div>
  </section>

  <section class="band" id="contract" data-section="teach-contract">
    <div class="wide">
      <h2>The Contract</h2>
      <p class="mt-5">
        The whole of what is agreed is in one document. It is short, and it is worth reading before
        any conversation rather than after one.
      </p>
      <p class="mt-6">
        <a class="btn solid" href={TEACHER_CONTRACT.path} download={TEACHER_CONTRACT.filename}>
          {TEACHER_CONTRACT.label}
        </a>
      </p>
      <p class="mt-5 text-ink-2">
        Pennsylvania's clearances are part of it and are not optional: Act 34, 114 and 151
        background checks on file, an Act 168 employment history review, and Mandated Reporter
        training under Act 31/126, all before the first class.
      </p>
    </div>
  </section>

  <section class="band band-quiet" id="talk" data-section="teach-contact">
    <div class="wide">
      <h2>Talking to Us</h2>
      <p class="mt-5">
        {/* The spaces are inside the expression: Astro drops the newline either side of one. */}
        Interested in teaching a class? Send a note to
        {contact ? ` our ${contact.role}, ${contact.name}, at ` : ' '}
        <a href={`mailto:${details.email}`}>{details.email}</a> — tell us the subject and the ages
        you would want, and we will go from there.
      </p>
    </div>
  </section>
</BaseLayout>
